<header-drawer data-breakpoint="tablet">
	<details class="menu-drawer-container">
		<summary
			class="header__icon header__icon--menu header__icon--summary link link--text focus-inset"
			aria-label="{{ 'sections.header.menu' | t }}"
		>
			<span class="header__icon-wrapper">
				{% render 'icon-hamburger' %}
			</span>
		</summary>
		<div id="MenuDrawer-Overlay" class="menu-drawer__overlay"></div>
		<div
			id="menu-drawer"
			class="menu-drawer motion-reduce color-background-1"
			tabind
			ex="-1"
		>
			<div class="menu-drawer__inner-container">
				<div class="menu-drawer__top container">
					<span class="header__modal-close-button">
						<span class="header__icon-wrapper modal-close-button">
							{% render 'icon-close' %}
						</span>
					</span>
					{% render 'header-logo', tag: 'h2' %}
					<div class="header-icons">
						<div class="header__item">
							<a href="/cart" class=" header__icon link link--text focus-inset"  role="button">
								{% render 'icon-heart' %}
								<span class="small-font">
									{{ 'general.wishlist' | t }}
								</span>
							</a>
						</div>
						<div class="header__item">
							<a href="/cart" class=" header__icon link link--text focus-inset" role="button">
								{% render 'icon-paper' %}
								<span class="small-font">
									{{ 'general.get_a_quote' | t }}
								</span>
							</a>
						</div>
						{% render 'header-cart' %}
					</div> 
				</div>
				<div class="menu-drawer__main">
					<div class="menu-drawer__navigation-container">
						<nav class="menu-drawer__navigation container">
							<ul class="menu-drawer__menu list-menu" role="list">
								{%- for link in section.settings.menu.links -%}
									{% liquid
										assign mega_menu_tabs = false
										assign mega_menu = false
										assign mega_menu_logo = false
									%}
									{% for block in section.blocks %}
										{% liquid
											assign mega_menu_trigger = block.settings.mega_menu_trigger | handle | strip
											assign mega_menu_tabs_trigger = block.settings.mega_menu_tabs_trigger | handle | strip
											assign menu_logo_trigger = block.settings.menu_logo_trigger | handle | strip
											if link.handle == mega_menu_trigger
												assign mega_menu = true
												assign mega_menu_tabs = false
												assign mega_menu_logo = false
												assign index = forloop.index
											elsif link.handle == mega_menu_tabs_trigger
												assign mega_menu_tabs = true
												assign mega_menu = false
												assign mega_menu_logo = false
												assign index_tabs = forloop.index
											elsif link.handle == menu_logo_trigger
												assign mega_menu_logo = true
												assign mega_menu = false
												assign mega_menu_tabs = false
												assign index_logo = forloop.index
											endif
										%}
									{% endfor %}
									{%- assign menu_icon_block = nil -%}
									{%- assign menu_link_index = forloop.index -%}
									{%- for b in section.blocks -%}
										{%- if b.type == 'menu_icon' and b.settings.position == menu_link_index -%}
											{%- assign menu_icon_block = b -%}
											{%- break -%}
										{%- endif -%}
									{%- endfor -%}
									<li>
										{%- if section.blocks.size > 0
											and mega_menu
											or mega_menu_tabs
											or mega_menu_logo
										-%}
											<details>
												<summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
													{% if menu_icon_block %}
														<span class="header-menu__icon">
															{% if menu_icon_block.settings.icon_svg != blank %}
																{{ menu_icon_block.settings.icon_svg }}
															{% elsif menu_icon_block.settings.icon_image != blank %}
																{% assign icon_alt = menu_icon_block.settings.icon_alt | default: link.title %}
																{{ menu_icon_block.settings.icon_image | image_url: width: 18, height: 18 | image_tag: width: 18, height: 18, alt: icon_alt, class: 'header-menu__icon-img' }}
															{% endif %}
														</span>
													{% endif %}
													<span class="menu-drawer__menu-link">{{ link.title | escape }}</span>
													{% render 'icon-caret' %}
												</summary>
												<div
													id="link-{{ link.title | escape }}"
													class="menu-drawer__submenu has-submenu motion-reduce"
													tabindex="-1"
												>
													<div class="menu-drawer__inner-submenu">
														<button
															class="menu-drawer__close-button menu-drawer__back-button link link--text focus-inset"
															aria-expanded="true"
														>
															{% render 'icon-caret' %}
															{% if menu_icon_block %}
																<span class="header-menu__icon">
																	{% if menu_icon_block.settings.icon_svg != blank %}
																		{{ menu_icon_block.settings.icon_svg }}
																	{% elsif menu_icon_block.settings.icon_image != blank %}
																		{% assign icon_alt = menu_icon_block.settings.icon_alt | default: link.title %}
																		{{ menu_icon_block.settings.icon_image | image_url: width: 18, height: 18 | image_tag: width: 18, height: 18, alt: icon_alt, class: 'header-menu__icon-img' }}
																	{% endif %}
																</span>
															{% endif %}
															<span class="menu-drawer__back-title">{{ link.title | escape }}</span>
														</button>
														<div class="menu-drawer__submenu-content">
															{% for block in section.blocks %}
																{% if mega_menu
																	and block.type == 'mega_menu'
																	and forloop.index == index
																%}
																	{% render 'mega-menu-columns-mobile', link: link, blocks: section.blocks %}
																{% elsif mega_menu_tabs
																	and block.type == 'mega_menu_tabs'
																	and forloop.index == index_tabs
																%}
																	{% render 'mega-menu-tabs-mobile', link: link, blocks: section.blocks %}
																{% elsif mega_menu_logo
																	and block.type == 'menu_logo'
																	and forloop.index == index_logo
																%}
																	{% render 'mega-menu-logo-mobile', link: link, blocks: section.blocks %}
																{% endif %}
															{% endfor %}
														</div>
													</div>
												</div>
											</details>
										{%- elsif link.links != blank -%}
											<details>
												<summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.child_active %} menu-drawer__menu-item--active{% endif %}">
													{% if menu_icon_block %}
														<span class="header-menu__icon">
															{% if menu_icon_block.settings.icon_svg != blank %}
																{{ menu_icon_block.settings.icon_svg }}
															{% elsif menu_icon_block.settings.icon_image != blank %}
																{% assign icon_alt = menu_icon_block.settings.icon_alt | default: link.title %}
																{{ menu_icon_block.settings.icon_image | image_url: width: 18, height: 18 | image_tag: width: 18, height: 18, alt: icon_alt, class: 'header-menu__icon-img' }}
															{% endif %}
														</span>
													{% endif %}
													<span class="menu-drawer__menu-link">{{ link.title | escape }}</span>
													{% render 'icon-caret' %}
												</summary>
												<div
													id="link-{{ link.title | escape }}"
												class="menu-drawer__submenu has-submenu motion-reduce"
													tabindex="-1"
												>
													<div class="menu-drawer__inner-submenu">
														<button
														class="menu-drawer__close-button menu-drawer__back-button link link--text focus-inset"
															aria-expanded="true"
														>
													{% render 'icon-caret' %}
													{% if menu_icon_block %}
														<span class="header-menu__icon">
															{% if menu_icon_block.settings.icon_svg != blank %}
																{{ menu_icon_block.settings.icon_svg }}
															{% elsif menu_icon_block.settings.icon_image != blank %}
																{% assign icon_alt = menu_icon_block.settings.icon_alt | default: link.title %}
																{{ menu_icon_block.settings.icon_image | image_url: width: 18, height: 18 | image_tag: width: 18, height: 18, alt: icon_alt, class: 'header-menu__icon-img' }}
														{% endif %}
													</span>
												{% endif %}
													<span class="menu-drawer__back-title">{{ link.title | escape }}</span>
														</button>
														<ul
															class="menu-drawer__menu list-menu"
															role="list"
															tabindex="-1"
														>
															{%- for childlink in link.links -%}
																<li>
																	{%- if childlink.links == blank -%}
																		<a
																			href="{{ childlink.url }}"
																			class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
																			{% if childlink.current %}
																				aria-current="page"
																			{% endif %}
																		>
																			{{ childlink.title | escape }}
																		</a>
																	{%- else -%}
																		<details class="submenu-accordion">
																			<summary class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
																				<span class="menu-drawer__menu-link link link--text list-menu__item focus-inset no-padding">
																					{{ childlink.title | escape }}
																				</span>
																				{% render 'icon-caret' %}
																			</summary>
																			<div class="submenu-accordion__content">
																				<ul class="menu-drawer__menu list-menu" role="list">
																					{%- for grandchildlink in childlink.links -%}
																						<li>
																							<a
																								href="{{ grandchildlink.url }}"
																								class="menu-drawer__menu-item link link--text list-menu__item focus-inset{% if grandchildlink.current %} menu-drawer__menu-item--active{% endif %}"
																								{% if grandchildlink.current %}
																									aria-current="page"
																								{% endif %}
																							>
																								{{ grandchildlink.title | escape }}
																							</a>
																						</li>
																					{%- endfor -%}
																				</ul>
																			</div>
																		</details>
																	{%- endif -%}
																</li>
															{%- endfor -%}
														</ul>
													</div>
												</div>
												</details>
										{%- else -%}
											<a
												href="{{ link.url }}"
												class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}{% if link.title == section.settings.main_menu_sale_trigger %} menu-drawer__menu-link--sale{% endif %}"
												{% if link.current %}
													aria-current="page"
												{% endif %}
											>
												{%- if link.title
														== section.settings.main_menu_sale_trigger
													and section.settings.main_menu_sale_icon
												-%}
													{% render 'icon-menu-sale' %}
												{%- endif -%}
												{% if menu_icon_block %}
													<span class="header-menu__icon">
														{% if menu_icon_block.settings.icon_svg != blank %}
															{{ menu_icon_block.settings.icon_svg }}
														{% elsif menu_icon_block.settings.icon_image != blank %}
															{% assign icon_alt = menu_icon_block.settings.icon_alt | default: link.title %}
															{{ menu_icon_block.settings.icon_image | image_url: width: 18, height: 18 | image_tag: width: 18, height: 18, alt: icon_alt, class: 'header-menu__icon-img' }}
													{% endif %}
												</span>
											{% endif %}
											<span title="{{ link.title | escape }}" class="{% if link.title == section.settings.main_menu_sale_trigger %} menu-drawer__menu-link-label--sale-color{% endif %}">
													{{ link.title | escape }}
												</span>
											</a>
										{%- endif -%}
									</li>
								{%- endfor -%}
							</ul>
							{% if section.settings.enable_social %}
								<ul class="list list-social list-unstyled" role="list">
									{%- if settings.social_twitter_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_twitter_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-twitter' -%}
												<span class="visually-hidden">
													{{- 'general.social.links.twitter' | t -}}
												</span>
											</a>
										</li>
									{%- endif -%}
									{%- if settings.social_facebook_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_facebook_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-facebook' -%}
												<span class="visually-hidden">
													{{- 'general.social.links.facebook' | t -}}
												</span>
											</a>
										</li>
									{%- endif -%}
									{%- if settings.social_pinterest_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_pinterest_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-pinterest' -%}
												<span class="visually-hidden">
													{{- 'general.social.links.pinterest' | t -}}
												</span>
											</a>
										</li>
									{%- endif -%}
									{%- if settings.social_instagram_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_instagram_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-instagram' -%}
												<span class="visually-hidden">
													{{- 'general.social.links.instagram' | t -}}
												</span>
											</a>
										</li>
									{%- endif -%}
									{%- if settings.social_tiktok_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_tiktok_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-tiktok' -%}
												<span class="visually-hidden">
													{{ 'general.social.links.tiktok' | t }}
												</span>
											</a>
										</li>
									{%- endif -%}
									{%- if settings.social_tumblr_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_tumblr_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-tumblr' -%}
												<span class="visually-hidden">
													{{- 'general.social.links.tumblr' | t -}}
												</span>
											</a>
										</li>
									{%- endif -%}
									{%- if settings.social_snapchat_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_snapchat_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-snapchat' -%}
												<span class="visually-hidden">
													{{- 'general.social.links.snapchat' | t -}}
												</span>
											</a>
										</li>
									{%- endif -%}
									{%- if settings.social_youtube_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_youtube_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-youtube' -%}
												<span class="visually-hidden">
													{{- 'general.social.links.youtube' | t -}}
												</span>
											</a>
										</li>
									{%- endif -%}
									{%- if settings.social_vimeo_link != blank -%}
										<li class="list-social__item">
											<a
												href="{{ settings.social_vimeo_link }}"
												{% if settings.new_tab %}
													target="_blank"
												{% endif %}
												class="link link--text list-social__link"
												aria-describedby="a11y-external-message"
											>
												{%- render 'icon-vimeo' -%}
												<span class="visually-hidden">
													{{- 'general.social.links.vimeo' | t -}}
												</span>
											</a>
										</li>
									{%- endif -%}
								</ul>
							{% endif %}
						</nav>

						<div class="menu-drawer__utility-links">
							{%- if shop.customer_accounts_enabled -%}
								{%- if customer -%}
									<div class="menu-drawer__utility-account">
										<div class="menu-drawer__utility-account-header">
											<span class="menu-drawer__utility-name">
												{{- customer.name -}}
											</span>
											<a
												class="menu-drawer__utility-logout button button--simple button--arrow focus-inset"
												href="{{ routes.account_logout_url }}"
											>
												<span class="button-label">
													{{- 'customer.log_out' | t -}}
												</span>
												{% render 'icon-button-arrow' %}
											</a>
										</div>
										<ul class="menu-drawer__utility-account-body">
											{% comment %}<li class="menu-drawer__utility-account-cart">
												<a href="{{ routes.cart_url }}">
													{{- 'customer.account.shopping_cart' | t -}}
												</a>
												<div class="cart-count-bubble">
													{%- if cart.item_count < 100 -%}
														<span aria-hidden="true">
															{{- cart.item_count -}}
														</span>
													{%- endif -%}
													<span class="visually-hidden">
														{{-
															'sections.header.cart_count'
															| t: count: cart.item_count
														-}}
													</span>
												</div>
											</li>{% endcomment %}
											<li class="menu-drawer__utility-account-link">
												<a href="{{ routes.account_url }}" class="focus-inset">
													 {{ 'customer.account_fallback' | t }}
												</a>
											</li>
											<li class="menu-drawer__utility-account-address">
												<a href="{{ routes.account_addresses_url }}" class="focus-inset">
													{{- 'customer.addresses.book' | t -}}
												</a>
											</li>
										</ul>
									</div>
								{%- else -%}
									<a
										href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
										class="button button--primary menu-drawer__account link focus-inset"
									>
										
										<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
											<mask id="mask0_2189_18680" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="18" height="18">
											<rect width="18" height="18" fill="#D9D9D9"/>
											</mask>
											<g mask="url(#mask0_2189_18680)">
											<path d="M9 8.76917C8.27812 8.76917 7.66019 8.51217 7.14619 7.99817C6.63206 7.48404 6.375 6.86604 6.375 6.14417C6.375 5.42229 6.63206 4.80435 7.14619 4.29035C7.66019 3.77623 8.27812 3.51917 9 3.51917C9.72188 3.51917 10.3398 3.77623 10.8538 4.29035C11.3679 4.80435 11.625 5.42229 11.625 6.14417C11.625 6.86604 11.3679 7.48404 10.8538 7.99817C10.3398 8.51217 9.72188 8.76917 9 8.76917ZM3.375 13.3414V12.8134C3.375 12.4461 3.47475 12.106 3.67425 11.793C3.87375 11.48 4.14037 11.2394 4.47412 11.0711C5.21537 10.7077 5.96319 10.4352 6.71756 10.2534C7.47194 10.0717 8.23275 9.98079 9 9.98079C9.76725 9.98079 10.5281 10.0717 11.2824 10.2534C12.0368 10.4352 12.7846 10.7077 13.5259 11.0711C13.8596 11.2394 14.1263 11.48 14.3258 11.793C14.5252 12.106 14.625 12.4461 14.625 12.8134V13.3414C14.625 13.6576 14.5142 13.9266 14.2926 14.1484C14.0709 14.37 13.8019 14.4808 13.4856 14.4808H4.51444C4.19806 14.4808 3.92906 14.37 3.70744 14.1484C3.48581 13.9266 3.375 13.6576 3.375 13.3414ZM4.5 13.3558H13.5V12.8134C13.5 12.6615 13.456 12.5209 13.368 12.3915C13.28 12.2622 13.1606 12.1567 13.0097 12.075C12.3634 11.7567 11.7046 11.5156 11.0331 11.3516C10.3614 11.1877 9.68375 11.1058 9 11.1058C8.31625 11.1058 7.63856 11.1877 6.96694 11.3516C6.29544 11.5156 5.63656 11.7567 4.99031 12.075C4.83944 12.1567 4.72 12.2622 4.632 12.3915C4.544 12.5209 4.5 12.6615 4.5 12.8134V13.3558ZM9 7.64417C9.4125 7.64417 9.76563 7.49729 10.0594 7.20354C10.3531 6.90979 10.5 6.55666 10.5 6.14417C10.5 5.73167 10.3531 5.37854 10.0594 5.08479C9.76563 4.79104 9.4125 4.64417 9 4.64417C8.5875 4.64417 8.23438 4.79104 7.94063 5.08479C7.64687 5.37854 7.5 5.73167 7.5 6.14417C7.5 6.55666 7.64687 6.90979 7.94063 7.20354C8.23438 7.49729 8.5875 7.64417 9 7.64417Z" fill="white"/>
											</g>
										</svg>

										{%- liquid
											if customer
												echo 'customer.account_fallback' | t
											else
												echo 'customer.log_in' | t
											endif
										-%}
									</a>
									<div class="menu-drawer__account-register">
										<span class="body-normal">
											{{- 'customer.activate_account.no_account_yet' | t -}}
										</span>
										<a
											class="button button--simple button--arrow focus-inset"
											href="{{ routes.account_register_url }}"
										>
											<span class="button-label">
												{{- 'customer.login_page.create_account' | t -}}
											</span>
										</a>
									</div>
								{%- endif -%}
							{%- endif -%}
						</div>
					</div>
				</div>
				{%- if section.settings.enable_country_selector
					or section.settings.enable_language_selector
					or section.settings.enable_color_scheme
				-%}
					<div class="menu-drawer__bottom">
						{%- if section.settings.enable_country_selector
							or section.settings.enable_language_selector
						-%}
							<div class="menu-drawer__localization-wrapper">
								{%- if section.settings.enable_country_selector
								-%}
									<div class="header__localization menu-drawer__localization">
										<localization-form>
											{%- form 'localization',
												id: 'HeaderCountryForm',
												class: 'localization-form'
											-%}
												<div class="no-js-hidden">
													<div class="disclosure">
														<button
															type="button"
															class="header__localization-button disclosure__button localization-form__select localization-selector link link--text caption-large focus-inset"
															aria-expanded="false"
															aria-controls="HeaderCountryListMobile"
														>
															<span class="currency-country">
																{{- localization.country.currency.iso_code }}
																{{ localization.country.currency.symbol -}}
															</span>
															{% render 'icon-caret' %}
														</button>
														<ul
															id="HeaderCountryListMobile"
															role="list"
															class="disclosure__list list-unstyled color-background-1"
															hidden
														>
															{%- for country in localization.available_countries -%}
																<li class="disclosure__item" tabindex="-1">
																	<a
																		class="link link--text disclosure__link disclosure__link--flag caption-large{% if country.iso_code == localization.country.iso_code %} disclosure__link--active{% endif %} focus-inset"
																		href="#"
																		{% if country.iso_code
																				== localization.country.iso_code
																		%}
																			aria-current="true"
																		{% endif %}
																		data-value="{{ country.iso_code }}"
																		data-flag="{{ country.currency.iso_code }}"
																	>
																		<span>
																			{{ country.name }}
																			<span class="localization-form__currency"
																				>({{ country.currency.iso_code }}
																				{{ country.currency.symbol }})</span
																			>
																		</span>
																	</a>
																</li>
															{%- endfor -%}
														</ul>
													</div>
													<input
														type="hidden"
														name="country_code"
														value="{{ localization.country.iso_code }}"
													>
												</div>
											{%- endform -%}
										</localization-form>
									</div>
								{%- endif -%}
								{%- if section.settings.enable_language_selector
								-%}
									<div class="header__localization menu-drawer__localization header__localization--language">
										<localization-form>
											{%- form 'localization',
												id: 'HeaderLanguageForm',
												class: 'localization-form'
											-%}
												<div class="no-js-hidden">
													<div class="disclosure">
														<button
															type="button"
															class="disclosure__button header__localization-lang-button localization-form__select localization-selector link link--text focus-inset"
															aria-expanded="false"
															aria-controls="HeaderLanguageListMobile"
														>
															<span class="value">
																{{- localization.language.endonym_name }}
															</span>
															{% render 'icon-caret' -%}
														</button>
														<ul
															id="HeaderLanguageListMobile"
															role="list"
															class="disclosure__list list-unstyled color-background-1"
															hidden
														>
															{%- for language in localization.available_languages -%}
																<li class="disclosure__item" tabindex="-1">
																	<a
																		class="link link--text disclosure__link caption-large{% if language.iso_code == localization.language.iso_code %} disclosure__link--active{% endif %} focus-inset"
																		href="#"
																		hreflang="{{ language.iso_code }}"
																		lang="{{ language.iso_code }}"
																		{% if language.iso_code
																				== localization.language.iso_code
																		%}
																			aria-current="true"
																		{% endif %}
																		data-value="{{ language.iso_code }}"
																	>
																		<span>
																			{{ language.endonym_name | capitalize }}
																		</span>
																	</a>
																</li>
															{%- endfor -%}
														</ul>
													</div>
													<input
														type="hidden"
														name="locale_code"
														value="{{ localization.language.iso_code }}"
													>
												</div>
											{%- endform -%}
										</localization-form>
									</div>
								{%- endif -%}
							</div>
						{%- endif -%}
						{% comment %} {% if section.settings.enable_color_scheme %}
							{% render 'color-scheme' %}
						{% endif %} {% endcomment %}
						<form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__inner">
							<div class="search__form-inner">
								<div class="field">
									<div class="field__inner">
										<input
											class="search__input field__input" 
											id="Search-In-Template" 
											type="search" 
											name="q" 
											value="{{ search.terms | escape }}" 
											placeholder="{{ 'general.search.placeholder_drawer' | t }}"
										>
									</div> 
									<label class="visually-hidden" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
									<input name="options[prefix]" type="hidden" value="last">

									<button class="button focus-inset" aria-label="{{ 'general.search.search' | t }}">
										<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
											<mask id="mask0_66_42112" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
											<rect width="24" height="24" fill="#D9D9D9"/>
											</mask>
											<g mask="url(#mask0_66_42112)">
											<path d="M9.51955 15.6153C7.81188 15.6153 6.36571 15.023 5.18105 13.8385C3.99655 12.6538 3.4043 11.2077 3.4043 9.50002C3.4043 7.79235 3.99655 6.34618 5.18105 5.16152C6.36571 3.97702 7.81188 3.38477 9.51955 3.38477C11.2272 3.38477 12.6734 3.97702 13.858 5.16152C15.0425 6.34618 15.6348 7.79235 15.6348 9.50002C15.6348 10.2142 15.515 10.8963 15.2753 11.5463C15.0355 12.1963 14.7155 12.7616 14.3155 13.2423L20.0695 18.9963C20.208 19.1346 20.2789 19.3086 20.282 19.5183C20.2852 19.7279 20.2144 19.9052 20.0695 20.05C19.9247 20.1948 19.749 20.2673 19.5425 20.2673C19.3362 20.2673 19.1606 20.1948 19.0158 20.05L13.2618 14.296C12.7618 14.7088 12.1868 15.0319 11.5368 15.2653C10.8868 15.4986 10.2144 15.6153 9.51955 15.6153ZM9.51955 14.1155C10.808 14.1155 11.8994 13.6683 12.7935 12.774C13.6879 11.8798 14.135 10.7885 14.135 9.50002C14.135 8.21152 13.6879 7.12018 12.7935 6.22601C11.8994 5.33168 10.808 4.88452 9.51955 4.88452C8.23105 4.88452 7.13971 5.33168 6.24555 6.22601C5.35121 7.12018 4.90405 8.21152 4.90405 9.50002C4.90405 10.7885 5.35121 11.8798 6.24555 12.774C7.13971 13.6683 8.23105 14.1155 9.51955 14.1155Z" fill="black"/>
											</g>
										</svg>
									</button>
								</div>
							</div>
						</form>
					</div>
				{% endif %}
			</div>
		</div>
	</details>
</header-drawer>
