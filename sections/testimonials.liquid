{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}
{{ 'component-card-horizontal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonials.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div class="testimonials color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding testimonials--slider">
  {% render 'section-header', section: section %}
  <div class="container">
    <div class="testimonials__content content">
      <div class="testimonials__slider-wrapper">
        <div
          class="
            testimonials__slider swiper
            testimonials__slider--slider
            testimonials__slider--columns-3
          "
          data-columns="{{ 3 }}"
          data-navigation="{{ true }}"
          data-pagination="{{ false }}"
        >
          <div class="testimonials__wrapper swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide">
                <div
                  class="testimonials__slide color-{{ section.settings.slide_color_scheme }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="testimonials__item">
                    <div class="testimonials__item--details">
                      <div class="testimonials__rating">
                        <div class="testimonials__slide-stars">
                          {% assign max_rating = 5 %}
                          {% for i in (1..max_rating) %}
                            {% liquid
                              if i <= block.settings.rating
                                assign active = true
                              else
                                assign active = false
                              endif
                            %}
                            {% render 'icon-rating-star', star_active: active %}
                          {% endfor %}
                          <span class="icon-star__count small-font">
                            {{ block.settings.rating }}/{{ max_rating }}
                          </span>
                        </div>
                      </div>
                      {% if block.settings.slide_text != blank %}
                        <p class="testimonials__text {{ section.settings.slide_text_size }}">
                          {{ block.settings.slide_text | escape }}
                        </p>
                      {% endif %}

                      {% if block.settings.slide_name != blank or block.settings.slide_position != blank %}
                        <div class="testimonials__author">
                          {% if block.settings.slide_name != blank or block.settings.slide_position != blank %}
                            <div class="testimonials__author-info">
                              {% if block.settings.slide_name != blank %}
                                <p
                                  class="testimonials__author-name small-font"
                                >
                                  {{ block.settings.slide_name }}
                                </p>
                              {% endif %}
                              {% if block.settings.slide_name != blank and block.settings.slide_position != blank %}
                                <span class="small-font">/</span>
                              {% endif %}
                              {% if block.settings.slide_position != blank %}
                                <p class="testimonials__author-position small-font">
                                  {{ block.settings.slide_position }}
                                </p>
                              {% endif %}
                            </div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                    <div class="testimonials_card">
                      {% render 'product-card-horizontal',
                        product_card_product: block.settings.product_id,
                        media_ratio: section.settings.image_ratio,
                        media_fit: section.settings.image_fit,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        section_id: section.id
                      %}
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
        <div
          class="testimonials__navigation swiper-navigation no-js-hidden"
        >
          <div class="swiper-button-disabled  swiper-button-prev">
            {% render 'icon-swiper-prev' %}
          </div>
          <div class=" swiper-button-next">
            {%- render 'icon-swiper-next' -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "testimonials-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.testimonials.settings.heading.deafult"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "color_scheme",
      "id": "slide_color_scheme",
      "default": "background-1",
      "label": "t:sections.testimonials.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "slide_text_size",
      "label": "t:sections.testimonials.settings.slide_text_size.label",
      "options": [
        {
          "value": "h6",
          "label": "t:sections.all.heading_size.options__6.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options__5.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        }
      ],
      "default": "h5"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
