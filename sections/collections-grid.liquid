<link
  rel="stylesheet"
  href="{{ 'template-list-collections.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
<noscript>
  {{- 'template-list-collections.css' | asset_url | stylesheet_tag -}}
</noscript>
<script src="{{ 'collections-slider.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}
{% assign section_id = 'shopify-section-' | append: section.id %}

<div
  data-id="{{ section.id }}"
  class="collections__grid section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}"
>
  {% render 'section-header', section: section %}
  {%- liquid
    case section.settings.sort
      when 'products_high', 'products_low'
        assign collections = collections | sort: 'all_products_count'
      when 'date', 'date_reversed'
        assign collections = collections | sort: 'published_at'
    endcase

    if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
      assign collections = collections | reverse
    endif
  -%}
  <div class="container collections__grid__container collections__grid__wrapper">
    <div class="content">
      {% if section.settings.layout == 'slider' %}
        <div class="swiper-navigation coll-swiper-navigation  no-js-hidden {% if section.settings.card_variant == 'horizontal' %}navigation-centered{% endif %}">
          <div class="swiper-button-disabled swiper-button-prev">
            {% render 'icon-swiper-prev' %}
          </div>
          <div class="swiper-button-next">
            {%- render 'icon-swiper-next' -%}
          </div>
        </div>
      {% endif %}

      <div
        class="
          {% if section.settings.layout == 'slider' %}swiper js-slider-collections-slider{% endif %}
          collections-slider__content collections-slider__content--{{ section.settings.layout }}
        "
        {% if section.settings.layout == 'slider' %}
          data-duration="{{ section.settings.speed_slider_1 }}"
          data-column-count="{{ section.settings.collections_to_show }}"
        {% endif %}
      >
        <div
          class="
            {% if section.settings.layout == 'slider' %}swiper-wrapper{% else %}
                 collections-list collections-grid
            collections-grid--{{ section.settings.collections_to_show }}
            collections-grid--{{ section.settings.columns_mobile }}-mobile {% endif %}
          "
        >
          {%- for block in section.blocks -%}
            {% assign collection = block.settings.collection %}
            <div class="{% if section.settings.layout == 'slider' %}swiper-slide {% if section.settings.card_variant == 'horizontal' %}swiper-slide-flexible{% endif %} {% endif %}">
              {% render 'collection-card', collection: collection, block: block, section: section %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  (function () {
    const section = `#{{ section_id }}`;
    const sectionSelector = `${section} .swiper`;
    const buttonSelector = `${section} .swiper-navigation`;
    const imageSelector = `.collections__card--image img`;
    const svgSelector = `.collections__card--image svg`;

    function updateButtonPositions() {
      const swiper = document.querySelector(sectionSelector);
      if (!swiper) return;

      const image = swiper.querySelector(imageSelector);
      const svg = swiper.querySelector(svgSelector);
      const buttons = document.querySelector(buttonSelector);
      if (!buttons) return;

      const setButtonPosition = (height) => {
        buttons.style.top = `${height / 2}px`;
        buttons.style.transform = 'translateY(-50%)';
      };

      // Handle <img>
      if (image) {
        if (image.complete && image.naturalHeight !== 0) {
          setButtonPosition(image.offsetHeight);
        } else {
          image.addEventListener('load', () => {
            setButtonPosition(image.offsetHeight);
          });
        }
        return;
      }

      // Handle <svg>
      if (svg) {
        // Wait for DOM paint in case of inline SVG
        requestAnimationFrame(() => {
          const svgHeight = svg.getBoundingClientRect().height || svg.offsetHeight;
          setButtonPosition(svgHeight);
        });
        return;
      }
    }

    document.addEventListener('DOMContentLoaded', updateButtonPositions);
    window.addEventListener('resize', updateButtonPositions);
    document.addEventListener('shopify:section:load', updateButtonPositions);
  })();
</script>

{% comment %}
