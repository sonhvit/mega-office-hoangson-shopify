{{ 'customer.css' | asset_url | stylesheet_tag }}

{% style %}
  {% render 'section-margin' %}
{% endstyle %}

{% liquid
  assign image_size = section.settings.height

  case image_size
    when 'square'
      assign section_size = '100%'
      assign slide_class = image_size
    when 'landscape'
      assign section_size = '56.25%'
      assign slide_class = image_size
    else
      assign section_size = '133%'
      assign slide_class = image_size
  endcase
%}

<div class="login-section-wrapper">
  {% style %}
    #shopify-section-{{ section.id }} {
      --image-height: {{ section_size }};
    }
  {% endstyle %}
  <div class="customer login container {% if section.blocks.size > 0 %}customer--collage{% endif %}">
    <div class="login__wrapper">
      <div class="login__form color-{{ section.settings.color_scheme }} {% if section.settings.image == blank %} without-image  {% endif %}">
        <div class="login__content">
          <div class="" id="recover">
            <div class="page-header page-header--{{ section.settings.text_align }}">
              {% if section.settings.logo_image != blank %}
                {% capture sizes %}
                    (min-width: 1100px) 1920px, calc((100vw - 20px))
                  {% endcapture %}
                {{
                  section.settings.logo_image
                  | image_url: width: 118
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    height: 118,
                    width: 118,
                    widths: '360, 535, 720, 956',
                    class: 'form--logo__image'
                }}
              {% endif %}
              <div class="page-header__inner page-header__inner--{{ section.settings.text_align }}">
                <h2 class="login__title h2" tabindex="-1">
                  {{ 'customer.recover_password.title' | t }}
                </h2>
              </div>
            </div>
            <div>
              <p class="register__desc body-text register__desc--{{ section.settings.text_align }}">
                {{ 'customer.recover_password.subtext' | t }}
              </p>

              {%- form 'recover_customer_password' -%}
                {% assign recover_success = form.posted_successfully? %}
                <div class="field field--email">
                  <input
                    type="email"
                    value=""
                    name="email"
                    id="RecoverEmail"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    placeholder=" "
                    required
                    {% if form.errors %}
                      aria-invalid="true"
                      aria-describedby="RecoverEmail-email-error"
                      autofocus
                    {% endif %}
                  >
                  <label for="RecoverEmail" class="input-label">
                    {{- 'customer.login_page.email' | t -}}
                  </label>
                </div>

                <div class="login__buttons">
                  <button id="recover-in" class="button button--primary login__sign-in focus-inset">
                    {{ 'customer.login_page.submit' | t }}
                  </button>

                  <a
                    class="button button--simple_link login__sign-in anchor focus-inset"
                    href="#login"
                  >
                    {{ 'customer.login_page.cancel' | t }}
                  </a>
                </div>
              {%- endform -%}
            </div>
          </div>

          <div class="" id="login">
            <div class="page-header page-header--{{ section.settings.text_align }}">
              {% if section.settings.logo_image != blank %}
                {% capture sizes %}
                    (min-width: 1100px) 1920px, calc((100vw - 20px))
                  {% endcapture %}
                {{
                  section.settings.logo_image
                  | image_url: width: 956
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    height: 118,
                    width: 118,
                    widths: '360, 535, 720, 956',
                    class: 'form--logo__image'
                }}
              {% endif %}
              <div class="page-header__inner page-header__inner--{{ section.settings.text_align }}">
                <h1 class="login__title h2" tabindex="-1">
                  {{ 'customer.login_page.welcome' | t }}
                </h1>
                {% if section.settings.text != blank %}
                  <p class="register__desc body-text">
                    {{ section.settings.text }}
                  </p>
                {% endif %}
              </div>
            </div>
            {%- if recover_success == true -%}
              <h3 class="form__message" tabindex="-1" autofocus>{{ 'customer.recover_password.success' | t }}</h3>
            {%- endif -%}
            {%- form 'customer_login', novalidate: 'novalidate' -%}
              <div class="field field--email login__field">
                <input
                  type="email"
                  name="customer[email]"
                  class="field__input"
                  id="CustomerEmail"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  {% if form.errors contains 'form' %}
                    aria-invalid="true"
                    aria-describedby="LoginForm-email-error"
                  {% endif %}
                  placeholder=" "
                >

                <label for="CustomerEmail" class="input-label">
                  {{- 'customer.login_page.email' | t -}}
                </label>
                {% unless template.name == 'register' %}
                  {{ form.errors | default_errors }}
                {% endunless %}
              </div>

              {%- if form.password_needed -%}
                <div class="field field--pass login__field">
                  <div class="button-pass-visibility">
                    {% render 'icon-eye' %}
                    {% render 'icon-eye-close' %}
                  </div>
                  <input
                    type="password"
                    value=""
                    name="customer[password]"
                    class="field__input"
                    id="CustomerPassword"
                    autocomplete="current-password"
                    placeholder=" "
                    {% if form.errors contains 'form' %}
                      aria-invalid="true"
                    {% endif %}
                    required
                  >
                  <label for="CustomerPassword" class="input-label">
                    {{- 'customer.login_page.password' | t -}}
                  </label>
                  {% unless template.name == 'register' %}
                    {{ form.errors | default_errors }}
                  {% endunless %}
                </div>
              {%- endif -%}

              <div class="login__buttons login__buttons--space-between">
								<div class="forgot_password-wrapper">
								<span class="extra-small-font">{{ 'customer.login_page.forgot_password' | t }}</span>
									<a
										href="#recover"
										class="anchor extra-small-font button--underline login__forgot-password focus-inset login__forgot-password--left"
									>
										<span>{{ 'customer.login_page.forgot_password_1' | t }}</span>
									</a>
								</div>
                <button id="login__sign-in" class="button button--primary login__sign-in focus-inset">
                  {{ 'customer.login_page.title' | t }}
                </button>
                <div class="login__create-acc login__create-acc--center">
                  <span class="small-font">{{ 'customer.login_page.new_customer' | t }}</span>
                  <a
                    href="{{ routes.account_register_url }}"
                    class="button button--simple button--arrow focus-inset"
                  >
                    <span class="go-to-btn small-font button-label">{{ 'customer.login_page.create_account' | t }}</span>
                    {% render 'icon-button-arrow' %}
                  </a>
                </div>
              </div>
            {%- endform -%}
          </div>

          {%- if shop.checkout.guest_login -%}
            <div class="login__guest color-{{ section.settings.color_scheme }}">
              <div class="login__title h4">
                {{ 'customer.login_page.guest_title' | t }}
              </div>

              {%- form 'guest_login' -%}
                <button class="button button--primary focus-inset">
                  {{ 'customer.login_page.guest_continue' | t }}
                </button>
              {%- endform -%}
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.image != blank -%}
          {% liquid
            assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
          %}
          <div class="form--image {{ slide_class }}">
            <div
              class="form--image__overlay"
              style="opacity: {{ section.settings.overlay_opacity }}"
            ></div>
            {% capture sizes %}
                (min-width: 1100px) 1920px, calc((100vw - 20px))
              {% endcapture %}
            {{
              section.settings.image
              | image_url: width: section.settings.image.width
              | image_tag:
                loading: 'lazy',
                sizes: sizes,
                height: image_height,
                width: section.settings.image.width,
                widths: '360, 535, 720, 956',
                class: 'newsletter__image'
            }}
          </div>
        {%- endif -%}
      </div>
    </div>
    {% if section.blocks.size > 0 %}
      {% render 'account-collage', section: section %}
    {% endif %}
  </div>
</div>

<script>
  window.onload = () => {
    typeof PasswordViewer !== 'undefined' && new PasswordViewer();
  };
  const form = document.getElementById('customer_login');
  const buttonLogin = document.getElementById('login__sign-in');
  const buttonRecover = document.getElementById('recover-in');

  buttonLogin.addEventListener('click', () => {
    if (!form.checkValidity()) {
      form.reportValidity();
    }
  });
  buttonRecover.addEventListener('click', () => {
    if (!form.checkValidity()) {
      form.reportValidity();
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "tag": "section",
  "class": "spaced-section login-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-2",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.all.overlay_opacity.label",
      "default": 0.1
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.all.aspect_ratio.label"
    },
    {
      "type": "text",
      "id": "text",
      "default": "Good to see you again! Log in and pick up right where you left off.",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "t:sections.main-login.settings.logo_image.label"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.all.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_align.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "s",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "s",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ]
}
{% endschema %}
