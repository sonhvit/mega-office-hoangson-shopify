          "label": "t:sections.logo-list.blocks.logo.settings.image_2.label"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 60,
          "max": 180,
          "step": 5,
          "default": 100,
          "unit": "t:sections.logo-list.blocks.logo.settings.logo_width.unit",
          "label": "t:sections.logo-list.blocks.logo.settings.logo_width.label"
        },
