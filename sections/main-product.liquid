{% javascript %}
  class ProductModal extends ModalDialog {
    constructor() {
      super();
    }

    hide() {
      super.hide();
      window.pauseAllMedia();
    }

    show(opener) {
      super.show(opener);
      this.showActiveMedia();
    }

    showActiveMedia() {
      const activeMedia = this.querySelector(`[data-media-id="${this.openedBy.getAttribute('data-media-id')}"]`);

      if (
        activeMedia.nodeName == 'DEFERRED-MEDIA' &&
        activeMedia.querySelector('template')?.content?.querySelector('.js-youtube')
      )
        activeMedia.loadContent();
    }
  }
	class ProductRecommendations extends HTMLElement {
	constructor() {
		super();

		const handleIntersection = (entries, observer) => {
			if (!entries[0].isIntersecting) return;
			observer.unobserve(this);

			fetch(this.dataset.url)
				.then(response => response.text())
				.then(text => {
					const html = document.createElement('div');
					html.innerHTML = text;
					const recommendations = html.querySelector('product-recommendations--single');
					if (recommendations && recommendations.innerHTML.trim().length) {
						this.innerHTML = recommendations.innerHTML;
					}
				})
				.catch(e => {
					console.error(e);
				});
		}

		new IntersectionObserver(handleIntersection.bind(this), {rootMargin: '0px 0px 200px 0px'}).observe(this);
	}
}

customElements.define('product-modal', ProductModal);
customElements.define('product-recommendations--single', ProductRecommendations);
{% endjavascript %}

{%- if first_3d_model -%}
  <script type="application/json" id="ProductJSON-{{ product.id }}">
    {{ product.media | where: 'media_type', 'model' | json }}
  </script>

  <script src="{{ 'product-model.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
	"name": "t:sections.main-product.name",
	"tag": "section",
	"class": "product-section background",
	"settings": [
		{
			"type": "header",
			"content": "t:sections.main-product.settings.header.content",
			"info": "t:sections.main-product.settings.header.info"
		},
		{
			"type": "select",
			"id": "desktop_alignment",
			"options": [
				{
					"value": "right",
					"label": "t:sections.main-product.settings.desktop_alignment.options__1.label"
				},
				{
					"value": "left",
					"label": "t:sections.main-product.settings.desktop_alignment.options__2.label"
				}
			],
			"default": "right",
			"label": "t:sections.main-product.settings.desktop_alignment.label"
		},
		{
			"type": "select",
			"id": "mobile_alignment",
			"options": [
				{
					"value": "after",
					"label": "t:sections.main-product.settings.mobile_alignment.options__1.label"
				},
				{
					"value": "before",
					"label": "t:sections.main-product.settings.mobile_alignment.options__2.label"
				}
			],
			"default": "before",
			"label": "t:sections.main-product.settings.mobile_alignment.label"
		},
		{
			"type": "select",
			"id": "gallery_type",
			"options": [
				{
					"value": "slider_previews",
					"label": "t:sections.main-product.settings.gallery_type.options__1.label"
				},
				{
					"value": "stacked_gallery",
					"label": "t:sections.main-product.settings.gallery_type.options__3.label"
				},
				{
					"value": "grid_gallery",
					"label": "t:sections.main-product.settings.gallery_type.options__4.label"
				}
			],
			"default": "slider_previews",
			"label": "t:sections.main-product.settings.gallery_type.label"
		},
		{
			"type": "select",
			"id": "aspect_ratio",
			"options": [
				{
					"value": "1/1",
					"label": "t:sections.all.card.image_ratio.options__1.label"
				},
				{
					"value": "3/2",
					"label": "t:sections.all.card.image_ratio.options__2.label"
				},
				{
					"value": "3/4",
					"label": "t:sections.all.card.image_ratio.options__6.label"
				},
				{
					"value": "4/5",
					"label": "t:sections.all.card.image_ratio.options__3.label"
				},
				{
					"value": "5/4",
					"label": "t:sections.all.card.image_ratio.options__4.label"
				},
				{
					"value": "adapt",
					"label": "t:sections.all.card.image_ratio.options__5.label"
				}
			],
			"default": "4/5",
			"label": "t:sections.all.aspect_ratio.label"
		},
		{
			"type": "select",
			"id": "image_fit",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.card.image_fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.card.image_fit.options__2.label"
				}
			],
			"default": "cover",
			"label": "t:sections.all.card.image_fit.label",
			"info": "t:sections.main-product.settings.image_fit.info"
		},
		{
			"type": "select",
			"id": "image_fit_modal",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.card.image_fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.card.image_fit.options__2.label"
				}
			],
			"default": "contain",
			"label": "t:sections.all.card.image_fit.label",
			"info": "t:sections.main-product.settings.image_fit_modal.info"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-padding.header.content"
		},
		{
			"type": "select",
			"id": "padding_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-padding.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-padding.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-padding.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-padding.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-padding.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-padding.options__6.label"
				}
			],
			"default": "l",
			"label": "t:sections.all.section-padding.padding_bottom.label"
		}
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"type": "text",
			"limit": 1,
			"name": "t:sections.main-product.blocks.text.name",
			"settings": [
				{
					"type": "text",
					"id": "text",
					"default": "{{ product.vendor }}",
					"label": "t:sections.main-product.blocks.text.name"
				}
			]
		},
		{
			"type": "title",
			"name": "t:sections.main-product.blocks.title.name",
			"limit": 1,
			"settings": [
				{
					"type": "select",
					"id": "heading_size",
					"options": [
						{
							"value": "h4",
							"label": "t:sections.all.heading_size.options__4.label"
						},
						{
							"value": "h3",
							"label": "t:sections.all.heading_size.options__1.label"
						},
						{
							"value": "h2",
							"label": "t:sections.all.heading_size.options__2.label"
						},
						{
							"value": "h1",
							"label": "t:sections.all.heading_size.options__3.label"
						}
					],
					"default": "h4",
					"label": "t:sections.all.heading_size.label"
				}
			]
		},
		{
			"type": "price",
			"name": "t:sections.main-product.blocks.price.name",
			"limit": 1,
			"settings": [
				{
					"type": "checkbox",
					"id": "show_taxes",
					"default": false,
					"label": "t:sections.main-product.blocks.price.settings.show_taxes.label"
				}
			]
		},
		{
			"type": "custom_badges",
			"name": "t:sections.main-product.blocks.custom_badges.name",
			"limit": 1
		},
		{
			"type": "description",
			"name": "t:sections.main-product.blocks.description.name",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "description",
					"label": "t:sections.all.text.label",
					"info": "t:sections.main-product.blocks.description.settings.text.info"
				},
				{
					"id": "enable_read_more",
					"type": "checkbox",
					"default": true,
					"label": "t:sections.main-product.blocks.description.settings.enable_read_more.label",
					"info": "t:sections.main-product.blocks.description.settings.enable_read_more.info"
				},
				{
					"id": "heading",
					"type": "text",
					"default": "Some heading",
					"label": "t:sections.all.heading.label"
				},
				{
					"type": "image_picker",
					"id": "image",
					"label": "t:sections.all.image.image_first"
				},
				{
					"type": "image_picker",
					"id": "image_second",
					"label": "t:sections.all.image.image_second"
				}
			]
		},
		{
			"type": "tags",
			"name": "t:sections.main-product.blocks.tags.name",
			"limit": 1,
			"settings": [
				{
					"type": "checkbox",
					"id": "enable_tag_link",
					"default": false,
					"label": "t:sections.main-product.blocks.tags.enable_tag_link"
				}
			]
		},
		{
			"type": "sku",
			"name": "t:sections.main-product.blocks.sku.name",
			"limit": 1
		},
		{
			"type": "inventory",
			"name": "t:sections.main-product.blocks.inventory.name",
			"limit": 1,
			"settings": [
				{
					"type": "number",
					"id": "max_stock",
					"label": "Max Stock Quantity",
					"default": 100
				}
			]
		},
		{
			"type": "variant_picker",
			"name": "t:sections.main-product.blocks.variant_picker.name",
			"limit": 1,
			"settings": [
				{
          "type": "checkbox",
          "id": "show_size_guide",
          "default": false,
          "label": "t:sections.main-product.blocks.variant_picker.settings.show_guide.label",
					"info": "t:sections.main-product.blocks.variant_picker.settings.show_guide.info"
        },
        {
          "type": "inline_richtext",
          "id": "size_guide_header",
          "default": "Some heading",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "richtext",
          "id": "size_guide_decription",
          "label": "t:sections.all.description.label"
        },
        {
          "type": "text",
          "id": "size_guide_text",
          "default": "Size chart",
          "label": "t:sections.all.button.label.label"
        },
				{
					"type": "image_picker",
					"id": "size_guide_image",
					"label": "t:sections.all.image.label"
				},
				{
					"type": "page",
					"id": "page",
					"label": "t:sections.main-product.blocks.variant_picker.settings.page.label"
				}
			]
		},
		{
			"type": "buy_buttons",
			"name": "t:sections.main-product.blocks.buy_buttons.name",
			"limit": 1,
			"settings": [
				{
					"type": "checkbox",
					"id": "show_dynamic_checkout",
					"default": false,
					"label": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.label",
					"info": "t:sections.main-product.blocks.buy_buttons.settings.show_dynamic_checkout.info"
				},
				{
					"type": "checkbox",
					"id": "show_quantity",
					"default": true,
					"label": "t:sections.main-product.blocks.buy_buttons.settings.show_quantity.label"
				},
				{
					"type": "checkbox",
					"id": "show_gift_card_recipient",
					"default": true,
					"label": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.label",
					"info": "t:sections.main-product.blocks.buy_buttons.settings.show_gift_card_recipient.info"
				}
			]
		},
		{
			"type": "share",
			"name": "t:sections.main-product.blocks.share.name",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "share_label",
					"default": "Share",
					"label": "t:sections.main-product.blocks.share.settings.share_label.label"
				},
				{
					"type": "checkbox",
					"id": "show_share_facebook",
					"default": true,
					"label": "t:sections.main-product.blocks.share.settings.show_share_facebook.label"
				},
				{
					"type": "checkbox",
					"id": "show_share_twitter",
					"default": true,
					"label": "t:sections.main-product.blocks.share.settings.show_share_twitter.label"
				},
				{
					"type": "checkbox",
					"id": "show_share_pinterest",
					"default": true,
					"label": "t:sections.main-product.blocks.share.settings.show_share_pinterest.label"
				},
				{
					"type": "checkbox",
					"id": "show_share_copy",
					"default": true,
					"label": "t:sections.main-product.blocks.share.settings.show_share_copy.label"
				}
			]
		},
		{
			"type": "pickup_availability",
			"name": "t:sections.main-product.blocks.pickup_availability.name",
			"limit": 1
		},
		{
			"type": "custom_liquid",
			"name": "t:sections.main-product.blocks.custom_liquid.name",
			"settings": [
				{
					"type": "liquid",
					"id": "custom_liquid",
					"label": "t:sections.main-product.blocks.custom_liquid.settings.custom_liquid.label",
					"info": "t:sections.main-product.blocks.custom_liquid.settings.custom_liquid.info"
				}
			]
		},
		{
			"type": "dropdown_information",
			"name": "t:sections.main-product.blocks.dropdown_information.name",
			"limit": 6,
			"settings": [
				{
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.main-product.blocks.dropdown_information.settings.icon.label",
          "info": "t:sections.main-product.blocks.dropdown_information.settings.icon.info"
        },
				{
          "type": "image_picker",
          "id": "image_dark",
          "label": "t:sections.main-product.blocks.dropdown_information.settings.icon_dark.label",
          "info": "t:sections.main-product.blocks.dropdown_information.settings.icon_dark.info"
        },
				{
					"id": "heading",
					"type": "text",
					"default": "Some heading",
					"label": "t:sections.all.heading.label"
				},
				{
					"type": "richtext",
					"id": "description",
					"default": "<p>Some description</p>",
					"label": "t:sections.all.text.label"
				},
				{
					"type": "checkbox",
					"id": "default_open",
					"default": false,
					"label": "t:sections.main-product.blocks.dropdown_information.settings.default_open.label"
				}
			]
		},
		{
			"type": "multicolumn_information",
			"name": "t:sections.main-product.blocks.multicolumn_information.name",
			"limit": 6,
			"settings": [
				{
					"type": "header",
					"content": "t:sections.main-product.blocks.multicolumn_information.settings.information_block.label_1"
				},
				{
          "type": "image_picker",
          "id": "image_1",
          "label": "t:sections.main-product.blocks.multicolumn_information.settings.icon.label",
          "info": "t:sections.main-product.blocks.multicolumn_information.settings.icon.info"
        },
				{
          "type": "image_picker",
          "id": "image_dark_1",
          "label": "t:sections.main-product.blocks.multicolumn_information.settings.icon_dark.label",
          "info": "t:sections.main-product.blocks.multicolumn_information.settings.icon_dark.info"
        },
				{
					"type": "text",
					"id": "heading_1",
					"default": "Some heading",
					"label": "t:sections.all.heading.label"
				},
				{
					"type": "richtext",
					"id": "description_1",
					"default": "<p>Some description</p>",
					"label": "t:sections.all.text.label"
				},
				{
					"type": "header",
					"content": "t:sections.main-product.blocks.multicolumn_information.settings.information_block.label_2"
				},
				{
          "type": "image_picker",
          "id": "image_2",
          "label": "t:sections.main-product.blocks.multicolumn_information.settings.icon.label",
          "info": "t:sections.main-product.blocks.multicolumn_information.settings.icon.info"
        },
				{
          "type": "image_picker",
          "id": "image_dark_2",
          "label": "t:sections.main-product.blocks.multicolumn_information.settings.icon_dark.label",
          "info": "t:sections.main-product.blocks.multicolumn_information.settings.icon_dark.info"
        },
				{
					"type": "text",
					"id": "heading_2",
					"default": "Some heading",
					"label": "t:sections.all.heading.label"
				},
				{
					"type": "richtext",
					"id": "description_2",
					"default": "<p>Some description</p>",
					"label": "t:sections.all.text.label"
				},
				{
					"type": "header",
					"content": "t:sections.main-product.blocks.multicolumn_information.settings.information_block.label_3"
				},
				{
          "type": "image_picker",
          "id": "image_3",
          "label": "t:sections.main-product.blocks.multicolumn_information.settings.icon.label",
          "info": "t:sections.main-product.blocks.multicolumn_information.settings.icon.info"
        },
				{
          "type": "image_picker",
          "id": "image_dark_3",
          "label": "t:sections.main-product.blocks.multicolumn_information.settings.icon_dark.label",
          "info": "t:sections.main-product.blocks.multicolumn_information.settings.icon_dark.info"
        },
				{
					"type": "text",
					"id": "heading_3",
					"default": "Some heading",
					"label": "t:sections.all.heading.label"
				},
				{
					"type": "richtext",
					"id": "description_3",
					"default": "<p>Some description</p>",
					"label": "t:sections.all.text.label"
				}
			]
		},
		{
			"type": "characteristics",
			"name": "t:sections.main-product.blocks.characteristics.name",
			"limit": 1,
			"settings": [
				{
					"type": "paragraph",
					"content": "t:sections.main-product.blocks.characteristics.paragraph"
				},
				{
					"id": "heading",
					"type": "text",
					"default": "Some heading",
					"label": "t:sections.all.heading.label"
				}
			]
		},
		{
			"type": "popup",
			"name": "t:sections.main-product.blocks.popup.name",
			"limit": 2,
			"settings": [
				{
					"id": "label",
					"type": "text",
					"default": "Popup link text",
					"label": "t:sections.main-product.blocks.popup.settings.link_label.label"
				},
				{
					"id": "heading",
					"type": "text",
					"default": "Popup heading",
					"label": "t:sections.main-product.blocks.popup.settings.heading.label"
				},
				{
					"id": "text",
					"type": "richtext",
					"default": "<p>Some text</p>",
					"label": "t:sections.main-product.blocks.popup.settings.text.label"
				},
				{
					"id": "image",
					"type": "image_picker",
					"label": "t:sections.main-product.blocks.popup.settings.image.label"
				},
				{
					"type": "page",
					"id": "page",
					"label": "t:sections.main-product.blocks.popup.settings.page.label"
				}
			]
		},
		{
			"type": "complementary",
			"name": "t:sections.main-product.blocks.complementary.name",
			"limit": 1,
			"settings": [
				{
					"type": "paragraph",
					"content": "t:sections.product-recommendations.settings.paragraph__1.content"
				},
				{
					"type": "range",
					"id": "products_limit",
					"min": 4,
					"max": 10,
					"step": 1,
					"default": 6,
					"label": "t:sections.product-recommendations.settings.products_limit.label"
				},
				{
					"type": "header",
					"content": "t:sections.product-recommendations.settings.header__2.content"
				},
				{
					"type": "select",
					"id": "image_ratio",
					"options": [
						{
							"value": "landscape",
							"label": "t:sections.all.card.image_ratio_2.options__1.label"
						},
						{
							"value": "portrait",
							"label": "t:sections.all.card.image_ratio_2.options__2.label"
						},
						{
							"value": "square",
							"label": "t:sections.all.card.image_ratio_2.options__3.label"
						}
					],
					"default": "portrait",
					"label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
				},
				{
					"type": "select",
					"id": "image_fit",
					"label": "t:sections.all.card.image_fit.label",
					"options": [
						{
							"value": "contain",
							"label": "t:sections.all.card.image_fit.options__1.label"
						},
						{
							"value": "cover",
							"label": "t:sections.all.card.image_fit.options__2.label"
						}
					],
					"default": "cover"
				},
				{
					"type": "checkbox",
					"id": "show_secondary_image",
					"default": true,
					"label": "t:sections.all.card.show_secondary_image.label"
				},
				{
					"type": "checkbox",
					"id": "show_vendor",
					"default": false,
					"label": "t:sections.all.card.show_vendor.label"
				}
			]
		}
	]
}
{% endschema %}
