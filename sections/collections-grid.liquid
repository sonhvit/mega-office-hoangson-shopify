      const svgSelector = ` .collections__card--image svg`;

      function updateButtonPositions() {
        {% comment %} if (window.innerWidth < 1150) return; {% endcomment %}
          const swiper = document.querySelector(sectionSelector);

          if (!swiper) return;

          const image = swiper.querySelector(imageSelector);
          const svg = swiper.querySelector(svgSelector);

        if (!image) {
          const setButtonPosition = () => {
            const imageHeight = svg.offsetHeight;
          console.log("svgSelector", svg)

            const buttons = document.querySelector(buttonSelector);
              buttons.style.top = `${imageHeight / 2}px`;
              buttons.style.transform = 'translateY(-50%)';
          };
          if (svg.complete) {
          setButtonPosition();
        } else {
          svg.addEventListener('load', setButtonPosition);
        }
        } else {
          const setButtonPosition = () => {
            const imageHeight = image.offsetHeight;
            const buttons = document.querySelector(buttonSelector);
              buttons.style.top = `${imageHeight / 2}px`;
              buttons.style.transform = 'translateY(-50%)';
          };
           if (image.complete) {
