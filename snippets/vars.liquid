{%- liquid
	assign body_font_regular = settings.type_body_font | font_modify: 'weight', '400'
	assign body_font_medium = settings.type_body_font | font_modify: 'weight', '500'
	assign body_font_semibold = settings.type_body_font | font_modify: 'weight', '600'
%}
 
{% style %}
	  {{ settings.type_body_font | font_face: font_display: 'swap' }}
	  {{ body_font_regular | font_face: font_display: 'swap' }}
	  {{ body_font_medium | font_face: font_display: 'swap' }}
	  {{ body_font_semibold | font_face: font_display: 'swap' }}

		{% for scheme in settings.color_schemes -%}
			{% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
			{% if forloop.index == 1 -%}
				:root,
			{%- endif %}
			[data-scheme=light] .color-{{ scheme.id }} {
				{% render 'scheme-light-vars', scheme : scheme %}
			}
			@media (prefers-color-scheme: light) {
				{% if forloop.index == 1 -%}
							:root,
				{%- endif %}
				[data-scheme=auto] .color-{{ scheme.id }} {
					{% render 'scheme-light-vars', scheme : scheme %}
				}
			}
			{% if forloop.index == 1 -%}
				[data-scheme=dark],
				.color-inverse,
			{%- endif %}
			[data-scheme=dark] .color-{{ scheme.id }} {
				{% render 'scheme-dark-vars', scheme : scheme, forloop: forloop %}
			}
			@media (prefers-color-scheme: dark) {
				{% if forloop.index == 1 -%}
					[data-scheme=auto],
				{%- endif %}
				[data-scheme=auto] .color-{{ scheme.id }} {
					{% render 'scheme-dark-vars', scheme : scheme, forloop: forloop %}
				}
			}

		{% endfor %}

	  {{ scheme_classes | prepend: 'body' }} {
	  color: rgba(var(--color-foreground));
	    background: rgb(var(--color-background));
	  background: var(--gradient-background);
	background-attachment: fixed;
	  }

	  :root {
	    --column-count: 1;
	    --announcement-height: 0px;
	    --ann-height: 0px;
	    --header-height: 0px;
	    --breadcrumbs-height: 0px;
	    --margin-header: 0px;

	    --spaced-section: 5rem;

	    --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-body-style: {{ settings.type_body_font.style }};
	    --font-body-weight: 400;

	    --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
			--font-body-scale-xs: {{ settings.body_scale_xs | divided_by: 100.0 }};
			--font-body-scale-s: {{ settings.body_scale_s | divided_by: 100.0 }};
			--font-body-scale-l: {{ settings.body_scale_l | divided_by: 100.0 }};
			--font-body-scale-xl: {{ settings.body_scale_xl | divided_by: 100.0 }};
	    --font-body-line-height: {{ settings.type_body_line_height }};
	    --font-body-letter-spacing: {{ settings.type_body_letter_spacing }}em;

	    --font-heading-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-heading-style: {{ settings.type_body_font.style }};
	    --font-heading-weight: 600;
	    --font-heading-letter-spacing: {{ settings.type_header_letter_spacing }}em;
	    --font-heading-line-height: {{ settings.type_header_line_height }};
	    --font-heading-text-transform: {{ settings.heading_text_transform }};

	    --font-subtitle-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-subtitle-style: {{ settings.type_body_font.style }};
	    --font-subtitle-weight: 400;
	    --font-subtitle-text-transform: {{ settings.subtitle_text_transform }};
	    --font-subtitle-scale: {{ settings.subtitle_scale | divided_by: 100.0 }};

	    --font-heading-h1-scale: {{ settings.heading_h1_scale | divided_by: 100.0 }};
	    --font-heading-h2-scale: {{ settings.heading_h2_scale | divided_by: 100.0 }};
	    --font-heading-h3-scale: {{ settings.heading_h3_scale | divided_by: 100.0 }};
	    --font-heading-h4-scale: {{ settings.heading_h4_scale | divided_by: 100.0 }};
	    --font-heading-h5-scale: {{ settings.heading_h5_scale | divided_by: 100.0 }};

	    --font-heading-card-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-heading-card-style: {{ settings.type_body_font.style }};
	    --font-heading-card-weight: 600;
			--font-heading-card-letter-spacing: {{ settings.type_header_card_letter_spacing }}em;
			--font-price-card-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
			--font-prcie-card-style: {{ settings.type_body_font.style }};
			--font-prcie-card-weight: 600;
			--font-price-card-letter-spacing: {{ settings.type_price_card_letter_spacing }}em;
	    --font-text-card-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-text-card-style: {{ settings.type_body_font.style }};
	    --font-text-card-weight: 400;

	    --font-heading-card-scale: {{ settings.heading_scale_card | divided_by: 100.0 }};
			--font-price-card-scale: {{ settings.price_scale_card | divided_by: 100.0 }};
	    --font-text-card-scale: {{ settings.text_scale_card | divided_by: 100.0 }};

	    --font-button-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-button-style: {{ settings.type_body_font.style }};
	    --font-button-weight: 500;
	    --font-button-text-transform: {{ settings.button_text_transform }};
			--font-button-scale: {{ settings.button_scale | divided_by: 100.0 }};
			--font-button-letter-spacing: {{ settings.button_letter_spacing }}em;

	    --font-subtitle-letter-spacing: 0.04em;
	    --font-subtitle-secondary-letter-spacing: -0.04em;

	    --font-header-menu-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-header-menu-style: {{ settings.type_body_font.style }};
	    --font-header-menu-weight: 400;
	    --font-header-menu-text-transform: {{ settings.header_menu_text_transform }};

	    --font-footer-menu-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-footer-menu-style: {{ settings.type_body_font.style }};
	    --font-footer-menu-weight: 400;
	    --font-footer-link-size: {{ settings.link_size_footer }}px;
	    --font-footer-bottom-link-size: {{ settings.link_size_footer_bottom }}px;

	    --font-popups-heading-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-popups-heading-style: {{ settings.type_body_font.style }};
	    --font-popups-heading-weight: 600;
	    --font-popups-text-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
	    --font-popups-text-style: {{ settings.type_body_font.style }};
	    --font-popups-text-weight: 400;
	    --font-popup-heading-scale: {{ settings.popup_heading_scale | divided_by: 100.0 }};
	    --font-popup-desc-scale: {{ settings.popup_desc_scale | divided_by: 100.0 }};
	    --font-popup-text-scale: {{ settings.popup_text_scale | divided_by: 100.0 }};
	    --font-notification-heading-scale: {{ settings.notification_heading_scale | divided_by: 100.0 }};
	    --font-notification-text-scale: {{ settings.notification_text_scale | divided_by: 100.0 }};

	    --border-radius-button: {{ settings.button_border_radius }}px;
	    --payment-terms-background-color: {{ settings.colors_background_1 }};

	    --color-shadow: var(--color-foreground);

			--border-radius-small: 4px;
			--border-radius-medium: 8px;
			--border-radius-large: 10px;
	  }

	  @media screen and (min-width: 990px) {
	    :root {
	      --spaced-section: 16rem;
	    }
	  }

	  *,
	  *::before,
	  *::after {
	  	box-sizing: inherit;
	  }

	  html {
	  box-sizing: border-box;
	  font-size: 10px;
	  height: 100%;
	  }

	  body {
			position: relative;
			display: flex;
			flex-direction: column;
			min-height: 100%;
			margin: 0;
			font-size: calc(var(--font-body-scale) * 0.9rem);
			line-height: 1.4;
			font-family: var(--font-body-family);
			font-style: var(--font-body-style);
			font-weight: var(--font-body-weight);
			overflow-x: hidden;
	  }

	  @media screen and (min-width: 1150px) {
	    body {
	      font-size: calc(var(--font-body-scale) * 1rem);
	    }
	  }
{% endstyle %}
