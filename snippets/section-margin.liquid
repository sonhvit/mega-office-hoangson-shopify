#shopify-section-{{ section.id }} {
{% if section.settings.margin_top == 'no-indent' %}
  padding-top: 0;
{% elsif section.settings.margin_top == 'xl' %}
  padding-top: 7.2rem;
{% elsif section.settings.margin_top == 'l' %}
  padding-top: 4.8rem;
{% elsif section.settings.margin_top == 'm' %}
  padding-top: 4.2rem;
{% elsif section.settings.margin_top == 's' %}
  padding-top: 3rem;
{% else %}
  padding-top: 1.8rem;
{% endif %}

{% if section.settings.margin_bottom == 'no-indent' %}
  padding-bottom: 0;
{% elsif section.settings.margin_bottom == 'xl' %}
  padding-bottom: 7.2rem;
{% elsif section.settings.margin_bottom == 'l' %}
  padding-bottom: 4.8rem;
{% elsif section.settings.margin_bottom == 'm' %}
  padding-bottom: 4.2rem;
{% elsif section.settings.margin_bottom == 's' %}
  padding-bottom: 3rem;
{% else %}
  padding-bottom: 1.8rem;
{% endif %}
}

@media screen and (min-width: 750px) { #shopify-section-{{ section.id }} {
{% if section.settings.margin_top == 'no-indent' %}
  padding-top: 0;
{% elsif section.settings.margin_top == 'xl' %}
  padding-top: 10rem;
{% elsif section.settings.margin_top == 'l' %}
  padding-top: 5.2rem;
{% elsif section.settings.margin_top == 'm' %}
  padding-top: 4.8rem;
{% elsif section.settings.margin_top == 's' %}
  padding-top: 3.4rem;
{% else %}
  padding-top: 2rem;
{% endif %}

{% if section.settings.margin_bottom == 'no-indent' %}
  padding-bottom: 0;
{% elsif section.settings.margin_bottom == 'xl' %}
  padding-bottom: 10rem;
{% elsif section.settings.margin_bottom == 'l' %}
  padding-bottom: 5.2rem;
{% elsif section.settings.margin_bottom == 'm' %}
  padding-bottom: 4.8rem;
{% elsif section.settings.margin_bottom == 's' %}
  padding-bottom: 3.4rem;
{% else %}
  padding-bottom: 2rem;
{% endif %}
} }

@media screen and (min-width: 1150px) { #shopify-section-{{ section.id }} {
{% if section.settings.margin_top == 'no-indent' %}
  padding-top: 0;
{% elsif section.settings.margin_top == 'xl' %}
  padding-top: 12rem;
{% elsif section.settings.margin_top == 'l' %}
  padding-top: 6.4rem;
{% elsif section.settings.margin_top == 'm' %}
  padding-top: 5.4rem;
{% elsif section.settings.margin_top == 's' %}
  padding-top: 4rem;
{% else %}
  padding-top: 2.4rem;
{% endif %}

{% if section.settings.margin_bottom == 'no-indent' %}
  padding-bottom: 0;
{% elsif section.settings.margin_bottom == 'xl' %}
  padding-bottom: 12rem;
{% elsif section.settings.margin_bottom == 'l' %}
  padding-bottom: 6.4rem;
{% elsif section.settings.margin_bottom == 'm' %}
  padding-bottom: 5.4rem;
{% elsif section.settings.margin_bottom == 's' %}
  padding-bottom: 4rem;
{% else %}
  padding-bottom: 2.4rem;
{% endif %}
} }
