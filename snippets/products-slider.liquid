{% liquid
	assign slideshow_speed = slider_settings.slideshow_speed
	assign slideshow_delay = slider_settings.slideshow_delay
	assign autoplay = slider_settings.autoplay
	assign stop_autoplay = slider_settings.stop_autoplay
	assign show_arrows = slider_settings.show_arrows
	assign per_row = slider_settings.per_row
	assign media_size = slider_settings.image_ratio
	assign media_fit = slider_settings.image_fit
	assign show_secondary_image = slider_settings.show_secondary_image
	assign show_vendor = slider_settings.show_vendor
	assign show_tags = slider_settings.show_tags
	assign show_type = slider_settings.show_type
	assign show_desc = slider_settings.show_desc
	assign show_color_swatch = slider_settings.show_color_swatch
	assign show_collection_name = slider_settings.show_collection_name
	assign show_sku = slider_settings.show_sku
	assign show_two_cards = slider_settings.show_two_cards
	assign product_variant_type = slider_settings.product_variant_type
	assign layout = slider_settings.layout
	assign show_inventory = slider_settings.show_inventory
	
	assign mobile = 1
	if show_two_cards
		assign mobile = 2
	endif

		assign placeholder = 7
	if layout == 'static'
		assign placeholder = 12
	endif
%}
	<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
	<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<div
	class="products-slider"
	data-id="{{ section_id }}"
	data-speed="{{ slideshow_speed }}"
	data-delay="{{ slideshow_delay }}"
	data-autoplay="{{ autoplay }}"
	data-stop-autoplay="{{ stop_autoplay }}"
	data-show-arrows="{{ show_arrows }}"
	data-per-row="{{ per_row }}"
	data-mobile="{{ mobile }}"
	style="--slider-per-row : {{ per_row }}"
>
<div class="{% if container %} container{% endif %}">
	<div class="products-slider__container">

		<div class="products-slider__wrapper">

			<div class="products-slider__swiper {% if section.settings.layout == 'slider' %} swiper mySwiper {% endif %}">
				<div class="products-slider__swiper-wrapper {% if section.settings.layout == 'slider' %} swiper-wrapper {% else %}products-no-slider {% endif %}
					{% if section.settings.show_two_cards %} product-list--2-mobile{% endif %}">
					{% for product in product_list %}
						<div
							data-type="{{ product.type }}"
							class="products-slider__slide  {% if section.settings.layout == 'slider' %} swiper-slide {% endif %}"
						>
							{% render 'product-card',
								product_card_product: product,
								media_size: media_size,
								media_fit: media_fit,
								show_secondary_image: show_secondary_image,
								show_vendor: show_vendor,
								show_desc: show_desc,
								show_inventory: show_inventory,
								show_color_swatch: show_color_swatch,
								show_collection_name: show_collection_name,
								show_tags: show_tags,
								show_type: show_type,
								product_variant_type: product_variant_type,
								section_id: section_id,
								show_sku: show_sku
							%}
						</div>
					{%- else -%}
						{%- for i in (1..placeholder) -%}
							{% assign placeholder_count = forloop.index | modulo: 4 | plus: 1 %}
							<div class="products-slider__slide swiper-slide">
								{% render 'product-card-placeholder', media_size: media_size, placeholder_index: placeholder_count %}
							</div>
						{% endfor %}
					{% endfor %}
				</div>
			</div>
		</div>

			{% if show_arrows and layout == 'slider' %}
				<button class="swiper-button swiper-button-prev swiper-button-disabled">
					{%- render 'icon-swiper-next' -%}
				</button>
				<button class="swiper-button swiper-button-next">
					{%- render 'icon-swiper-next' -%}
				</button>

				{% comment %}<script>
					(function () {
						function adjustButtonPosition(height) {
							document
								.querySelectorAll(
									`#shopify-section-{{ section.id }} .swiper-button`
								)
								.forEach((button) => {
									button.style.top = height / 2 + 'px';
								});
						}
						function changePosition() {
							if (window.innerWidth < 1150) return;
							const image = document.querySelector(
								`#shopify-section-{{ section.id }} .media  img`
							);
							if (image) {
								if (image.tagName === 'IMG') {
									if (image.complete) {
										adjustButtonPosition(image.offsetHeight);
									} else {
										image.addEventListener('load', function () {
											adjustButtonPosition(this.offsetHeight);
										});
									}
								} else if (image.tagName === 'svg') {
									const height = image.getBoundingClientRect().height;
									adjustButtonPosition(height);
								}
							}
						}
						changePosition();
						document.addEventListener(
							'shopify:section:load',
							changePosition
						);
						let resizeTimeout;
						window.addEventListener('resize', function () {
							clearTimeout(resizeTimeout);
							resizeTimeout = setTimeout(changePosition, 100);
						});
					})();
				</script>{% endcomment %}
				<div class="swiper-pagination swiper-pagination-1 swiper-pagination-default {% if section.settings.enable_autoplay == false %} not-autoplay{% else %} bullet-autoplay{% endif %}"></div>
			{% endif %}

	</div>
</div>
</div>
