{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

{% style %}
	 {% render 'section-padding' %}
	 {% render 'section-margin' %}

	@media screen and (min-width: 576px) and (max-width: 989px) {
	  .multicolumn--separators .multicolumn-card:nth-child(2n - 1) {
	    padding-left: 0!important;
	    border: none;
	  }
	}


	@media screen and (min-width: 990px) {
	  .multicolumn--separators .multicolumn-card:nth-child({{ section.settings.multicolumn_to_show }}n + 1) {
	    padding-left: 0!important;
	    border: none;
	  }
	}
{% endstyle %}

<div class="multicolumn color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding multicolumn--solid">
	<div class="container">
		{%- if section.blocks.size > 0 -%}
			<div class="multicolumn-list__wrapper multicolumn-list__wrapper--{{ section.settings.multicolumn_to_show }} multicolumn-list__wrapper--static content">
				{% for block in section.blocks %}
					{%- case block.type -%}
						{%- when 'column_with_icon' -%}
							<div
								class="multicolumn-card multicolumn-card--{{ block.settings.text_align}} column_with_icon"
								{{ block.shopify_attributes }}
							>
								{% if block.settings.button_link != blank %}
									<a
										class="multicolumn-card__full-link"
										href="{{ block.settings.button_link }}"
									></a>
								{% endif %}
								{%- if block.settings.image != blank -%}
									<div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--image">
										{%- if block.settings.image != blank -%}
											{{
												block.settings.image
												| image_url: width: 40
												| image_tag:
													loading: 'lazy',
													sizes: '100vw',
													widths: '550, 720',
													height: 40,
													width: 40,
													class: 'multicolumn-card-item__image'
											}}
										{% endif %}
									</div>
								{%- endif -%}

								<div class="multicolumn-card__info">
									{%- if block.settings.heading != blank -%}
										<p class="multicolumn-card__heading">
											{{ block.settings.heading }}
										</p>
									{%- endif -%}
									{%- if block.settings.text != blank -%}
										<div class="multicolumn-card__text small-font">
											{{ block.settings.text }}
										</div>
									{%- endif -%}
								</div>
								{% render 'button', layout: block, class: 'multicolumn-card' %}
							</div>
						{%- when 'column_without_icon' -%}
							<div
								class="multicolumn-card multicolumn-card__secondary multicolumn-card--{{ block.settings.text_align}}"
								{{ block.shopify_attributes }}
							>
								{% if block.settings.button_link != blank %}
									<a
										class="multicolumn-card__full-link"
										href="{{ block.settings.button_link }}"
									></a>
								{% endif %}
								<div class="multicolumn-card__info">
									{%- if block.settings.heading != blank -%}
										<h3 class="multicolumn-card__heading {{ block.settings.card_heading_size }}">
											{{ block.settings.heading }}
										</h3>
									{%- endif -%}
									{%- if block.settings.text != blank -%}
										<div class="multicolumn-card__text ">
											{{ block.settings.text }}
										</div>
									{%- endif -%}
								</div>
								{% render 'button', layout: block, class: 'multicolumn-card' %}
							</div>
					{%- endcase -%}
				{% endfor %}
			</div>
		{%- endif -%}
	</div>
</div>

{% schema %}
