{{ 'featured-collection.css' | asset_url | stylesheet_tag }}

<script src="{{ 'featured-collection.js' | asset_url }}" defer="defer"></script>

{% liquid
	assign autoplay = section.settings.is_autoplay
	assign stop_autoplay = section.settings.stop_autoplay
	assign slideshow_delay = section.settings.slideshow_delay
	assign slideshow_speed = section.settings.slideshow_speed
	assign show_two_cards = section.settings.show_two_cards
	assign mobile = 1
	if show_two_cards
		assign mobile = 2
	endif
	if section.settings.show_arrows
		assign show_arrows = true
	else
		assign show_arrows = false
	endif
	assign count = 0
	for block in section.blocks
		assign count = count | plus: 1
	endfor
%}
{% style %}
	{% render 'section-margin' %}
	#shopify-section-{{ section.id }} {
		--slide_duration : {{ slideshow_delay }}s;
		--delay : {{ slideshow_delay }}s;
		--speed : {{ slideshow_speed }}s;
	}
{% endstyle %}

<div
	class="featured_collection "
	data-id="shopify-section-{{ section.id }}"
	data-autoplay="{{ autoplay }}"
	data-stop-autoplay="{{ stop_autoplay }}"
	data-speed="{{ slideshow_speed }}"
	data-delay="{{ slideshow_delay }}"
	data-mobile="{{ mobile }}"
	data-per_row="{{ 1 }}"
	data-disable-slider="{{ section.settings.disable_slider }}"
>
	{% render 'section-header', show_arrows: show_arrows %}

	<div class="container">
		<div class="featured_collection_swiper">
			<div class="featured_collection__blok">
				{% liquid
					assign media_size = section.settings.image_ratio
					case media_size
						when 'landscape'
							assign image_size = '56.25%'
						when 'portrait'
							assign image_size = '130%'
						when 'square'
							assign image_size = '100%'
						else
							assign image_size = '100%'
					endcase
				%}
				{% style %}
					#shopify-section-{{ section.id }} .featured_collection_image {
						--slide-height : {{ image_size }};
					}
					#shopify-section-{{ section.id }} .have-overlay {
						--overlay-alpha : {{ section.settings.overlay_opacity }}%;
					}
				{% endstyle %}

				<div
					class="featured_collection-image_box have-overlay color-{{ section.settings.color_scheme }} background"
					data-id="{{ section.id }}"
				>
					{% if section.settings.button_link_collection != blank %}
						<a
							class="featured_collection_image__full-link"
							href="{{ section.settings.button_link_collection }}"
						></a>
					{% endif %}
					<div class="featured_collection_image">
						{% if section.settings.video != blank %}
							{% liquid
								assign video_height = section.settings.video.sources[0].width | divided_by: section.settings.video.aspect_ratio
							%}
							{{
								section.settings.video
								| video_tag:
									width: section.settings.video.sources[0].width,
									height: video_height,
									autoplay: true,
									loop: true,
									controls: false,
									muted: true
							}}
						{%- elsif section.settings.image != blank -%}
							{% assign image_height = section.settings.image.width
								| divided_by: section.settings.image.aspect_ratio
							%}
							{{
								section.settings.image
								| image_url: width: 3840
								| image_tag:
									loading: 'lazy',
									width: section.settings.image.width,
									height: image_height,
									sizes: '100vw',
									widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
							}}
						{%- else -%}
							{{
								'hero-apparel-2'
								| placeholder_svg_tag: 'placeholder-svg placeholder'
							}}
						{%- endif -%}
					</div>

					<div class="featured_collection__info">
						{% if section.settings.badege_text != blank
							or section.settings.badge_image != blank
						%}
							<div
								class="featured_collection__badge"
								style="background: {{ section.settings.badge_bg_color }}"
							>
								{%- if section.settings.badge_image != blank -%}
									{{
										section.settings.badge_image
										| image_url: width: section.settings.badge_image.width
										| image_tag:
											loading: 'lazy',
											sizes: '100vw',
											widths: '550, 720',
											height: 16,
											width: 16,
											class: 'banner-slider__badge_image'
									}}
								{% endif %}
								{% if section.settings.badege_text != blank %}
									<span
										class="banner-slider__badge_text extra-small-font"
										style="color: {{ section.settings.badge_text_color }}"
									>
										{{
											section.settings.badege_text
											| strip_html
											| truncate: 25
										}}
									</span>
								{% endif %}
							</div>
						{% endif %}
						<div class="featured_collection__content {% if section.settings.position == 'bottom' %} text-bottom {% endif %}">
							<div class="featured_collection-content_aligment">
								{%- if section.settings.heading_collection != blank -%}
									<h2 class="featured_collection__heading h2 {% if section.settings.description_collection == blank %} without-mb {% endif %}">
										{{ section.settings.heading_collection }}
									</h2>
								{%- endif -%}
								{%- if section.settings.description_collection != blank -%}
									<div class="featured-header__desc richtext__content">
										{{ section.settings.description_collection }}
									</div>
								{% endif %}
							</div>
						</div>
						<div class="featured_collection-buttons-box">
							{%- if section.settings.button_label_collection != blank -%}
								<div class="featured_collection_btn">
									{% render 'button',
										btn_animation: settings.button_animation,
										btn_style: section.settings.button_style_collection,
										btn_label: section.settings.button_label_collection,
										btn_link: section.settings.button_link_collection
									%}
								</div>
							{%- endif -%}
						</div>
					</div>
				</div>
			</div>
			<div class="featured_collection_swiper-list">
				{%- if section.settings.collection.products != blank -%}
					<div class="swiper">
						<div class="swiper-wrapper">
							{%- for product in section.settings.collection.products
								limit: 12
							-%}
								<div class="featured_collection__cards  swiper-slide ">
									{% render 'product-card',
										product_card_product: product,
										media_size: section.settings.image_ratio,
										media_fit: section.settings.image_fit,
										show_secondary_image: section.settings.show_secondary_image,
										show_vendor: section.settings.show_vendor,
										show_collection_name: section.settings.show_collection_name,
										show_inventory: section.settings.show_inventory,
										show_color_swatch: section.settings.show_color_swatch,
										show_desc: section.settings.show_desc,
										section_id: section.id,
										add_id: forloop.index,
										show_sku: section.settings.show_sku
									%}
								</div>
							{%- else -%}
								{%- for i in (1..5) -%}
									<div class="products-slider__slide swiper-slide">
										<div class="featured_collection__cards">
											{% render 'product-card-placeholder',
												media_size: media_size
											%}
										</div>
									</div>
								{% endfor %}
							{% endfor %}
						</div>
					</div>
					{% if show_arrows %}
						<button class="swiper-button swiper-button-prev swiper-button-disabled">
							{%- render 'icon-swiper-next' -%}
						</button>
						<button class="swiper-button swiper-button-next">
							{%- render 'icon-swiper-next' -%}
						</button>
					{% endif %}
					<div
						class="swiper-pagination swiper-pagination-1 swiper-pagination-default {% if section.settings.enable_autoplay == false %} not-autoplay{% else %} bullet-autoplay{% endif %}"
					></div>
				{%- else -%}
					<div class="swiper">
						<div class="swiper-wrapper">
							{%- for product in section.settings.product_list -%}
								<div class="featured_collection__cards swiper-slide ">
									{% render 'product-card',
										product_card_product: product,
										media_size: section.settings.image_ratio,
										media_fit: section.settings.image_fit,
										show_secondary_image: section.settings.show_secondary_image,
										show_vendor: section.settings.show_vendor,
										show_collection_name: section.settings.show_collection_name,
										show_color_swatch: section.settings.show_color_swatch,
										show_desc: section.settings.show_desc,
										show_inventory: section.settings.show_inventory,
										section_id: section.id,
										add_id: forloop.index,
										show_sku: section.settings.show_sku
									%}
								</div>
							{%- else -%}
								{%- for i in (1..5) -%}
									{% assign placeholder_count = forloop.index
										| modulo: 4
										| plus: 1
									%}
									<div class="products-slider__slide swiper-slide">
										<div class="featured_collection__cards">
											{% render 'product-card-placeholder',
												media_size: media_size,
												placeholder_index: placeholder_count
											%}
										</div>
									</div>
								{% endfor %}
							{% endfor %}
						</div>
					</div>
					{% if show_arrows %}
						<button class="swiper-button swiper-button-prev swiper-button-disabled">
							{%- render 'icon-swiper-next' -%}
						</button>
						<button class="swiper-button swiper-button-next">
							{%- render 'icon-swiper-next' -%}
						</button>
					{% endif %}
					<div
						class="swiper-pagination swiper-pagination-1 swiper-pagination-default {% if section.settings.enable_autoplay == false %} not-autoplay{% else %} bullet-autoplay{% endif %}"
					></div>
				{%- endif -%}
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.featured_collection.name",
	"tag": "section",
	"class": "spaced-section section-featured-collection",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Collection Intro",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h3",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__2.label"
				}
			],
			"default": "h3",
			"label": "t:sections.all.heading_size.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header.content"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Shop Now",
			"label": "t:sections.all.button.label.label",
			"info": "t:sections.all.button.label.info"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:sections.all.button.link.label"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.style.options__2.label"
				},
				{
					"value": "tertiary",
					"label": "t:sections.all.button.style.options__3.label"
				}
			],
			"default": "tertiary",
			"label": "t:sections.all.button.style.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured_collection.header"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:sections.all.image.label"
		},
		{
			"type": "video",
			"id": "video",
			"label": "t:sections.all.video.video.label",
			"info": "t:sections.all.video.video.info"
		},
		{
			"type": "range",
			"id": "overlay_opacity",
			"min": 0,
			"max": 100,
			"default": 20,
			"unit": "%",
			"label": "t:sections.all.overlay_opacity.label"
		},
		{
			"type": "text",
			"id": "heading_collection",
			"default": "Intro to featured collections",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "text",
			"id": "description_collection",
			"default": "Overview of Collections",
			"label": "t:sections.all.text.label"
		},
		{
			"type": "select",
			"id": "position",
			"options": [
				{
					"value": "top",
					"label": "t:sections.overlay-group.all.settings.position.options__2.label"
				},
				{
					"value": "bottom",
					"label": "t:sections.overlay-group.all.settings.position.options__8.label"
				}
			],
			"default": "top",
			"label": "t:sections.overlay-group.all.settings.position.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-2",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "header",
			"content": "t:sections.banner-slider.blocks.column.settings.header__1.label"
		},
		{
			"type": "color",
			"id": "badge_bg_color",
			"label": "t:sections.all.background_color.label",
			"default": "#FC3535"
		},
		{
			"type": "color",
			"id": "badge_text_color",
			"label": "t:sections.banner-slider.blocks.column.settings.badge_text_color.label",
			"default": "#FFFFFF"
		},
		{
			"type": "text",
			"id": "badege_text",
			"default": "Sale",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "image_picker",
			"id": "badge_image",
			"label": "t:sections.all.icon_pack.label"
		},
		{
			"type": "header",
			"content": "t:sections.featured_collection.button"
		},
		{
			"type": "text",
			"id": "button_label_collection",
			"default": "Learn More",
			"label": "t:sections.all.button.label.label",
			"info": "t:sections.all.button.label.info"
		},
		{
			"type": "url",
			"id": "button_link_collection",
			"label": "t:sections.all.button.link.label"
		},
		{
			"type": "select",
			"id": "button_style_collection",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.style.options__2.label"
				},
				{
					"value": "tertiary",
					"label": "t:sections.all.button.style.options__3.label"
				}
			],
			"default": "primary",
			"label": "t:sections.all.button.style.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.slider_options.header.content"
		},
		{
			"type": "checkbox",
			"id": "is_autoplay",
			"default": false,
			"label": "t:sections.all.slider_options.slider_is_autoplay.label"
		},
		{
			"type": "checkbox",
			"id": "stop_autoplay",
			"default": true,
			"label": "t:sections.all.slider_options.slider_hover_autoplay_stop.label"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "t:sections.all.slider_options.navigation.label"
		},

		{
			"type": "checkbox",
			"id": "disable_slider",
			"default": true,
			"label": "t:sections.featured_collection.settings.disable_slider.label"
		},
		{
			"type": "range",
			"id": "slideshow_speed",
			"min": 0.1,
			"max": 6,
			"step": 0.1,
			"default": 1.1,
			"unit": "s",
			"label": "t:sections.all.slider_options.speed.label"
		},
		{
			"type": "range",
			"id": "slideshow_delay",
			"min": 0.1,
			"max": 8,
			"step": 0.1,
			"default": 3,
			"unit": "s",
			"label": "t:sections.all.slider_options.delay.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.product_card.header.content"
		},
		{
			"type": "collection",
			"id": "collection",
			"label": "Collection",
			"info": "t:sections.featured_collection.collection.info"
		},
		{
			"type": "product_list",
			"id": "product_list",
			"limit": 12,
			"label": "t:sections.all.product_card.product_list.label"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "landscape",
					"label": "t:sections.all.image.ratio.options__1.label"
				},
				{
					"value": "portrait",
					"label": "t:sections.all.image.ratio.options__2.label"
				},
				{
					"value": "square",
					"label": "t:sections.all.image.ratio.options__3.label"
				}
			],
			"default": "portrait",
			"label": "t:sections.all.image.ratio.full_label"
		},
		{
			"type": "select",
			"id": "image_fit",
			"label": "t:sections.all.image.fit.label",
			"default": "cover",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.image.fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.image.fit.options__2.label"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "show_two_cards",
			"default": true,
			"label": "t:sections.all.product_card.mobile_card_count.label"
		},
		{
			"type": "checkbox",
			"id": "show_secondary_image",
			"default": true,
			"label": "t:sections.products-grid.settings.show_secondary_image.label"
		},
		{
			"type": "checkbox",
			"id": "show_sku",
			"default": false,
			"label": "t:sections.all.sku.show_sku"
		},
		{
			"type": "checkbox",
			"id": "show_vendor",
			"default": false,
			"label": "t:sections.all.product_card.show_vendor.label"
		},
		{
			"type": "checkbox",
			"id": "show_collection_name",
			"default": true,
			"label": "t:sections.all.product_card.show_colection_name.label"
		},
		{
			"type": "checkbox",
			"id": "show_color_swatch",
			"default": false,
			"label": "t:sections.all.product_card.show_color.label"
		},
		{
			"type": "checkbox",
			"id": "show_inventory",
			"default": true,
			"label": "t:sections.all.product_card.show_inventory.label"
		},
		{
			"type": "checkbox",
			"id": "show_desc",
			"default": false,
			"label": "t:sections.all.product_card.show_description.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "l",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.featured_collection.presets.name"
		}
	]
}
{% endschema %}
