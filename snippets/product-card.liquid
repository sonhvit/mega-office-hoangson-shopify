{% comment %}
		Renders a product card
		Accepts:
		- product_card_product: {Object} Product Liquid object (optional)
		- media_size: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
		- show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
		- show_vendor: {Boolean} Show the product vendor. Default: true
		- show_desc: {Boolean} Show the product vendor. Default: false
		- section_id: {String} The ID of the section that contains this card.
		- show_sku: {Boolean} Show sku. Default: false
		Usage:
	{% render 'product-card', show_vendor: section.settings.show_vendor %}
{% endcomment %}
<link
	rel="preload"
	href="{{ 'component-badge.css' | asset_url }}"
	as="style"
	onload="this.onload=null;this.rel='stylesheet'"
>

{%- if settings.quickview_button_type != 'none' -%}
	<link
		rel="stylesheet"
		href="{{ 'component-deferred-media.css' | asset_url }}"
		media="all"
	>
	<link
		rel="preload"
		href="{{ 'quick-add.css' | asset_url }}"
		as="style"
		onload="this.onload=null;this.rel='stylesheet'"
	>
	{%- assign first_3d_model = product_card_product.media
		| where: 'media_type', 'model'
		| first
	-%}
	{%- if first_3d_model -%}
		{{ 'component-product-model.css' | asset_url | stylesheet_tag }}
		<link
			id="ModelViewerStyle"
			rel="stylesheet"
			href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
			media="print"
			onload="this.media='all'"
		>
		<link
			id="ModelViewerOverride"
			rel="stylesheet"
			href="{{ 'component-model-viewer-ui.css' | asset_url }}"
			media="print"
			onload="this.media='all'"
		>
	{%- endif -%}
	{%- if first_3d_model -%}
		<script type="application/json" id="ProductJSON-{{ product.id }}">
			{{ product_card_product.media | where: 'media_type', 'model' | json }}
		</script>
		<script src="{{ 'product-model.js' | asset_url }}" defer></script>
	{%- endif -%}
{%- endif -%}

<link
	rel="preload"
	href="{{ 'section-main-product.css' | asset_url }}"
	as="style"
	onload="this.onload=null;this.rel='stylesheet'"
>
{% liquid
	case media_size
		when 'landscape'
			assign image_size = '70%'
		when 'portrait'
			assign image_size = '130%'
		when 'square'
			assign image_size = '100%'
		else
			assign image_size = '130%'
	endcase

	if media_fit == blank
		assign imgae_fit = 'cover'
	else
		assign imgae_fit = media_fit
	endif
%}

{%- assign product_form_id = 'quick-add-'
	| append: section_id
	| append: product_card_product.id
-%}
<div
	class="product-card card-wrapper js-animation-card js-color-swatches-wrapper {% if settings.quickview_hover %}quickview--hover{% endif %}"
	data-product="{{ product_card_product.handle }} "
	id="myCardId"
>
	<span class="visually-hidden">{{ product_card_product.title | escape }}</span>
	<div
		class="card card--product {% if product_card_product.media[1] != null %}  {% endif %}"
		tabindex="-1"
	>
		<div class="card__inner full-unstyled-link">
			{%- liquid
				assign featured_media_aspect_ratio = product_card_product.featured_media.aspect_ratio

				if product_card_product.featured_media.aspect_ratio == null
					assign featured_media_aspect_ratio = 1
				endif
			-%}
			{% if settings.on_hover == 'slider' %}
			{%- else -%}
				<a
					href="{{ product_card_product.url | default: '#' }}"
					class="media media--hover-effect js-color-swatches-link"
					aria-label="{{ "accessibility.product_link" | t }}"
					style="padding-bottom: {{ image_size }};"
				>
					{%- if product_card_product.featured_media -%}
						{%- if product_card_product.featured_media.media_type == 'video' -%}
							<div class="product__media product__deferred_media">
								<card-deferred-media
									class="deferred-media card-deferred-media media no-js-hidden"
									style="padding-bottom: {{ 1 | divided_by: product_card_product.featured_media.preview_image.aspect_ratio | times: 100 }}%;"
									data-media-id="{{ product_card_product.featured_media.id }}"
								>
									{% assign image_height = product_card_product.featured_media.preview_image
										| divided_by: product_card_product.featured_media.preview_image.aspect_ratio
									%}
									{{
										product_card_product.featured_media.preview_image
										| image_url: width: 3840
										| image_tag:
											loading: 'lazy',
											width: product_card_product.featured_media.preview_image.width,
											height: image_height,
											sizes: '100vw, (min-width: 1023px) 50vw',
											widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
									}}
									<template>
										{%- liquid
											case product_card_product.featured_media.media_type
												when 'external_video'
													assign video_class = 'js-' | append: product_card_product.featured_media.host
													if product_card_product.featured_media.host == 'youtube'
														echo product_card_product.featured_media | external_video_url: autoplay: true, muted: true, loop: true, controls: false, playlist: product_card_product.featured_media.external_id | external_video_tag: class: video_class, loading: 'lazy'
													else
														echo product_card_product.featured_media | external_video_url: autoplay: true, muted: true, controls: false, loop: true | external_video_tag: class: video_class, loading: 'lazy'
													endif
												when 'video'
													echo product_card_product.featured_media | media_tag: image_size: '2048x', autoplay: true, controls: false, loop: true, preload: 'none', muted: true, class: 'data-alt'
											endcase
										-%}
									</template>
								</card-deferred-media>
							</div>
							{%- if product_card_product.media[1] != null
								and show_secondary_image
							-%}
								{%- capture style -%}
										object-position: {{ product_card_product.media[1].presentation.focal_point }};
										object-fit : {{ imgae_fit }};
									{%- endcapture -%}
								{{
									product_card_product.media[1]
									| image_url: width: 1920
									| image_tag:
										loading: 'lazy',
										width: product_card_product.media[1].width,
										height: image_height,
										sizes: '(max-width: 576px) 100vw, (max-width: 1150px) 50vw, 100vw',
										widths: '375, 550, 750, 1100, 1500, 1700, 1900',
										class: 'motion-reduce media--second',
										style: style
								}}
							{%- endif -%}
						{%- else -%}
							{%- capture style -%}
								object-position: {{ product_card_product.featured_media.presentation.focal_point }};
								object-fit : {{ imgae_fit }};
							{%- endcapture -%}
							{{
								product_card_product.featured_media
								| image_url: width: 1920
								| image_tag:
									loading: 'lazy',
									width: product_card_product.featured_media.width,
									height: image_height,
									sizes: '(max-width: 576px) 100vw, (max-width: 1150px) 50vw, 100vw',
									widths: '375, 550, 750, 1100, 1500, 1700, 1900',
									class: 'motion-reduce media--first',
									style: style
							}}
							{%- if product_card_product.media[1] != null
								and show_secondary_image
							-%}
								{%- if product_card_product.media[1].media_type == 'video' -%}
									<div class="product__media product__deferred_media">
										<card-deferred-media
											class="deferred-media card-deferred-media media no-js-hidden"
											style="padding-bottom: {{ 1 | divided_by: product_card_product.media[1].preview_image.aspect_ratio | times: 100 }}%;"
											data-media-id="{{ product_card_product.featured_media.id }}"
										>
											{% assign image_height = product_card_product.media[1].preview_image
												| divided_by: product_card_product.media[1].preview_image.aspect_ratio
											%}
											{{
												product_card_product.media[1].preview_image
												| image_url: width: 3840
												| image_tag:
													loading: 'lazy',
													width: product_card_product.media[1].preview_image.width,
													height: image_height,
													sizes: '100vw, (min-width: 1023px) 50vw',
													widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
											}}
											<template>
												{%- liquid
													case product_card_product.media[1].media_type
														when 'external_video'
															assign video_class = 'js-' | append: product_card_product.media[1].host
															if product_card_product.media[1].host == 'youtube'
																echo product_card_product.media[1] | external_video_url: autoplay: true, muted: true, loop: true, controls: false, playlist: product_card_product.media[1].external_id | external_video_tag: class: video_class, loading: 'lazy'
															else
																echo product_card_product.media[1] | external_video_url: autoplay: true, muted: true, controls: false, loop: true | external_video_tag: class: video_class, loading: 'lazy'
															endif
														when 'video'
															echo product_card_product.media[1] | media_tag: image_size: '2048x', autoplay: true, controls: false, loop: true, preload: 'none', muted: true, class: 'data-alt'
													endcase
												-%}
											</template>
										</card-deferred-media>
									</div>
								{%- else -%}
									{%- capture style -%}
											object-position: {{ product_card_product.media[1].presentation.focal_point }};
											object-fit : {{ imgae_fit }};
										{%- endcapture -%}
									{{
										product_card_product.media[1]
										| image_url: width: 1920
										| image_tag:
											loading: 'lazy',
											width: product_card_product.media[1].width,
											height: image_height,
											sizes: '(max-width: 576px) 100vw, (max-width: 1150px) 50vw, 100vw',
											widths: '375, 550, 750, 1100, 1500, 1700, 1900',
											class: 'motion-reduce media--second',
											style: style
									}}
								{%- endif -%}
							{%- endif -%}
						{%- endif -%}
					{%- else -%}
						{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
					{%- endif -%}
				</a>

			

			{%- endif -%}
		</div>
		<div class="quick-add-media no-js-hidden {% if settings.show_on_mobile == false %}mobile-hide{% endif %}">
			<modal-opener data-modal="#QuickAdd-{{ product_card_product.id }}">
				<button
					id="{{ product_form_id }}-submit"
					type="submit"
					name="add"
					class=" button button--primary card__link--{{ settings.quickview_button_layout }} {%- if settings.show_on_mobile == false -%}mobile-hide{%- endif -%} card-focused{% if settings.quickview_button_style == 'link' %} button--primary{% endif %}"
					aria-haspopup="dialog"
					aria-label="quick-view-button"
					aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
					data-product-url="{{ product_card_product.url }}"
				>
					{% if settings.quickview_button_style == 'link' %}
						{% render 'icon-eye' %}
					{% else %}
						<span class="card__quickview-text">
							{% render 'icon-basket' %}
						</span>
					{% endif %}
					<b class="loading-overlay__spinner hidden">
						<svg
							aria-hidden="true"
							focusable="false"
							role="presentation"
							class="spinner"
							viewBox="0 0 66 66"
							xmlns="http://www.w3.org/2000/svg"
						>
							<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
						</svg>
					</b>
				</button>
			</modal-opener>
		</div>
		<div class="card__information-top">
			{%- if settings.badge_sale_show
				or settings.badge_soldout_show
				or settings.badge_custom_show
				or product_card_product.metafields.custom.badges != blank
			-%}
				<div class="card__badge">
					{%- if product_card_product.available == false
						and settings.badge_soldout_show
					-%}
					{%- elsif product_card_product.compare_at_price
							> product_card_product.price
						and product_card_product.available
						and settings.badge_sale_show
					-%}
						<span
							class="badge badge--sale {% if settings.badges_background %} badge-transparent {% endif %}"
							aria-hidden="true"
						>
							{% if settings.badge_sale_type == 'sale' %}
								{{- 'products.product.on_sale' | t -}}
							{% else %}
								{% comment %}{{- 'products.product.on_sale' | t -}}{% endcomment %}
								-
								<span>
									{{
										product_card_product.compare_at_price
										| minus: product_card_product.price
										| times: 100
										| divided_by: product_card_product.compare_at_price
									-}}
									%
								</span>
							{% endif %}
						</span>
					{%- endif -%}

					
						{% if settings.badge_custom_show
							and product_card_product.metafields.custom.badges != blank
						%}
							{% if product_card_product.metafields.custom.badges.list? %}
								{% for badge in product_card_product.metafields.custom.badges.value %}

									<span
										class="badge badge--custom color-{{ settings.badge_custom_color_scheme }}"
										aria-hidden="true"
									>
										{{ badge }}
									</span>
								{% endfor %}
							{% else %}
								<span
									class="badge badge--custom color-{{ settings.badge_custom_color_scheme }}"
									aria-hidden="true"
								>

									{{ product_card_product.metafields.custom.badges }}
								</span>
							{% endif %}
						{% endif %}
					<div class="badge-list">
						{%- assign badge = product_card_product.metafields.custom.product_badges.value -%}

						{% if badge %}
							<div
								class="badge"
								style="background-color: {{ badge.color_background }}; color: {{ badge.color_text }};"
							>
								{% if badge.icon != blank %}
									<img
										src="{{ badge.icon | file_url }}"
										alt="{{ badge.text }}"
										class="badge-icon"
										height="16px"
										width="16px"
									>
								{% endif %}
								<span>{{ badge.text }}</span>
							</div>
						{% endif %}
					</div>
				</div>
			{%- endif -%}
		</div>
	</div>
	<div class="card-information-box card-content">
		<div class="card-information">
			<div class="card-information__wrapper">
				{%- if show_sku
					and product_card_product.selected_or_first_available_variant.sku.size
						> 0
				-%}
					<p
						class="card__sku subtitle no-js-hidden"
						id="Sku-{{ section.id }}"
						role="status"
						{{ block.shopify_attributes }}
					>
						<span class="visually-hidden">
							{{- 'products.product.sku' | t }}:</span
						>
						{{- product_card_product.selected_or_first_available_variant.sku -}}
					</p>
				{%- endif -%}
				{%- if show_vendor -%}
					<span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
					{% if settings.enable_vendor_link %}
						<a
							href="{{ product_card_product.vendor | url_for_vendor }}"
							class="vendor-link subtitle card_title_font"
						>
							{{ product_card_product.vendor }}
						</a>
					{% else %}
						<div class="subtitle card_title_font">
							{{ product_card_product.vendor }}
						</div>
					{%- endif -%}
				{%- endif -%}
				{%- if show_collection_name -%}
					{%- for collection in product_card_product.collections limit: 1 -%}
						<a
							href="{{ collection.url }}"
							class="card__collection-title subtitle card_title_font unstyled-link"
						>
							{{- collection.title | escape -}}
						</a>
					{%- endfor -%}
				{%- endif -%}
				{%- for custom_list in product_card_product.metafields -%}
					{{ custom_list.value }}
				{%- endfor -%}
				<div class="card-information-block">
					{% comment %}{{ product_card_product.metafields.custom.tasting_notes.value }}{% endcomment %}
					<h3 id="title-{{ section_id }}-{{ product_card_product.id }}" class="card__title">
						<a
							class="unstyled-link "
							href="{{ product_card_product.url | default: '#' }}"
							title="{{ product_card_product.title | escape }}"
						>
							{{ product_card_product.title | escape -}}
						</a>
					</h3>
					{% render 'price', product: product_card_product, price_class: '' %}
				</div>

				{%- if product_card_product != blank -%}
					{%- unless product_card_product.has_only_default_variant -%}
						{% if show_color_swatch %}
							<div class="card-type__hover">
								<div class="product-parameters {% if product_variant_type == "image" %} product-parameters-img {% endif %} no-js-hidden">
									{%- for option in product_card_product.options_with_values -%}
										{% liquid
											assign color_trigger = settings.trigger_swatch | strip | newline_to_br | split: '<br />'
											assign name_option = option.name | handle | strip
											assign is_color_option = false

											if settings.color_swatch
												for item in color_trigger
													assign item_temp = item | handle | strip
													if name_option == item_temp
														assign is_color_option = true
													endif
												endfor

												for value in option.values
													if value.swatch.color != blank
														assign is_color_option = true
													endif
												endfor
											endif
										%}
										{% if is_color_option %}
											<div class="product-form__controls js-color-swatches">
												<div class="product-form__controls-group {% if product_variant_type == "image" %} product_variant-img {% endif %}">
													{% render 'product-variant-options',
														product: product_card_product,
														option: option,
														product_variant_type: product_variant_type,
														show_color_swatch: is_color_option
													%}
												</div>
											</div>
										{% endif %}
									{%- endfor -%}

								</div>
							</div>
						{% endif %}
					{% endunless %}
				{%- endif -%}

				{% if show_inventory %}
					<div class="product__inventory">
						{% if product_card_product.selected_or_first_available_variant.inventory_management == blank %}
							<div class="product__inventory-inner bold">
								<span class="card__inventory_dot"></span>
								{% comment %} Check available {% endcomment %}
								{{ 'general.card.in_stock' | t }}
							</div>
						{% else %}
							<div class="product__inventory-inner product__inventory-inner--{% if product_card_product.selected_or_first_available_variant.inventory_quantity > 0 and product_card_product.selected_or_first_available_variant.inventory_quantity < 10 %}error{% elsif product_card_product.selected_or_first_available_variant.inventory_quantity == 0 %}empty{% endif %} bold">
								{% if product_card_product.selected_or_first_available_variant.inventory_quantity
										>= 10
								%}
									<span class="card__inventory_dot"></span>
									{{
										'general.card.in_stock'
										| t:
											quantity: product_card_product.selected_or_first_available_variant.inventory_quantity
									}}
								{% elsif product_card_product.selected_or_first_available_variant.inventory_quantity
										> 0
									and product_card_product.selected_or_first_available_variant.inventory_quantity
										< 10
								%}
									<div class="card__inventory_quantity">
										<span class="card__inventory_dot"></span>
										{{
											'products.product.quantity.last_items'
											| t:
												quantity: product_card_product.selected_or_first_available_variant.inventory_quantity
										}}
									</div>
								{% elsif product_card_product.selected_or_first_available_variant.inventory_quantity
										== 0
								%}
									<div class="card__inventory_soldout">
										<span class="card__inventory_dot"></span>
										{{ 'products.product.sold_out' | t }}
									</div>
								{% endif %}
							</div>
						{% endif %}
					</div>
				{% endif %}
				{%- if show_desc and product_card_product.description != blank -%}
					{{ product_card_product.collections.title }}
					<div class="card__description subtitle">
						{{ product_card_product.description | strip_html | truncate: 80 }}
					</div>
				{%- endif -%}
			</div>
			<a
				class="product_card_product-link "
				href="{{ product_card_product.url | default: '#' }}"
				title="{{ product_card_product.title | escape }}"
			>
			</a>
		</div>
		{% if quick_btn_hidden != true %}
			{%- if settings.quickview_button_type != 'none' -%}
				<div class="card-buttons {% if settings.show_on_mobile -%}card__link-buttun--show{%- endif %}">
					{%- if settings.quickview_button_type == 'quick-buy' -%}
						{% if product_card_product.selected_or_first_available_variant.available
							and product_card_product.has_only_default_variant
							or product_card_product.options.size == 1
							and product_card_product.options[0] == settings.trigger_swatch
						%}
							<product-form class="card__add-to-cart card__button {% if settings.show_on_mobile == false %}mobile-hide{% endif %}" data-source="{{ section_id }}">
								{%- form 'product',
									product_card_product,
									id: product_form_id,
									class: 'form',
									novalidate: 'novalidate',
									data-type: 'add-to-cart-form'
								-%}
									<input
										type="hidden"
										name="id"
										value="{{ product_card_product.selected_or_first_available_variant.id }}"
										disabled
									>
									<button
										id="{{ product_form_id }}-submit"
										type="submit"
										class="card__link button button--primary button--small card__link--{{ settings.quickview_button_layout }} card-focused {% if settings.quickview_button_style == 'link' %} button--primary{% endif %}"
										name="add"
										aria-haspopup="dialog"
										aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
										aria-live="polite"
										aria-label="quick-add"
										data-sold-out-message="true"
										{% if product_card_product.selected_or_first_available_variant.available
												== false
										%}
											disabled
										{% endif %}
									>
										<span class="card__quickview-text button-label">
											{{- 'general.card.quick__add' | t -}}
										</span>
										<span class="sold-out-message hidden">
											{{ 'products.product.sold_out' | t }}
										</span>
										<b class="loading-overlay__spinner hidden">
											<svg
												aria-hidden="true"
												focusable="false"
												role="presentation"
												class="spinner"
												viewBox="0 0 66 66"
												xmlns="http://www.w3.org/2000/svg"
											>
												<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
											</svg>
										</b>
									</button>
								{%- endform -%}
							</product-form>
						{%- else -%}
							<div class="quick-add no-js-hidden">
								<modal-opener data-modal="#QuickAdd-{{ product_card_product.id }}">
									<button
										id="{{ product_form_id }}-submit"
										type="submit"
										name="add"
										class="card__link button button--{{ settings.quickview_button_style }} button--small card__link--{{ settings.quickview_button_layout }} {% if settings.show_on_mobile == false %} mobile-hide {% endif %} card-focused{% if settings.quickview_button_style == 'link' %} button--primary{% endif %}"
										aria-haspopup="dialog"
										aria-label="quick-view-button"
										aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
										data-product-url="{{ product_card_product.url }}"
										data-modal-open="QuickAdd-{{ product_card_product.id }}"
									>
										<span class="card__quickview-text button-label">
											{{- 'general.card.choose_options' | t -}}
										</span>
										<b class="loading-overlay__spinner hidden">
											<svg
												aria-hidden="true"
												focusable="false"
												role="presentation"
												class="spinner"
												viewBox="0 0 66 66"
												xmlns="http://www.w3.org/2000/svg"
											>
												<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
											</svg>
										</b>
									</button>
								</modal-opener>
								<quick-add-modal
									id="QuickAdd-{{ product_card_product.id }}"
									class="quick-add-modal"
								>
									<div
										role="dialog"
										aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}"
										aria-modal="true"
										class="quick-add-modal__content global-settings-popup"
										tabindex="-1"
									>
										{% comment %}
											<div class="quick-add-modal_top">
												<h4 class="quick-add-modal__title">
													{{ 'general.card.quick__view' | t }}
												</h4>

											</div>
										{% endcomment %}
										<button
											id="ModalClose-{{ product_card_product.id }}"
											type="button"
											class="quick-add-modal__toggle button button--small button--secondary"
											aria-label="{{ 'accessibility.close' | t }}"
										>
											{% comment %}{% render 'icon-close' %}{% endcomment %}
											{% render 'icon-close' %}
										</button>
										<div class="quick-add-modal__content-wrapper">
											<div
												id="QuickAddInfo-{{ product_card_product.id }}"
												class="quick-add-modal__content-info"
											></div>
										</div>
									</div>
									<div
										id="ModalClose-Overlay"
										class="modal__overlay"
									></div>
								</quick-add-modal>
							</div>
						{% endif %}
					{%- endif -%}

					{%- if settings.add_to_cart_enabled
						and product_card_product.selected_or_first_available_variant.available
						and product_card_product.has_only_default_variant
						or product_card_product.options.size == 1
						and settings.color_swatch
						and product_card_product.options[0] == settings.trigger_swatch
					-%}
						{%- assign product_form_id = 'quick-add-'
							| append: section_id
							| append: product_card_product.id
						-%}
						<product-form class="card__add-to-cart card__button" data-source="{{ section_id }}">
							{%- form 'product',
								product_card_product,
								id: product_form_id,
								class: 'form',
								novalidate: 'novalidate',
								data-type: 'add-to-cart-form'
							-%}
								<input
									type="hidden"
									name="id"
									value="{{ product_card_product.selected_or_first_available_variant.id }}"
									disabled
								>
								<button
									id="{{ product_form_id }}-submit"
									type="submit"
									class="
										card__link button
										button--primary
										card__link--{{ settings.quickview_button_layout }}
										{% if settings.show_on_mobile -%}card__link--show{%- endif %}
										card-focused
									"
									name="add"
									aria-haspopup="dialog"
									aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
									aria-live="polite"
									data-sold-out-message="true"
									{% if product_card_product.selected_or_first_available_variant.available
											== false
									%}
										disabled
									{% endif %}
									aria-label="{{- 'general.card.quick__add' | t -}}"
								>
									<span class="card__quickview-text">
										{{- 'general.card.quick__add' | t -}}
									</span>
									<span class="sold-out-message hidden">
										{{ 'products.product.sold_out' | t }}
									</span>
									<div class="loading-overlay__spinner hidden">
										<svg
											aria-hidden="true"
											focusable="false"
											role="presentation"
											class="spinner"
											viewBox="0 0 66 66"
											xmlns="http://www.w3.org/2000/svg"
										>
											<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
										</svg>
									</div>
								</button>
							{%- endform -%}
						</product-form>
					{%- endif -%}
					{%- if settings.quickview_show -%}
						<div class="quick-add no-js-hidden">
							{%- assign product_form_id = 'quick-add-'
								| append: section_id
								| append: product_card_product.id
							-%}
							<modal-opener data-modal="#QuickAdd-{{ product_card_product.id }}">
								<button
									id="{{ product_form_id }}-submit"
									type="submit"
									name="add"
									class="
										card__link button
										{% if add_to_cart %} button--secondary {% else %} button--primary {% endif %}
										button--{{ settings.quickview_button_style }} card__link--{{ settings.quickview_button_layout }}
										{%- if settings.show_on_mobile -%}card__link--show{%- endif %}
										card-focused
									"
									aria-haspopup="dialog"
									aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
									data-product-url="{{ product_card_product.url }}"
								>
									<span class="card__quickview-text">
										{{- 'general.card.quick__view' | t -}}
									</span>
									<div class="loading-overlay__spinner hidden">
										<svg
											aria-hidden="true"
											focusable="false"
											role="presentation"
											class="spinner"
											viewBox="0 0 66 66"
											xmlns="http://www.w3.org/2000/svg"
										>
											<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
										</svg>
									</div>
								</button>
							</modal-opener>
							<quick-add-modal
								id="QuickAdd-{{ product_card_product.id }}"
								class="quick-add-modal"
							>
								<div
									role="dialog"
									aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}"
									aria-modal="true"
									class="quick-add-modal__content global-settings-popup"
									tabindex="-1"
								>
									<button
										id="ModalClose-{{ product_card_product.id }}"
										type="button"
										class="quick-add-modal__toggle modal-close-button"
										aria-label="{{ 'accessibility.close' | t }}"
										
									>
										{% render 'icon-close' %}
									</button>
									<div class="quick-add-modal__content-wrapper">
										<div
											id="QuickAddInfo-{{ product_card_product.id }}"
											class="quick-add-modal__content-info"
										></div>
									</div>
								</div>
							</quick-add-modal>
						</div>
					{%- endif -%}
				</div>
			{%- endif -%}
		{% endif %}
	</div>
</div>
