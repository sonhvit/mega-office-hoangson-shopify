{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{%- endstyle -%}
{% liquid
  assign image_size = section.settings.height

  case image_size
    when 'square'
      assign section_size = '100%'
      assign slide_class = image_size
    when 'landscape'
      assign section_size = '56.25%'
      assign slide_class = image_size
    else
      assign section_size = '133%'
      assign slide_class = image_size
  endcase
%}

<div class="customer account order section-{{ section.id }}-padding">
  {% style %}
    #shopify-section-{{ section.id }} {
      --image-height: {{ section_size }};
    }
  {% endstyle %}
  <div class="container">
    <div class="page-header">
      <div class="page-header__inner">
        <div class="customer__top">
          <h1 class="main-page-title page-title title--page h2">
            {{ 'customer.order.title_1' | t }}
            <span>{{ 'customer.order.title_2' | t }}</span>
          </h1>
          <a class="title-link button button--simple button--arrow" href="{{ routes.account_url }}">
            {% render 'icon-button-arrow-right' %}
            <span class="small-font button-label">{{ 'customer.account.return' | t }}</span>
          </a>
        </div>
      </div>
    </div>
    <div class="account__wrapper">
      <div class="account__left">
        <div class="account__order-info">
          <h4 class="account__subtitle h4">{{ 'customer.order.title' | t: name: order.name }}</h4>
          <span class="order_subtitle small-font subtitle--secondary">
            {%- assign order_date = order.created_at | date: '%B %d, %Y' -%}
            {%- assign order_time = order.created_at | date: '%R %p' -%}
            {{ 'customer.order.date_html' | t: date: order_date, time: order_time }}
          </span>

          {%- if order.cancelled -%}
            {%- assign cancelled_at = order.cancelled_at | time_tag: format: 'date_at_time' -%}
            <span>
              {{- 'customer.order.cancelled_html' | t: date: cancelled_at }}
              {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label -}}
            </span>
          {%- endif -%}
        </div>
        <div role="table" class="order-table order-table--details">
          <div class="visually-hidden">{{ 'customer.order.title' | t: name: order.name }}</div>
          <div class="row thead">
            <div id="ColumnProduct">
              <span class="order_subtitle small-font">
                {{ 'customer.order.product' | t }}
              </span>
            </div>
            <div id="ColumnSku">
              <span class="order_subtitle small-font">
                {{ 'customer.order.sku' | t }}
              </span>
            </div>
            <div id="ColumnPrice">
              <span class="order_subtitle small-font">
                {{ 'customer.order.price' | t }}
              </span>
            </div>
            <div id="ColumnQuantity">
              <span class="order_subtitle small-font">
                {{ 'customer.order.quantity' | t }}
              </span>
            </div>
            <div id="ColumnTotal">
              <span class="order_subtitle small-font">
                {{ 'customer.order.total' | t }}
              </span>
            </div>
          </div>

          {%- for line_item in order.line_items -%}
            <div class="row tbody">
              <div id="Row{{ line_item.key }}" data-label="{{ 'customer.order.product' | t }}">
                {%- if line_item.product.featured_media -%}
                  {% liquid
                    assign image_height = line_item.product.featured_media.width | divided_by: line_item.product.featured_media.aspect_ratio
                  %}
                  <div class="order-table-line--image {{ slide_class }}  ">
										<a
											class="order-product__media-wrapper"
											href="{{ line_item.product.url }}"
										>
											{% capture sizes %}
												(min-width: 1100px) 1920px, calc((100vw - 20px))
											{% endcapture %}
											{{
												line_item.product.featured_media
												| image_url: width: line_item.product.featured_media.width
												| image_tag:
													loading: 'lazy',
													sizes: sizes,
													height: image_height,
													width: line_item.product.featured_media.width,
													widths: '360, 535, 720, 956',
													class: 'order-line__image'
											}}
										</a>
                  </div>
                {%- endif -%}
                <div class="product-name">
                  {%- if line_item.product.vendor != blank -%}
                    <p class="product-vendor extra-small-font"> {{ line_item.product.vendor }} </p>
                  {%- endif -%}
                  {%- if line_item.product.url != blank -%}
                    <a href="{{ line_item.product.url }}" class="bold-text order-product-title">{{ line_item.product.title }}</a>
                  {%- else -%}
                    <p class="bold-text">{{ line_item.product.title }}</p>
                  {%- endif -%}

                  <div class="properties">
                    {%- unless line_item.product.has_only_default_variant -%}
                      {%- for option in line_item.options_with_values -%}
                        <span class="extra-small-font">
                          {{- option.name -}}: 
                          {{- option.value -}}
                          {%- if forloop.index != line_item.options_with_values.size -%},{%- endif -%}
                        </span>
                      {%- endfor -%}
                    {%- endunless -%}
                    {%- unless line_item.selling_plan_allocation == null -%}
                      <span>
                        {{ line_item.selling_plan_allocation.selling_plan.name }}
                      </span>
                    {%- endunless -%}
                  </div>

                  {%- if line_item.line_level_discount_allocations != blank -%}
                    <ul
                      role="list"
                      aria-label="{{ 'customer.order.discount' | t }}"
                      class="list-unstyled discounts"
                    >
                      {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                        <li class="discounts__item">
                          {% render 'icon-discount' %}
                          {{- discount_allocation.discount_application.title }} (-
                          {% if settings.currency_code_enabled %}
                            {{- discount_application.amount | money_with_currency -}}
                          {% else %}
                            {{- discount_application.amount | money -}}
                          {% endif %}
                          )
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </div>
              <div data-label="{{ 'customer.order.sku' | t }}">
                {%- if line_item.sku != blank -%}
                  {{ line_item.sku }}
                {%- else -%}
                  –
                {%- endif -%}
              </div>
              <div data-label="{{ 'customer.order.price' | t }}">
                {%- if line_item.original_price != line_item.final_price or line_item.unit_price_measurement -%}
                  <div>
                    {%- if line_item.original_price != line_item.final_price -%}
                      <div>
                        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                      </div>
                      <div>
                        <s>
                          {% if settings.currency_code_enabled %}
                            {{ line_item.original_price | money_with_currency }}
                          {% else %}
                            {{ line_item.original_price | money }}
                          {% endif %}
                        </s>
                      </div>
                      <div>
                        <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                      </div>
                      <div>
                        <span>
                          {% if settings.currency_code_enabled %}
                            {{ line_item.final_price | money_with_currency }}
                          {% else %}
                            {{ line_item.final_price | money }}
                          {% endif %}
                        </span>
                      </div>
                    {%- else -%}
                      <div>
                        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                      </div>
                      <div>
                        {% if settings.currency_code_enabled %}
                          {{ line_item.original_price | money_with_currency }}
                        {% else %}
                          {{ line_item.original_price | money }}
                        {% endif %}
                      </div>
                    {%- endif -%}
                    {%- if line_item.unit_price_measurement -%}
                      <div>
                        <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
                      </div>
                      <div>
                        <span>
                          {%- capture unit_price_separator -%}
														<span aria-hidden="true">/</span>
														<span class="visually-hidden">{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span>
													{%- endcapture -%}
                          {%- capture unit_price_base_unit -%}
														{%- if line_item.unit_price_measurement.reference_value != 1 -%}
															{{- line_item.unit_price_measurement.reference_value -}}
														{%- endif -%}
														{{ line_item.unit_price_measurement.reference_unit }}
													{%- endcapture -%}
                          <span
                            data-unit-price
                          >
                            {% if settings.currency_code_enabled %}
                              {{- line_item.unit_price | money_with_currency -}}
                            {% else %}
                              {{- line_item.unit_price | money -}}
                            {% endif %}
                          </span>
                          {{- unit_price_separator -}}
                          {{- unit_price_base_unit -}}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <span>
                    {% if settings.currency_code_enabled %}
                      {{- line_item.final_price | money_with_currency }}
                    {% else %}
                      {{- line_item.final_price | money }}
                    {% endif %}
                  </span>
                {%- endif -%}
              </div>
              <div data-label="{{ 'customer.order.quantity' | t }}">
                {{ line_item.quantity }}
              </div>
              <div data-label="{{ 'customer.order.total' | t }}">
                {%- if line_item.original_line_price != line_item.final_line_price -%}
                  <div>
                    <div>
                      <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                    </div>
                    <div>
                      <s>
                        {% if settings.currency_code_enabled %}
                          {{- line_item.original_line_price | money_with_currency }}
                        {% else %}
                          {{- line_item.original_line_price | money }}
                        {% endif %}
                      </s>
                    </div>
                    <div>
                      <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                    </div>
                    <div>
                      <span>
                        {% if settings.currency_code_enabled %}
                          {{- line_item.final_line_price | money_with_currency }}
                        {% else %}
                          {{- line_item.final_line_price | money }}
                        {% endif %}
                      </span>
                    </div>
                  </div>
                {%- else -%}
                  {% if settings.currency_code_enabled %}
                    {{ line_item.original_line_price | money_with_currency }}
                  {% else %}
                    {{ line_item.original_line_price | money }}
                  {% endif %}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div role="table" class="order-table order-table--total ">
          <div class="row tbody ">
            <span>{{ 'customer.order.subtotal' | t }}</span>
            <span>
              {% if settings.currency_code_enabled %}
                {{ order.line_items_subtotal_price | money_with_currency }}
              {% else %}
                {{ order.line_items_subtotal_price | money }}
              {% endif %}
            </span>
          </div>
          {% comment %} Shipping {% endcomment %}
          {%- for shipping_method in order.shipping_methods -%}
            <div class="row tbody ">
              <span id="RowShipping">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }}) </span>
              <span data-label="{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})">
                {% if settings.currency_code_enabled %}
                  {{ shipping_method.price | money_with_currency }}
                {% else %}
                  {{ shipping_method.price | money }}
                {% endif %}
              </span>
            </div>
          {%- endfor -%}

          {% comment %} SHIPPING PRICE {% endcomment %}

          {%- if order.shipping_price > 0 -%}
            <div class="row tbody">
              <span id="RowShipping">{{ 'customer.order.shipping' | t }}</span>
              <span data-label="{{ 'customer.order.shipping' | t }}">
                {% if settings.currency_code_enabled %}
                  {{ order.shipping_price | money_with_currency }}
                {% else %}
                  {{ order.shipping_price | money }}
                {% endif %}
              </span>
            </div>
          {%- else -%}
            <div class="row tbody">
              <span id="RowShipping">{{ 'customer.order.shipping' | t }}</span>
              <span data-label="{{ 'customer.order.shipping' | t }}">
                {{ 'customer.orders.shipping_free' | t }}
              </span>
            </div>
          {% endif %}
          {% comment %} Discount {% endcomment %}
          {%- if order.cart_level_discount_applications != blank -%}
            <div class="row tbody  row--discount">
              <span>
                {{ 'customer.order.discount' | t }}
              </span>
              <span class="discount">
                {%- for discount_application in order.cart_level_discount_applications -%}
                  <span class="discount-item">
                    <span class="cart-discount">
                      {% render 'icon-discount' %}
                      {{- discount_application.title -}}
                    </span>
                    <span class="discount-amount">
                      {%- if settings.currency_code_enabled -%}
                        -
                        {{- discount_application.total_allocated_amount | money_with_currency -}}
                      {% else %}
                        -
                        {{- discount_application.total_allocated_amount | money -}}
                      {%- endif -%}
                    </span>
                  </span>
                {%- endfor -%}
              </span>
            </div>
          {%- endif -%}

          {%- for tax_line in order.tax_lines -%}
            <div class="row tbody">
              <span id="RowTax">
                {{- 'customer.order.tax' | t }} ({{ tax_line.title }}
                {{ tax_line.rate | times: 100 }}%)
              </span>
              <span
                data-label="{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)"
              >
                {% if settings.currency_code_enabled %}
                  {{ tax_line.price | money_with_currency }}
                {% else %}
                  {{ tax_line.price | money }}
                {% endif %}
              </span>
            </div>
          {%- endfor -%}
          {%- if order.total_duties -%}
            <div class="row tbody">
              <span id="RowDuties">{{ 'customer.orders.total_duties' | t }}</span>
              <span data-label="{{ 'customer.orders.total_duties' | t }}">
                {% if settings.currency_code_enabled %}
                  {{ order.total_duties | money_with_currency }}
                {% else %}
                  {{ order.total_duties | money }}
                {% endif %}
              </span>
            </div>
          {%- endif -%}
          {%- if order.total_refunded_amount > 0 -%}
            <div class="row tbody">
              <span id="RowTotalRefund">
                {{ 'customer.orders.total_refunded' | t }}
              </span>
              <span data-label="{{ 'customer.orders.total_refunded' | t }}">
                {% if settings.currency_code_enabled %}
                  {{ order.total_refunded_amount | money_with_currency }}
                {% else %}
                  {{ order.total_refunded_amount | money }}
                {% endif %}
              </span>
            </div>
          {%- endif -%}
          {% comment %} TOTAL {% endcomment %}
          <div class="row tbody bold row-total">
            <span class="h3" id="RowTotal">{{ 'customer.order.total' | t }}</span>
            <span class="h3" data-label="{{ 'customer.order.total' | t }}">
              {% if settings.currency_code_enabled %}
                {{- order.total_net_amount | money_with_currency -}}
              {% else %}
                {{- order.total_net_amount | money -}}
              {% endif %}
            </span>
          </div>
        </div>
      </div>
      <div class="account__right">
        <h4 class="account__subtitle h4">{{ 'customer.addresses.heading' | t }}</h4>

        <div class="account-address">
          {% if order.shipping_address %}
            <div class="account-address__list account-address__default shipping_address">
              <h5 class="account__subtitle h5">
                {{ 'customer.order.payment_status' | t }}: {{ order.financial_status_label }}
              </h5>
              <ul class="list-unstyled">
                {%- if order.shipping_address.name != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.name' | t }}</span>
                    <span>
                      {{ order.shipping_address.name }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.shipping_address.address1 != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.address1' | t }}</span>
                    <span>
                      {{ order.shipping_address.address1 }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.shipping_address.address2 != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.address2' | t }}</span>
                    <span>
                      {{ order.shipping_address.address2 }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.shipping_address.city != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.city' | t }}</span>
                    <span>
                      {{ order.shipping_address.city }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.shipping_address.province != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.province' | t }}</span>
                    <span>
                      {{ order.shipping_address.province }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.shipping_address.zip != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.zip' | t }}</span>
                    <span>
                      {{ order.shipping_address.zip }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.shipping_address.country != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.country' | t }}</span>
                    <span>
                      {{ order.shipping_address.country }}
                    </span>
                  </li>
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
          {% if order.billing_address %}
            <div class="account-address__list account-address__default billing_address ">
              <h3 class="account__subtitle h5">
                {{ 'customer.order.fulfillment_status' | t }}: {{ order.fulfillment_status_label }}
              </h3>
              <ul class="list-unstyled">
                {%- if order.billing_address.name != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.name' | t }}</span>
                    <span>
                      {{ order.billing_address.name }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.billing_address.address1 != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.address1' | t }}</span>
                    <span>
                      {{ order.billing_address.address1 }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.billing_address.address2 != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.address2' | t }}</span>
                    <span>
                      {{ order.billing_address.address2 }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.billing_address.city != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.city' | t }}</span>
                    <span>
                      {{ order.billing_address.city }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.billing_address.province != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.province' | t }}</span>
                    <span>
                      {{ order.billing_address.province }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.billing_address.zip != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.zip' | t }}</span>
                    <span>
                      {{ order.billing_address.zip }}
                    </span>
                  </li>
                {%- endif -%}
                {%- if order.billing_address.country != blank -%}
                  <li class="account-address__item account-address__item-name">
                    <span>{{ 'customer.addresses.country' | t }}</span>
                    <span>
                      {{ order.billing_address.country }}
                    </span>
                  </li>
                {%- endif -%}
              </ul>
            </div>
          {%- else -%}

            <div class="account-none">
              <div class="account-none__wrapper">
                {% render 'icon-account-address-none' %}
                <div class="account-none__content">
                  {%- if section.settings.heading_addresses != blank -%}
                    <h6>{{ section.settings.heading_addresses }}</h6>
                  {%- endif -%}
                  {%- if section.settings.text_addresses != blank -%}
                    <div class="account-none__text">
                      {{ section.settings.text_addresses | escape }}
                    </div>
                  {%- endif -%}
                </div>
                <a
                  href="{{ routes.account_addresses_url }}"
                  class="button button--primary account-none__button focus-inset"
                >
                  {{ 'customer.addresses.add_new' | t }}
                </a>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-order.name",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        }
      ],
      "default": "portrait",
      "label": "t:sections.all.aspect_ratio.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-account.settings.header_2.content"
    },
    {
      "type": "textarea",
      "id": "heading_addresses",
      "default": "Some heading for empty address placeholder",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "textarea",
      "id": "text_addresses",
      "default": "Some text for empty address placeholder",
      "label": "t:sections.all.text.label"
    },

    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
