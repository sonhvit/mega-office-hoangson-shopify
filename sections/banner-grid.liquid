{{ 'section-banner-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'banner-grid.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	.section-{{ section.id }}-padding {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}
	
	@media screen and (min-width: 750px) {
		.section-{{ section.id }}-padding {
			padding-top: {{ section.settings.padding_top_desktop }}px;
			padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
		}
	}
	
	{% if section.settings.layout == 'type_1' %}
		#shopify-section-{{ section.id }} .banner-grid__grid--type_1 > .banner-grid__card:first-of-type .grid-card-copy__details::before {
			padding-bottom: 75.414%;
		}
		
		@media screen and (max-width: 749px) {
			#shopify-section-{{ section.id }} .banner-grid__grid--type_1 > .banner-grid__card:first-of-type .grid-card-copy__details::before {
				padding-bottom: 100%;
			}
			#shopify-section-{{ section.id }} .banner-grid__grid--type_1 > .banner-grid__card:nth-of-type(2)::before {
				padding-bottom: 100%;
			}
			#shopify-section-{{ section.id }} .banner-grid__grid--type_1 > .banner-grid__card:nth-of-type(3)::before {
				padding-bottom: 52.9%;
			}
			#shopify-section-{{ section.id }} .banner-grid__grid--type_1 > .banner-grid__card:nth-of-type(4) .grid-card-horizontal__details::before {
				padding-bottom: 50.3%;
			}
		}
	{% endif %}
	
{%- endstyle -%}

<div class="banner-grid color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
	{% render 'section-header', section: section %}
	<div class="container">
		<div class="content">
			<div class="
					banner-grid__grid banner-grid__grid--{{ section.settings.layout }}
					{% if section.settings.layout == 'columns' %} banner-grid__grid__columns{% endif %}
				">
				{% for block in section.blocks %}
					{%- case block.type -%}
						{%- when 'card_horizontal' -%}
							{% render 'grid-card-horizontal',
								block: block,
								image_size: section.settings.height
							%}
						{%- when 'card_with_ticker' -%}
							{% render 'grid-card-with-ticker',
								block: block,
								image_size: section.settings.height
							%}
						{%- when 'card_small' -%}
							{% render 'grid-card-small',
								block: block,
								image_size: section.settings.height
							%}
						{%- when 'card_with_copy' -%}
							{% render 'grid-card-with-copy',
								block: block,
								image_size: section.settings.height
							%}
					{%- endcase -%}
				{% endfor %}
			</div>
		</div>
	</div>
</div>

