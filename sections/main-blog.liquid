{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card-big.css' | asset_url | stylesheet_tag }}
{{ 'component-blog-aside.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{%- if settings.pagination_type == 'load_more' or settings.pagination_type == 'infinite_scroll' -%}
  <script src="{{ 'load-more.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.enable_featured_posts %}
  <script src="{{ 'main-blog.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- style -%}
  {% render 'section-padding' %}
{%- endstyle -%}

{% liquid
  if section.blocks.size > 0
    assign block = section.blocks[0]
    if block.settings.post_show
      assign blocks_state = true
    endif
  endif
%}

<div class="main-blog section-{{ section.id }}-padding">
  <div class="container">
    <div class="page-header">
      <div class="page-header__inner">
        <h1 class="main-page-title page-title title--page h2">
          {{ blog.title | escape }}
        </h1>
        {% if section.settings.description != blank %}
          <p class="main-page__desc richtext__content">
            {{ section.settings.description }}
          </p>
        {% endif %}
      </div>
    </div>

    <div class="main-blog--content {% if section.blocks[0].settings.post_show == false or section.blocks.size == 0 %} without-sidebar {% endif %}">
      {% if blog.articles_count > 0 %}
        <div>
          {% if section.settings.featured_article %}
            <div class="main-blog__featured-articles">
              <div
                class="article color-background-3"
              >
                {%- for article in blog.articles -%}
                  {% if article.id == section.settings.featured_article.id %}
                    <div>
                      {% render 'article-card',
                        section: section,
                        blog: article,
                        article: article,
                        image_ratio: section.settings.featured_image_ratio,
                        post_heading_size: 'h1',
                        show_image: true,
                        show_tags: section.settings.featured_show_tags,
                        show_date: section.settings.featured_show_date,
                        show_author: section.settings.featured_show_author,
                        show_excerpt: section.settings.featured_show_excerpt,
                        card_variant: 'overlay'
                      %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
          {%- paginate blog.articles by section.settings.posts_per_page -%}
            <div class="main-blog__articles">
              <div class="article main-blog__articles--list load-more-grid">
                {%- for article in blog.articles -%}
                  {% if article.id != section.settings.featured_article.id %}
                    <div>
                      {% render 'article-card',
                        section: section,
                        blog: blog,
                        article: article,
                        image_ratio: section.settings.image_ratio,
                        post_heading_size: 'h3',
                        show_image: section.settings.show_image,
                        show_tags: section.settings.show_tags,
                        show_date: section.settings.show_date,
                        show_author: section.settings.show_author,
                        show_excerpt: section.settings.show_excerpt,
                        card_variant: 'horizontal'
                      %}
                    </div>
                  {% endif %}
                {%- endfor -%}
              </div>
              {%- if paginate.pages > 1 -%}
                {%- if settings.pagination_type == 'load_more' -%}
                  {% render 'load-more',
                    next_url: paginate.next.url,
                    count_pages: paginate.pages,
                    current_page: paginate.current_page
                  %}
                  <div class="js-hidden">
                    {% render 'pagination', paginate: paginate %}
                  </div>
                {%- elsif settings.pagination_type == 'infinite_scroll' -%}
                  {% render 'infinite-scroll',
                    next_url: paginate.next.url,
                    count_pages: paginate.pages,
                    current_page: paginate.current_page
                  %}
                  <div class="js-hidden">
                    {% render 'pagination', paginate: paginate %}
                  </div>
                {% else %}
                  {% render 'pagination', paginate: paginate %}
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endpaginate -%}
        </div>
        {% if section.blocks.size > 0 %}
          <aside
            class="main-blog__aside blog-aside"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.post_show %}
              <div class="blog-aside__posts">
                {% if block.settings.posts_heading != blank %}
                  <h4 class="blog-aside__header">
                    {{ block.settings.posts_heading }}
                  </h4>
                {% endif %}
                {% if block.settings.posts_blog != blank %}
                  <div
                    class="article main-blog__articles--list__small load-more-grid"
                  >
                    {% for article in block.settings.posts_blog.articles limit: 4 %}
                      <div>
                        {% render 'article-card',
                          section: section,
                          blog: blog,
                          article: article,
                          image_ratio: 'square',
                          post_heading_size: 'h5',
                          show_image: true,
                          show_tags: false,
                          show_date: true,
                          show_author: true,
                          show_excerpt: false,
                          card_size: 'small-article',
                          card_variant: 'horizontal'
                        %}
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </aside>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 50,
      "step": 1,
      "default": 13,
      "label": "t:sections.main-blog.settings.posts_per_page.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header__1.content"
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "t:sections.main-blog.settings.featured_article.label"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.all.overlay_opacity.label",
      "info": "t:sections.main-blog.settings.featured_article_opacity_info.label",
      "default": 0.3
    },
    {
      "type": "select",
      "id": "featured_image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.featured-blog.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "featured_show_tags",
      "default": true,
      "label": "t:sections.main-blog.settings.show_tags.label"
    },
    {
      "type": "checkbox",
      "id": "featured_show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "featured_show_author",
      "default": true,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "featured_show_excerpt",
      "default": true,
      "label": "t:sections.main-blog.settings.show_excerpt.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-blog.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.featured-blog.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.main-blog.settings.show_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "default": true,
      "label": "t:sections.main-blog.settings.show_tags.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.main-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": true,
      "label": "t:sections.main-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "default": false,
      "label": "t:sections.main-blog.settings.show_excerpt.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-blog.settings.paragraph.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "aside",
      "name": "t:sections.main-blog.blocks.aside.name",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "t:sections.main-blog.blocks.aside.settings.posts_header.content"
        },
        {
          "type": "checkbox",
          "id": "post_show",
          "default": false,
          "label": "t:sections.main-blog.blocks.aside.settings.enable_posts.label"
        },
        {
          "type": "text",
          "id": "posts_heading",
          "label": "t:sections.all.heading.label",
          "default": "Heading"
        },
        {
          "type": "blog",
          "id": "posts_blog",
          "label": "t:sections.main-blog.blocks.aside.settings.posts_blog.label"
        }
      ]
    }
  ]
}
{% endschema %}
