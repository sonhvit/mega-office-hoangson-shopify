{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-card-horizontal.css' | asset_url | stylesheet_tag }}
{{ 'section-product-markers.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-markers.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign image_size = section.settings.main_image_ratio

  case image_size
    when 'square'
      assign section_size = '100%'
      assign slide_class = image_size
    when 'landscape'
      if section.settings.second_image != blank
        assign section_size = '75%'
      else
        assign section_size = '37%'
      endif
      assign slide_class = image_size
    else
      assign section_size = '135%'
      assign slide_class = image_size
  endcase
%}

<div class="product-markers color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
  {% render 'section-header', section: section %}
  {% style %}
    #shopify-section-{{ section.id }} {
    	--image-height: {{ section_size }};
    }
  {% endstyle %}
  <div class="container">
    <div class="product-markers--content">
      <div class="product-markers-for-mobile">
        {%- for block in section.blocks -%}
          <div
            class="product-markers__item-inner js-product-markers__item-inner color-background-2"
            data-index="{{ forloop.index }}"
          >
            {% render 'product-card-horizontal',
              product_card_product: block.settings.product_id,
              media_ratio: section.settings.image_ratio,
              media_fit: section.settings.image_fit,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              section_id: section.id
            %}
          </div>
        {% endfor %}
      </div>
      <div class="product-markers__markers">
        <div class="product-markers__markers--area">
          {%- for block in section.blocks -%}
            <div
              data-index="{{ forloop.index }}"
              class="product-markers__item js-product-markers__item color-background-1"
              {{ block.shopify_attributes }}
              style="top: {{ block.settings.position_y }}%; left:{{ block.settings.position_x }}%"
            >
              <div class="product-markers__item-number"></div>
              <div
                data-index="{{ forloop.index }}"
                class="product-markers__item-inner js-product-markers__item-inner color-background-1 product-markers__item-inner--{{ block.settings.tooltip_open_position }} {% if block.settings.product_id != blank %}collection-product-markers-card {% endif %}"
              >
                {% render 'product-card-horizontal',
                  product_card_product: block.settings.product_id,
                  media_size: section.settings.image_ratio,
                  media_fit: section.settings.image_fit,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  section_id: section.id
                %}
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="product-markers__markers--images {{ slide_class }}  {% if section.settings.second_image == blank %} one_photo {% endif %}">
          <div class="left-image">
            <div>
              {% if section.settings.image != blank %}
                {% capture sizes %}
                calc(100vw - 40px)
              {% endcapture %}
                {{
                  section.settings.image
                  | image_url: width: section.settings.image.width
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 535, 720, 940, 1100, 1150, 1440, 1600, 1800, 2000, 2100, 2200, 2880, 3200, 3600, 3800',
                    sizes: sizes,
                    class: 'product-markers__image'
                }}
              {% elsif section.settings.image == blank %}
                <div class="product-markers__placeholder">
                  {{ 'collection-apparel-3' | placeholder_svg_tag: 'product-markers__placeholder-svg placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          </div>
          {% if section.settings.second_image != blank %}
            <div class="right-image">
              <div>
                {% if section.settings.second_image != blank %}
                  {% capture sizes %}
                calc(100vw - 40px)
              {% endcapture %}
                  {{
                    section.settings.second_image
                    | image_url: width: section.settings.second_image.width
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 535, 720, 940, 1100, 1150, 1440, 1600, 1800, 2000, 2100, 2200, 2880, 3200, 3600, 3800',
                      sizes: sizes,
                      class: 'product-markers__image'
                  }}
                {% elsif section.settings.second_image == blank %}
                  <div class="product-markers__placeholder">
                    {{
                      'collection-apparel-4'
                      | placeholder_svg_tag: 'product-markers__placeholder-svg placeholder-svg'
                    }}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.product_markers.name",
  "tag": "section",
  "class": "product-markers-section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.product_markers.settings.heading.default"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.all.text.label",
      "default": "t:sections.product_markers.settings.description.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.image_first"
    },
    {
      "type": "image_picker",
      "id": "second_image",
      "label": "t:sections.all.image.image_second"
    },
    {
      "type": "select",
      "id": "main_image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.all.card.image_ratio_2.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.product_markers.settings.button_label.default",
      "label": "t:sections.all.button.label.label",
      "info": "t:sections.all.button.label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button.link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.style.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
