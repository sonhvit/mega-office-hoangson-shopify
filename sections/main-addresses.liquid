{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
	{% render 'section-margin' %}
	{% render 'section-padding' %}
{%- endstyle -%}

<script src="{{ 'customer.js' | asset_url }}" defer></script>

{%- paginate customer.addresses by 5 -%}
	<div
		class="customer addresses section-{{ section.id }}-padding"
		data-customer-addresses
	>
		<div class="container">
			<svg style="display: none">
				<symbol id = "icon-caret" width="20" height="20" viewBox="0 0 20 20">
					<path d="M14 8L10 12L6 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
				</symbol>
			</svg>
			<div class="page-header">
				<div class="page-header__inner">
					<div class="customer__top">
						<h1 class="main-page-title page-title title--page h2">
							<span class="addresses-title">{{ 'customer.addresses.title' | t }}</span>
							<span class="addresses-add_new">{{ 'customer.addresses.add_new' | t }}</span>
						</h1>
						<div class="customer__top--actions">
							<a
								class="title-link button button--simple button--arrow"
								href="{{ routes.account_url }}"
							>
								{% render 'icon-button-arrow-right' %}
								<span class="small-font button-label">
									{{- 'customer.account.return' | t -}}
								</span>
							</a>
							{%- if customer.addresses_count != 0 -%}
								<button
									type="button"
									data-type="new"
									aria-expanded="false"
									aria-controls="AddAddress"
									class="button button button--primary address-add-new focus-inset"
								>
									<span>
										{{ 'customer.addresses.add_new_other' | t }}
									</span>
								</button>
							{%- endif -%}
						</div>
					</div>
				</div>
			</div>

			<div class="address-add-form" data-address>
				<div
					class="address-add-form__item js-expand-elem"
					id="AddAddress"
					data-expand="false"
				>
					<div class="address-add-form__inner">
						{%- form 'customer_address',
							customer.new_address,
							aria-labelledBy: 'AddressNewHeading'
						-%}
							<div class="address-form--personal__info">
								<p class="address-form--section-heading">
									{{ 'customer.addresses.personal' | t }}
								</p>
								<div class="field">
									<input
										type="text"
										id="AddressFirstNameNew"
										name="address[first_name]"
										value="{{ form.first_name }}"
										autocomplete="given-name"
										placeholder=" "
									>
									<label for="AddressFirstNameNew" class="input-label">
										{{- 'customer.addresses.first_name' | t -}}
									</label>
								</div>
								<div class="field">
									<input
										type="text"
										id="AddressLastNameNew"
										name="address[last_name]"
										value="{{ form.last_name }}"
										autocomplete="family-name"
										placeholder=" "
										required
									>
									<label for="AddressLastNameNew" class="input-label">
										{{- 'customer.addresses.last_name' | t -}}
									</label>
								</div>
							</div>
							<div class="address-form--company">
								<p class="address-form--section-heading">
									{{ 'customer.addresses.company_group' | t }}
								</p>
								<div class="field">
									<input
										type="text"
										id="AddressCompanyNew"
										name="address[company]"
										value="{{ form.company }}"
										autocomplete="organization"
										placeholder="{{ 'customer.addresses.company' | t }}"
									>
								</div>
							</div>
							<div class="address-form--addresses">
								<p class="address-form--section-heading">
									{{ 'customer.addresses.heading' | t }}
								</p>
								<div class="field">
									<input
										type="text"
										id="AddressAddress1New"
										name="address[address1]"
										value="{{ form.address1 }}"
										autocomplete="address-line1"
										placeholder=" "
										required
									>
									<label for="AddressAddress1New" class="input-label">
										{{- 'customer.addresses.address1' | t -}}
									</label>
								</div>
								<div class="field address-add-default-check">
									{{ form.set_as_default_checkbox }}
									<label for="address_default_address_new">
										{%- render 'icon-checkmark' -%}
										<span>{{ 'customer.addresses.set_default' | t }}</span>
									</label>
								</div>
								<div class="field">
									<input
										type="text"
										id="AddressAddress2New"
										name="address[address2]"
										value="{{ form.address2 }}"
										autocomplete="address-line2"
										placeholder="{{ 'customer.addresses.address2' | t }}"
									>
								</div>
								<div class="field">
									<div class="select js-select icon-caret">
										<select
											id="AddressCountryNew"
											name="address[country]"
											data-default="{{ form.country }}"
											autocomplete="country"
										>
											{{ all_country_option_tags }}
										</select>
										{% render 'icon-caret' %}
									</div>
								</div>

								<div class="field">
									<input
										type="text"
										id="AddressCityNew"
										name="address[city]"
										value="{{ form.city }}"
										autocomplete="address-level2"
										placeholder=" "
										required
									>
									<label for="AddressCityNew" class="input-label">
										{{- 'customer.addresses.city' | t -}}
									</label>
								</div>
								<div
									class="field select-province"
									id="AddressProvinceContainerNew"
									style="display: none"
								>
									<div class="select js-select  icon-caret">
										<select
											id="AddressProvinceNew"
											name="address[province]"
											data-default="{{ form.province }}"
											autocomplete="address-level1"
										></select>

										{% render 'icon-caret' %}
									</div>
								</div>
								<div class="field">
									<input
										type="text"
										id="AddressZipNew"
										name="address[zip]"
										value="{{ form.zip }}"
										autocapitalize="characters"
										autocomplete="postal-code"
										placeholder=" "
										required
									>
									<label for="AddressZipNew" class="input-label">
										{{- 'customer.addresses.zip' | t -}}
									</label>
								</div>
								<div class="field">
									<input
										type="tel"
										id="AddressPhoneNew"
										name="address[phone]"
										value="{{ form.phone }}"
										autocomplete="tel"
										placeholder=" "
									>
									<label for="AddressPhoneNew" class="input-label">
										{{- 'customer.addresses.phone' | t -}}
									</label>
								</div>
							</div>
							{% if section.settings.confirm_text != blank %}
								<p class="form-confirming_text extra-small-font">
									{{ section.settings.confirm_text }}
								</p>
							{% endif %}
							<div class="address-add-buttons">
								<button class="button button--primary address-add-item focus-inset">
									{{ 'customer.addresses.add' | t }}
								</button>
								<button
									class="button button--simple address-cancel focus-inset"
									type="reset"
									data-type="reset"
								>
									<span class="button-label">{{ 'customer.addresses.cancel' | t }}</span>
								</button>
							</div>
						{%- endform -%}
					</div>
				</div>

				{%- if customer.addresses_count == 0 -%}
					<div class="account-none account-none--address" data-expand="true">
						<div class="account-none__wrapper">
							<div class="account-none__content">
								{%- if section.settings.heading != blank -%}
									<h5>{{ section.settings.heading }}</h5>
								{%- endif -%}
								{%- if section.settings.text != blank -%}
									<div class="account-none__text small-font">
										{{ section.settings.text | escape }}
									</div>
								{%- endif -%}
							</div>
							<button
								type="button"
								aria-expanded="false"
								aria-controls="AddAddress"
								class="button button--primary account-none__button address-add-show focus-inset"
								data-type="new"
							>
								{{ 'customer.addresses.add_new' | t }}
							</button>
						</div>
					</div>
				{%- endif -%}
			</div>

			<div class="address-list" role="list" id="addressList">
				{%- for address in customer.addresses -%}
					<div class="address-list__item-wrapper address-list__item-wrapper{%- if address == customer.default_address -%}--default{%- endif -%}">
						<div
							class="address-add-form__item address-edit-form address-add-form js-expand-elem "
							id="EditAddress_{{ address.id }}"
							data-expand="false"
						>
							<div class="address-add-form__inner">
								{%- form 'customer_address', address -%}
									<div class="address-form--personal__info">
										<p class="address-form--section-heading">
											{{ 'customer.addresses.personal' | t }}
										</p>
										<div class="field">
											<input
												type="text"
												id="AddressFirstName_{{ form.id }}"
												name="address[first_name]"
												value="{{ form.first_name }}"
												autocomplete="given-name"
												placeholder=" "
											>
											<label
												for="AddressFirstName_{{ form.id }}"
												class="input-label"
											>
												{{- 'customer.addresses.first_name' | t -}}
											</label>
										</div>
										<div class="field">
											<input
												type="text"
												id="AddressLastName_{{ form.id }}"
												name="address[last_name]"
												value="{{ form.last_name }}"
												autocomplete="family-name"
												placeholder=" "
												required
											>
											<label
												for="AddressLastName_{{ form.id }}"
												class="input-label"
											>
												{{- 'customer.addresses.last_name' | t -}}
											</label>
										</div>
									</div>
									<div class="address-form--company">
										<p class="address-form--section-heading">
											{{ 'customer.addresses.company_group' | t }}
										</p>
										<div class="field">
											<input
												type="text"
												id="AddressCompany_{{ form.id }}"
												name="address[company]"
												value="{{ form.company }}"
												autocomplete="organization"
												placeholder="{{ 'customer.addresses.company' | t }}"
											>
										</div>
									</div>
									<div class="address-form--addresses">
										<p class="address-form--section-heading">
											{{ 'customer.addresses.heading' | t }}
										</p>
										<div class="field">
											<input
												type="text"
												id="AddressAddress1_{{ form.id }}"
												name="address[address1]"
												value="{{ form.address1 }}"
												autocomplete="address-line1"
												placeholder=" "
												required
											>
											<label
												for="AddressAddress1_{{ form.id }}"
												class="input-label"
											>
												{{- 'customer.addresses.address1' | t -}}
											</label>
										</div>
										<div class="field address-add-default-check">
											{{ form.set_as_default_checkbox }}
											<label for="address_default_address_{{ form.id }}">
												{%- render 'icon-checkmark' -%}
												<span class="extra-small-font">
													{{- 'customer.addresses.set_default' | t -}}
												</span>
											</label>
										</div>
										<div class="field">
											<input
												type="text"
												id="AddressAddress2_{{ form.id }}"
												name="address[address2]"
												value="{{ form.address2 }}"
												autocomplete="address-line2"
												placeholder="{{ 'customer.addresses.address2' | t }}"
											>
										</div>
										<div class="field">
											<div class="select js-select icon-caret">
												<select
													id="AddressCountry_{{ form.id }}"
													name="address[country]"
													data-address-country-select
													data-default="{{ form.country }}"
													data-form-id="{{ form.id }}"
													autocomplete="country"
												>
													{{ all_country_option_tags }}
												</select>
												{% render 'icon-caret' %}
											</div>
										</div>
										<div class="field">
											<input
												type="text"
												id="AddressCity_{{ form.id }}"
												name="address[city]"
												value="{{ form.city }}"
												autocomplete="address-level2"
												placeholder=" "
												required
											>
											<label
												for="AddressCity_{{ form.id }}"
												class="input-label"
											>
												{{- 'customer.addresses.city' | t -}}
											</label>
										</div>
										<div
											class="field select-province"
											id="AddressProvinceContainer_{{ form.id }}"
											style="display:none;"
										>
											<div class="select js-select icon-caret">
												<select
													id="AddressProvince_{{ form.id }}"
													name="address[province]"
													data-default="{{ form.province }}"
													autocomplete="address-level1"
												></select>
												{% render 'icon-caret' %}
											</div>
										</div>
										<div class="field">
											<input
												type="text"
												id="AddressZip_{{ form.id }}"
												name="address[zip]"
												value="{{ form.zip }}"
												autocapitalize="characters"
												autocomplete="postal-code"
												placeholder=" "
												required
											>
											<label for="AddressZip_{{ form.id }}" class="input-label">
												{{- 'customer.addresses.zip' | t -}}
											</label>
										</div>
										<div class="field">
											<input
												type="tel"
												id="AddressPhone_{{ form.id }}"
												name="address[phone]"
												value="{{ form.phone }}"
												autocomplete="tel"
												placeholder=" "
											>
											<label
												for="AddressPhone_{{ form.id }}"
												class="input-label"
											>
												{{- 'customer.addresses.phone' | t -}}
											</label>
										</div>
									</div>
									{% if section.settings.confirm_text != blank %}
										<p class="form-confirming_text extra-small-font">
											{{ section.settings.confirm_text }}
										</p>
									{% endif %}
									<div class="address-add-buttons">
										<button class="button button--primary address-add-item focus-inset">
											{{ 'customer.addresses.update' | t }}
										</button>
										<button
											class="button button--simple address-cancel focus-inset"
											type="reset"
											data-type="reset"
										>
											<span class="button-label">{{ 'customer.addresses.cancel' | t }}</span>
										</button>
									</div>
								{%- endform -%}
							</div>
						</div>

						<div class="address-list__item" data-address>
							<div class="address-list__inner">
								<div class="address-list__wrapper">
									{%- if address == customer.default_address -%}
										<h2 class="address-list__default-heading h5">
											{{ 'customer.addresses.heading' | t }}
											{{ forloop.index }}:
											{{ 'customer.addresses.default' | t }}
										</h2>
									{% else %}
										<h2 class="address-list__default-heading h5">
											{{ 'customer.addresses.heading' | t }}
											{{ forloop.index }}
										</h2>
									{%- endif -%}
									<ul class="address-list-lines list-unstyled">
										{%- if address.name != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.name' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.name -}}
												</span>
											</li>
										{%- endif -%}

										{%- if address.address1 != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.address1' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.address1 -}}
												</span>
											</li>
										{%- endif -%}

										{%- if address.address2 != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.address2' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.address2 -}}
												</span>
											</li>
										{%- endif -%}

										{%- if address.city != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.city' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.city -}}
												</span>
											</li>
										{%- endif -%}

										{%- if address.company != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.company' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.company -}}
												</span>
											</li>
										{%- endif -%}

										{%- if address.country != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.country' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.country -}}
												</span>
											</li>
										{%- endif -%}

										{%- if address.phone != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.phone' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.phone -}}
												</span>
											</li>
										{%- endif -%}

										{%- if address.province != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.province' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.province -}}
												</span>
											</li>
										{%- endif -%}

										{%- if address.zip != blank -%}
											<li class="address-list-lines__item">
												<span class="address-list-lines__name">
													{{- 'customer.addresses.zip' | t -}}
												</span>
												<span class="address-list-lines__value">
													{{- address.zip -}}
												</span>
											</li>
										{%- endif -%}
									</ul>
								</div>
								<div class="address-edit-buttons">
									<button
										class="button button--primary button-address-edit focus-inset"
										type="button"
										id="EditFormButton_{{ address.id }}"
										aria-label="{{ 'customer.addresses.edit_address' | t }} {{ forloop.index }}"
										aria-controls="EditAddress_{{ address.id }}"
										aria-expanded="false"
										data-id="2"
										data-address-id="{{ address.id }}"
									>
										{{ 'customer.addresses.edit' | t }}
									</button>
									<button
										class="button button--simple button-address-delete focus-inset"
										type="button"
										aria-label="{{ 'customer.addresses.delete' | t }} {{ forloop.index }}"
										data-target="{{ address.url }}"
										data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
									>
										<span class="button-label">{{ 'customer.addresses.delete' | t }}</span>
									</button>
								</div>
							</div>
						</div>
					</div>
				{%- endfor -%}
			</div>

			{%- if paginate.pages > 1 -%}
				{%- if paginate.parts.size > 0 -%}
					<nav
						class="pagination"
						role="navigation"
						aria-label="{{ 'general.pagination.label' | t }}"
					>
						<ul role="list">
							{%- if paginate.previous -%}
								<li>
									<a
										class="pagination__arrow pagination__arrow--previous"
										href="{{ paginate.previous.url }}"
										aria-label="{{ 'general.pagination.previous' | t }}"
									>
										{% render 'icon-caret-left' %}
									</a>
								</li>
							{%- endif -%}

							{%- for part in paginate.parts -%}
								<li>
									{%- if part.is_link -%}
										<a
											class="pagination__number pagination__number--link"
											href="{{ part.url }}"
											aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
										>
											{{- part.title -}}
										</a>
									{%- else -%}
										{%- if part.title == paginate.current_page -%}
											<span
												class="pagination__number pagination__number--current"
												aria-current="page"
												aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
											>
												{{- part.title -}}
											</span>
										{%- else -%}
											<span class="pagination__number">{{ part.title }}</span>
										{%- endif -%}
									{%- endif -%}
								</li>
							{%- endfor -%}

							{%- if paginate.next -%}
								<li>
									<a
										class="pagination__arrow pagination__arrow--next"
										href="{{ paginate.next.url }}"
										aria-label="{{ 'general.pagination.next' | t }}"
									>
										{% render 'icon-caret-right' %}
									</a>
								</li>
							{%- endif -%}
						</ul>
					</nav>
				{%- endif -%}
			{%- endif -%}
		</div>
	</div>
{%- endpaginate -%}

<script>
	window.onload = () => {
		typeof CustomerAddresses !== 'undefined' && new CustomerAddresses();
	};
</script>

{% schema %}
{
	"name": "t:sections.main-addresses.name",
	"settings": [
		{
			"type": "inline_richtext",
			"id": "confirm_text",
			"default": "By clicking on the “Add Address” button, I confirm my agreement with the Privacy Policy and Terms of Use",
			"label": "t:sections.all.confirm_text.label"
		},
		{
			"type": "header",
			"content": "t:sections.main-addresses.header_1.content"
		},
		{
			"type": "text",
