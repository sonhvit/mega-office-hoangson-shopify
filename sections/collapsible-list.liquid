{{ 'section-collapsible-list.css' | asset_url | stylesheet_tag }}

<script src="{{ 'collapsible-list.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign image_size = section.settings.height

  case image_size
    when 'square'
      assign section_size = '100%'
      assign slide_class = image_size
    when 'landscape'
      assign section_size = '56.25%'
      assign slide_class = image_size
    else
      assign section_size = '133%'
      assign slide_class = image_size
  endcase
%}

<div class="collapsible-list {{ slide_class }} color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding">
  {% render 'section-header', section: section %}
  {% style %}
    #shopify-section-{{ section.id }} {
      --image-height: {{ section_size }};
    }
  {% endstyle %}
  <div class="container">
    <div class="collapsible-list__main">
      <div class="collapsible-list__content content">
        <div class="collapsible-list__items">
          {%- for block in section.blocks -%}
            {%- if block.settings.question != blank -%}
              <div class="collapsible-list__item" {{ block.shopify_attributes }}>
                <div
                  class="collapsible-list__item--main{% if block.settings.opened %} active{% endif %}"
                >
                  <button class="collapsible-list__toggle button--unstyled focus-inset">
                    <div class="collapsible-list__toggle-group">
                      {%- if block.settings.question != blank -%}
                        <h3 class="collapsible-list__question h5">
                          {{ block.settings.question | escape }}
                        </h3>
                      {%- endif -%}
                    </div>
                    <div class="collapsible-list__icon">
                       {% render 'icon-accardion-arrow' %}
                    </div>
                  </button>

                  {%- if block.settings.answer != blank -%}
                    <div
                      class="collapsible-list__answer"
                      {% if block.settings.opened %}
                        style="display: block;"
                      {% endif %}
                    >
                      <div class="collapsible-list__answer-inner">
                        <p class="small-font">{{ block.settings.answer }}</p>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {% liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
      %}
      {%- if section.settings.image != blank -%}
        <div class="collapsible-list__content--media {{ slide_class }}{% if section.settings.description != blank %} big-margin{% endif %}{% if section.settings.description == blank and section.settings.heading == blank %} no-margin{% endif %}">
          <div
            class="collapsible-list__content--media__overlay"
            style="opacity: {{ section.settings.overlay_opacity }}"
          ></div>
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              class: 'slideshow__image',
              loading: 'lazy',
              width: section.settings.image.width,
              height: image_height,
              sizes: '100vw',
              widths: '550, 720, 990, 1150, 1500, 1800, 2200, 2600, 3000'
          }}
        </div>
      {%- else -%}
        <div class="collapsible-list__content--media {% if section.settings.description == blank and section.settings.heading == blank %} no-margin {% endif %}  {% if section.settings.description != blank %} big-margin {% endif %} ">
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collapsible-list.name",
  "tag": "section",
  "class": "collapsible-list-section spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "blocks": [
    {
      "type": "accordion",
      "name": "t:sections.collapsible-list.blocks.accordion.name",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "default": "Some title",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "inline_richtext",
          "id": "answer",
          "default": "Some description",
          "label": "t:sections.all.text.label"
        },
        {
          "type": "checkbox",
          "id": "opened",
          "label": "t:sections.collapsible-list.blocks.accordion.settings.opened.label",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.bg_image.label"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.all.overlay_opacity.label",
      "default": 0.1
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.all.aspect_ratio.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Heading",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "xl",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collapsible-list.name",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "opened": true
          }
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        }
      ]
    }
  ]
}
{% endschema %}
