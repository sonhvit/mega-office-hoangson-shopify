{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}
{{ 'template-search.css' | asset_url | stylesheet_tag }}

{% comment %}{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
	{{ 'component-facets.css' | asset_url | stylesheet_tag }}
	{% if section.settings.filter_type == 'vertical' %}
    <script src="{{ 'product-grid.js' | asset_url }}" defer="defer"></script>
  {% endif %}
	<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}{% endcomment %}

{%- if settings.quickview_show == false and settings.color_swatch -%}
	{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- style -%}
  {% render 'section-padding' %}
{%- endstyle -%}

{%- if settings.quickview_show -%}
	<link
		rel="preload"
		href="{{ 'section-main-product.css' | asset_url }}"
		as="style"
		onload="this.onload=null;this.rel='stylesheet'"
	>
	<link rel="stylesheet" href="{{ 'component-deferred-media.css' | asset_url }}" media="all">
	<link
		rel="preload"
		href="{{ 'quick-add.css' | asset_url }}"
		as="style"
		onload="this.onload=null;this.rel='stylesheet'"
	>

	<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
	<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
	assign sort_by = search.sort_by | default: search.default_sort_by
	assign terms = search.terms | escape
	assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by 
-%}
	<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
	
<div class="section-{{ section.id }}-padding template-search {% if search.performed == true and search.results_count == 0 and terms != blank %} template-search--empty {% endif %}">
	<div class="template-search__header{% if search.performed == false %} template-search__header-without-indent{% endif %}">
		<div class="container">
		<div class="page-header {{ " " }} {%- if  search.performed and search.results_count == 0 and search.filters == empty -%} small-mb {%- endif -%}">
			<div class="page-header__inner">
				{%- if search.performed -%}
					<h1 class="main-page-title page-title title--page h2">
						{{ 'templates.search.title' | t }}: {{ terms }}
					</h1>
				{%- else -%}
					<h1 class="main-page-title page-title title--page h2">
						{{ 'general.search.search' | t }}
					</h1>
				{%- endif -%}
			</div>
		</div>
		<div class="template-search__search">
			{% comment %}{%- if settings.predictive_search_enabled -%}
			<predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
		{%- endif -%}{% endcomment %}
				{%- if  search.performed and search.results_count == 0 and search.filters == empty -%}
					<div class="search-wrapper">
				{% endif %}
				<form action="{{ routes.search_url }}" method="get" role="search" class="search">
					<div class="search__form-inner">
						<div class="field">
							<div class="field__inner">
								<input
										class="search__input field__input" 
										id="Search-In-Template" 
										type="search" 
										name="q" 
										value="{{ search.terms | escape }}" 
										placeholder="{{ 'general.search.placeholder' | t }}"
								>
								<button type="reset" class="remove__button no-js-hidden focus-inset" style="border: none">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d="M6 6.00002L18.6673 18.6673M6.00002 18.6673L18.6673 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
									</svg>
								</button>
							</div> 
							<label class="visually-hidden" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
							<input name="options[prefix]" type="hidden" value="last">

							<button class="button button--primary focus-inset" aria-label="{{ 'general.search.search' | t }}" style="height: 4.4rem">
								{{ 'general.search.search' | t }}
							</button>
						</div>
					</div>
					{% comment %}{%- if settings.predictive_search_enabled -%}
						<div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
							<div class="predictive-search__loading-state">
								<svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
									<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
								</svg>
							</div>
						</div>
						<span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
					{%- endif -%}{% endcomment %}
				</form>
				{%- if  search.performed and search.results_count == 0 and search.filters == empty -%}
					<p class="search__form-text" role="status">{{ 'templates.search.no_results' | t: terms: search.terms }}
					</p>
				{% comment %}
				{% elsif search.performed and search.results_count > 0 %}
					<p class="search__form-text" role="status">{{ 'templates.search.results' | t: count: search.results_count }}</p>
				{% endcomment %}
				{%- endif -%}
				{%- if  search.performed and search.results_count == 0 and search.filters == empty -%}
				</div>
			{% endif %}
			{% comment %}{%- if settings.predictive_search_enabled -%}
				</predictive-search>
			{%- endif -%}{% endcomment %}

		</div>
	</div>
	</div>
	{%- if search.performed and search.results_count > 0 -%}
		{% liquid
			assign filter_show = false
			for filter in search.filters
				if filter.range_max != 0 
					assign filter_show = true
				endif
			endfor
		%}
		<div class="container">
			{% comment %} 
				{%- if section.settings.enable_filtering == false and section.settings.enable_sorting == false -%} collection-wrapper_no-facets {% endif %}
				{%- if filter_show == false and section.settings.enable_sorting == false -%} collection-wrapper_no-facets {% endif %} 
			{% endcomment %}
			<div class="collection-wrapper collection-wrapper--4
				collection-wrapper--vertical
				collection-wrapper_no-facets
			">
				{% comment %}{%- if search.filters != empty -%}
					{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
							{% render 'facets', 
								results: search, 
								enable_filtering: section.settings.enable_filtering, 
								enable_sorting: section.settings.enable_sorting, 
								filter_type: section.settings.filter_type,
								image_filter_ratio: section.settings.image_filter_ratio,
          			image_filter_fit: section.settings.image_filter_fit,
          			image_filter_columns: section.settings.image_filter_columns
							%}
					{%- endif -%}
				{%- endif -%}{% endcomment %}
			{% comment %} 	{% if section.settings.enable_filtering == false or filter_show == false %}  {%- endif -%} 
			{% if section.settings.filter_type != 'vertical' %}  {% endif %} 
			{% endcomment %}
				<div id="ProductGridContainer" class="products-grid 
					products-grid_no-filter
					full-width
				
			">
				{% paginate search.results by 24 %}
					{%- if search.results.size == 0 and search.filters != empty -%}
						<div class="template-search__results collection collection-product" id="product-grid" data-id="{{ section.id }}">
							<div class="loading-overlay">
								<div class="loading-overlay__spinner">
									<svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
										<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
									</svg>
								</div>
							</div>
							<div class="title-wrapper center title-wrapper-empty">
								<h2 class="title title--primary">
									{{ 'sections.collection_template.empty_results' | t }}
									<br>
									{{ 'sections.collection_template.results_use_fewer_filters_html' | t: link: search_url, class: "underlined-link link" }}
								</h2>
							</div>
						</div>
					{%- else -%}
							<div class="template-search__results collection collection-product" id="product-grid" data-id="{{ section.id }}">
								<div class="loading-overlay">
									<div class="loading-overlay__spinner">
										<svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
											<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
										</svg>
									</div>
								</div>

								{%liquid
									assign search_products = search.results | where: 'object_type', "product"
									assign search_products_size = search_products | size
									assign search_articles = search.results | where: 'object_type', "article"
									assign search_articles_size = search_articles | size
									assign search_pages = search.results | where: 'object_type', "page"
									assign search_pages_size = search_pages | size
								%}

								{% if search_products_size != 0 %}
										<div class="search-results__top first">
											<h3 class="search-results__title">
												{{ 'templates.search.item_count.other' | t: count: '' }}
											</h3>
											{% comment %}<span class="search-results__count subtitle subtitle--secondary">{{ 'templates.search.results_count' | t: count: search_products_size }}</span>{% endcomment %}
										</div>
										{% comment %} {% if section.settings.enable_filtering %} collection-results_filters {% endif %} {% endcomment %}
										<ul class="collection-product-list collection-product-list--4-items
											collection-product-list--1-mobile
											" role="list">
											{%- for item in search_products -%}
												<li class="collection-product-card collection-product-card--small template-search__item {% if settings.quickview_hover %}quickview--hover{% endif %}">
													{%- capture product_settings -%}
														{%- if section.settings.show_vendor -%}vendor,{%- endif -%}title,price{%- endcapture -%}
													{% render 'product-card',
														product_card_product: item,
														media_size: section.settings.image_ratio,
														media_fit: section.settings.image_fit,
														show_secondary_image: section.settings.show_secondary_image,
														show_vendor: section.settings.show_vendor,
														show_collection_name: section.settings.show_collection_name,
														show_color_swatch: section.settings.show_color_swatch,
														show_inventory: section.settings.show_inventory,
														show_desc: section.settings.show_desc, 
														columns: 4,
														section_id: section.id
													%}
												</li>
											{%- endfor -%}
										</ul>
								{% endif %}

								{% if search_articles_size != 0 %}
									<div class="search-results__top {% if search_products_size == 0 %} first {% endif %}">
										<h3 class="search-results__title">
											{{ 'templates.search.article_count.other' | t: count: '' }}
										</h3>
										{% comment %}<span class="search-results__count subtitle subtitle--secondary">{{ 'templates.search.results_count' | t: count: search_articles_size }}</span>{% endcomment %}
									</div>
									<ul class="collection-results collection-results--articles
										collection-results--1-mobile
										collection-results_no-filter
										{% if section.settings.enable_filtering == false or filter_show == false %}  {%- endif -%}" 
										role="list">
										{%- for item in search_articles -%}
											{%- case item.object_type -%}
												{%- when 'article' -%}
													<li class="template-search__item article">
														{% render 'article-card',
															article: item,
															image_ratio: section.settings.article_image_ratio,
															post_heading_size: 'h4',
															show_image: true,
															show_tags: section.settings.article_show_tags,
															show_date: section.settings.article_show_date,
															show_author: section.settings.article_show_author,
															show_excerpt: section.settings.article_show_desc,
															background: false,
															color_scheme: 'background-1',
															overlay: false
														%}
													</li>
											{%- endcase -%}
										{%- endfor -%}
									</ul>
								{% endif %}
			
								{% if search_pages_size != 0 %}
									<div class="search-results__top {% if search_products_size == 0 and search_articles_size == 0 %} first {% endif %}">
										<h3 class="search-results__title">
											{{ 'templates.search.page_count.other' | t: count: '' }}
										</h3>
										{% comment %}<span class="search-results__count subtitle subtitle--secondary">{{ 'templates.search.results_count' | t: count: search_pages_size }}</span>{% endcomment %}
									</div>
									<ul class="collection-results collection-results__pages
										collection-results--1-mobile
										collection-results_no-filter
										{% if section.settings.enable_filtering == false or filter_show == false %}  {%- endif -%}" 
										role="list">
										{%- for item in search_pages -%}
											{%- case item.object_type -%}
												{%- when 'page' -%}
													<li class="template-search__item template-search__page">
														<a href="{{ item.url }}" class="card-wrapper">
															<div class="card-page">
																<span class="icon-wrapper">
																	{% render 'icon-page' %}
																</span>
																<div class="card-page__content">
																	<h3 class="card-page__title h5">
																		{{ item.title | truncate: 50 | escape }}
																	</h3>
																</div>
															</div>
														</a>
													</li>
											{%- endcase -%}
										{%- endfor -%}
									</ul>
								{% endif %}
								{%- if paginate.pages > 1 -%}
									{% render 'pagination', paginate: paginate %}
								{%- endif -%}
							</div>
					{%- endif -%}
				{% endpaginate %}
				</div>
			</div>
		</div>
	{%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section-search",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
         {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.featured-blog.settings.image_ratio.label"
    },
		{
      "type": "select",
      "id": "image_fit",
			"label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.all.card.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.all.card.show_vendor.label"
    },
		{
			"type": "checkbox",
			"id": "show_collection_name",
			"default": true,
			"label": "t:sections.all.product_card.show_colection_name.label"
		},
		{
			"type": "checkbox",
			"id": "show_inventory",
			"default": true,
			"label": "t:sections.all.product_card.show_inventory.label"
		},
		{
			"type": "checkbox",
			"id": "show_color_swatch",
			"default": false,
			"label": "t:sections.all.product_card.show_color.label"
		},
		{
      "type": "checkbox",
      "id": "show_desc",
      "default": false,
      "label": "t:sections.all.card.show_desc.label",
      "info": "t:sections.all.card.show_desc.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__2.content"
    },
		{
      "type": "select",
      "id": "article_image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.featured-blog.settings.image_ratio.label"
    },
		{
      "type": "checkbox",
      "id": "article_show_tags",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_tags.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_date.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_author",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_author.label"
    },
		{
      "type": "checkbox",
      "id": "article_show_desc",
      "default": false,
      "label": "t:sections.main-search.settings.article_show_desc.label"
    },
		{
			"type": "header",
			"content": "t:sections.all.section-padding.header.content"
		},
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ]
}
{% endschema %}
