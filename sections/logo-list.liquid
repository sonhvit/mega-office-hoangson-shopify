{{ 'section-logo-list.css' | asset_url | stylesheet_tag }}
<script src="{{ 'logo-list.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div
  class="logo-list color-{{ section.settings.color_scheme }} background section-{{ section.id }}-padding"
>
  {% render 'section-header', section: section %}

  <div
    class="
      container logo-list__container
      logo-list__wrapper
    "
  >
    <div class="content logo-list-content">
      {% if section.settings.layout == 'horizontal-carousel' %}
        <div class="blog__navigation swiper-navigation no-js-hidden">
          <div class="swiper-button-disabled swiper-button-prev ">
            {% render 'icon-swiper-prev' %}
          </div>
          <div class=" swiper-button-next ">
            {%- render 'icon-swiper-next' -%}
          </div>
        </div>
      {% endif %}

      <div
        class="{% if section.settings.layout == 'horizontal-carousel' %}swiper js-slider-logos{% endif %} logo-list__content logo-list__content--{{ section.settings.layout }}"
        {% if section.settings.layout == 'horizontal-carousel' %}
          data-duration="{{ section.settings.speed_slider_1 }}"
        {% endif %}
      >
        {% if section.settings.layout == 'horizontal-carousel' %}<div class="swiper-wrapper">{% endif %}
        {%- for block in section.blocks -%}
          <div
            class="logo-list__item {% if section.settings.layout == 'horizontal-carousel' %}swiper-slide{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- assign width = block.settings.image_width -%}
            {%- assign height = width | divided_by: block.settings.image_1.aspect_ratio | round: 2 -%}
            {%- assign sizes = '(min-width: 1100px) 750, (min-width: 750px) 550, 275' -%}

            {%- if block.settings.image_2 != blank or block.settings.image_1 != blank -%}
              {%- if block.settings.image_2 != blank -%}
                {{
                  block.settings.image_2
                  | image_url: width: 710
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '275, 550, 750',
                    height: height,
                    width: block.settings.logo_width,
                    class: 'logo-list__image logo-list__image--dark'
                }}
              {%- endif -%}
              {%- if block.settings.image_1 != blank -%}
                {{
                  block.settings.image_1
                  | image_url: width: 710
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '275, 550, 750',
                    height: height,
                    width: block.settings.logo_width,
                    class: 'logo-list__image logo-list__image--light'
                }}
              {%- endif -%}
            {% else %}
              <div class="logo-list__placeholder">{{- 'general.brand.title' | t -}}</div>
            {%- endif -%}
          </div>
        {% endfor %}
        {% if section.settings.layout == 'horizontal-carousel' %}</div>{% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.logo-list.name",
  "tag": "section",
  "class": "section-logo-list spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "horizontal-carousel",
          "label": "t:sections.logo-list.settings.layout.options__1.label"
        },
        {
          "value": "static",
          "label": "t:sections.logo-list.settings.layout.options__2.label"
        }
      ],
      "default": "horizontal-carousel",
      "label": "t:sections.logo-list.settings.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },

    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Heading",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },

    {
      "type": "textarea",
      "id": "description",
      "default": "Some description",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "t:sections.all.button.label.label",
      "info": "t:sections.all.button.label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button.link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.style.options__3.label"
        }
      ],
      "default": "tertiary",
      "label": "t:sections.all.button.style.label"
    },
    {
      "type": "header",
      "content": "t:sections.logo-list.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "speed_slider_1",
      "min": 500,
      "max": 9500,
      "step": 500,
      "default": 500,
      "unit": "ms",
      "label": "t:sections.logo-list.settings.speed_slider_1.label"
    },

    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "xl",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo-list.blocks.logo.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "t:sections.logo-list.blocks.logo.settings.image_1.label"
        },
        {
