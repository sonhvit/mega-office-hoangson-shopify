<style>
	@media screen and (min-width: 1150px) {
		header-drawer {
			display: none;
		}
	}

	.menu-drawer-container {
		display: flex;
	}

	.list-menu {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.list-menu--inline {
		display: inline-flex;
		flex-wrap: wrap;
		margin-left: -0.3rem;
	}

	summary.list-menu__item {
		padding-right: 2.7rem;
	}

	.list-menu__item {
		display: flex;
		align-items: center;
	}

	.list-menu__item--link {
		text-decoration: none;
		padding-bottom: 1rem;
		padding-top: 1rem;
	}

	@media screen and (min-width: 750px) {
		.list-menu__item--link {
			padding-bottom: 1rem;
			padding-top: 1rem;
		}
	}
	.button--custom {
		color: {{ section.settings.colors_custom_button_labels }};
		background-color: {{ section.settings.colors_custom_button_background }};
	}
	.button--custom:not([disabled]):not([aria-disabled="true"]):hover {
		color: {{ section.settings.colors_custom_button_labels_hover }};
		background-color: {{ section.settings.colors_custom_button_background_hover }};
	}

	.header__inline-menu .icon-caret {
		transition: transform var(--duration-default);
		transform-origin: 50% 50%;
	}
	.header__inline-menu .header__menu-item span {
		transition: color 80ms linear;
	}
	.header__inline-menu .list-menu-item.list-menu--megamenu-visible > a.header__menu-item,
	.header__inline-menu .list-menu-item.list-menu--submenu-active > a.header__menu-item,
	.header__inline-menu .list-menu-item.list-menu--submenu:hover > a.header__menu-item {
		background-color: #0F49A0;
		border-radius: 200px;
	}
	.header__inline-menu .list-menu-item.list-menu--megamenu-visible > a.header__menu-item .menu__title,
	.header__inline-menu .list-menu-item.list-menu--submenu-active > a.header__menu-item .menu__title,
	.header__inline-menu .list-menu-item.list-menu--submenu:hover > a.header__menu-item .menu__title {
		color: #FFFFFF;
	}
	.header__inline-menu .list-menu-item.list-menu--megamenu-visible .icon-caret,
	.header__inline-menu .list-menu-item.list-menu--submenu-active .icon-caret,
	.header__inline-menu .list-menu-item.list-menu--submenu:hover .icon-caret {
		transform: rotate(180deg);
		color: #FFFFFF;
	}

	.header__inline-menu .list-menu-item.list-menu--megamenu-visible .header-menu__icon svg path,
	.header__inline-menu .list-menu-item.list-menu--submenu-active .header-menu__icon svg path,
	.header__inline-menu .list-menu-item.list-menu--submenu:hover .header-menu__icon svg path{
		fill: #FFFFFF;
	}

</style>

