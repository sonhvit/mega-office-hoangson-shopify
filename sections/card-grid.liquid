{{ 'section-card-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign image_size = section.settings.height

  case image_size
    when 'adapt'
      if section.settings.image != blank
        assign section_size = 1 | divided_by: section.blocks[0].settings.image.aspect_ratio | times: 100 | append: '%'
      endif
      assign slide_class = image_size
    when '1/1'
      assign section_size = '100%'
      assign slide_class = image_size
    when '3/2'
      assign section_size = '56.25%'
      assign slide_class = image_size
    when '4/3'
      assign section_size = '75%'
      assign slide_class = image_size
    when '5/3'
      assign section_size = '38.2%'
      assign slide_class = image_size
    when '16/9'
      assign section_size = '56.25%'
      assign slide_class = image_size
    when '21/9'
      assign section_size = '42.8%'
      assign slide_class = image_size
    when 'large'
      assign section_size = 'calc(100vh - var(--header-height) - var(--announcement-height))'
      assign slide_class = image_size
    else
      assign section_size = 'calc(100vh - var(--header-height) - var(--announcement-height))'
      assign slide_class = image_size
  endcase
%}

<div class="card-grid  background section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  {% style %}
    #shopify-section-{{ section.id }} {
      --image-height: {{ section_size }};
    }
  {% endstyle %}
  <div class="container">
    <div class="card-grid__content card-grid__content--{{ section.settings.column_per_row }} ">
      {% for block in section.blocks %}
        <div class="card-grid__content--item color-{{ block.settings.color_scheme }}    {% if block.settings.subheading == blank and  block.settings.heading == blank %} item-without-padding {% endif %}">
          {% if block.settings.subheading != blank or  block.settings.heading != blank %}
            <div class="card-grid__content--item__details">
              {% if block.settings.subheading != blank %}
                <span class="card-grid__content--item__details__subheading">
                  {{ block.settings.subheading }}
                </span>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h2 class="card-grid__content--item__details__heading {{ block.settings.heading_size }} ">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}
            </div>
          {% endif %}
          {% liquid
            assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio
          %}
          {%- if block.settings.image != blank -%}
            <div class="card-grid__content--item--media {{ slide_class }}">
              <div
                class="card-grid__content--item--media__overlay"
                style="opacity: {{ block.settings.overlay_opacity }}"
              ></div>
              {{
                block.settings.image
                | image_url: width: block.settings.image.width
                | image_tag:
                  class: 'slideshow__image',
                  loading: 'lazy',
                  width: block.settings.image.width,
                  height: image_height,
                  sizes: '100vw',
                  widths: '550, 720, 990, 1150, 1500, 1800, 2200, 2600, 3000'
              }}
            </div>
          {%- else -%}
            <div class="card-grid__content--item--media {{ slide_class }}">
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.card-grid.name",
  "tag": "section",
  "class": "grid-card-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.aspect_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.aspect_ratio.options__2.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.all.aspect_ratio.options__3.label"
        },
        {
          "value": "5/3",
          "label": "t:sections.all.aspect_ratio.options__9.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.all.aspect_ratio.options__4.label"
        },
        {
          "value": "21/9",
          "label": "t:sections.all.aspect_ratio.options__5.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.all.aspect_ratio.options__6.label"
        },
        {
          "value": "full_height",
          "label": "t:sections.all.aspect_ratio.options__10.label"
        }
      ],
      "default": "5/3",
      "label": "t:sections.all.aspect_ratio.label"
    },
    {
      "type": "range",
      "id": "column_per_row",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "t:sections.all.column_per_row.label",
      "info": "t:sections.all.column_per_row.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
