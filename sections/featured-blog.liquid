{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}

<script src="{{ 'featured-blog.js' | asset_url }}" defer="defer"></script>

{%- style -%}
   {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign post_limit = section.settings.post_limit

  if post_limit <= section.settings.blog.articles_count
    assign posts_exceed_limit = true
  endif

  assign post_heading_size = section.settings.post_heading_size
%}
{% liquid
  assign image_size = section.settings.image_ratio

  case image_size
    when 'square'
      assign section_size = '100%'
      assign slide_class = image_size
    when 'landscape'
      assign section_size = '56.25%'
      assign slide_class = image_size
    else
      assign section_size = '133%'
      assign slide_class = image_size
  endcase
%}
{% assign section_id = 'shopify-section-' | append: section.id %}

<div class="blog color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  {% render 'section-header', section: section %}
  <div
    class="
      container blog__grid__container
      blog__grid__wrapper
    "
  >
    <div class="content">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {% if section.settings.layout == 'slider' %}
          <div class="swiper-navigation  no-js-hidden">
            <div class="swiper-button-disabled swiper-button-prev ">
              {% render 'icon-swiper-prev' %}
            </div>
            <div class="swiper-button-next ">
              {%- render 'icon-swiper-next' -%}
            </div>
          </div>
        {% endif %}

        <div
          class="
            {% if section.settings.layout == 'slider' %}swiper js-slider-blog-slider{% endif %}
            blog-slider__content blog-slider__content--{{ section.settings.layout }}
          "
          {% if section.settings.layout == 'slider' %}
            data-duration="{{ section.settings.speed_slider_1 }}"
            data-column-count="{{ section.settings.columns_to_show }}"
          {% endif %}
        >
          <div
            class="
               article
              {% if section.settings.layout == 'slider' %}swiper-wrapper{% else %}
                   blog-list blog-grid
              blog-grid--{{ section.settings.columns_to_show }}
              blog-grid--{{ section.settings.columns_mobile }}-mobile {% endif %}
            "
          >
            {%- for article in section.settings.blog.articles limit: post_limit -%}
              <div class="{% if section.settings.layout == 'slider' %}swiper-slide {% endif %}">
                {% render 'article-card',
                  section: section,
                  blog: section.settings.blog,
                  article: article,
                  image_ratio: section.settings.image_ratio,
                  post_heading_size: post_heading_size,
                  show_image: section.settings.show_image,
                  show_tags: section.settings.show_tags,
                  show_date: section.settings.show_date,
                  show_author: section.settings.show_author,
                  show_excerpt: section.settings.show_excerpt,
                  background: section.settings.background_card,
                  color_scheme: section.settings.card_color_scheme,
                  section_author_image: section.settings.author_image,
                  overlay: false
                %}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {% else %}
        <div
          class="empty-blog blog-slider__content blog-slider__content--{{ section.settings.layout }}"
        >
          <div
            class="
               article
              blog-list blog-grid
              blog-grid--4
              blog-grid--{{ section.settings.columns_mobile }}-mobile
            "
          >
            {% for i in (1..4) %}
              {% render 'article-card-placeholder', section: section %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
<script>
  (function () {
    const section = `#{{ section_id }}`;
    const sectionSelector = `#{{ section_id }} .swiper`;
    const buttonSelector = `#{{ section_id }} .swiper-navigation`;
    const imageSelector = ` .article-card--image img`;
    
    function updateButtonPositions() {
      {% comment %} if (window.innerWidth < 1150) return; {% endcomment %}
        
        const swiper = document.querySelector(sectionSelector);
        
        if (!swiper) return;
        
        const image = swiper.querySelector(imageSelector);
      if (!image) return;
      
      const setButtonPosition = () => {
        const imageHeight = image.offsetHeight;
        const buttons = document.querySelector(buttonSelector);
          buttons.style.top = `${imageHeight / 2}px`; 
          buttons.style.transform = 'translateY(-50%)'; 
      };

      if (image.complete) {
        setButtonPosition();
      } else { 
        image.addEventListener('load', setButtonPosition);
      }
    }

    document.addEventListener('DOMContentLoaded', updateButtonPositions);
    window.addEventListener('resize', updateButtonPositions);
    document.addEventListener('shopify:section:load', updateButtonPositions);
  })();
</script>

