{{ 'section-information-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'information-bar.js' | asset_url }}" defer="defer"></script>

{%- style -%}
	{% render 'section-padding' %}
	 {% render 'section-margin' %}
{%- endstyle -%}

<div class="information-bar color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
	<div class="container">
		<div class="information-bar__wrapper">
		  {% if section.settings.layout == 'carousel' %}
        <div class="blog__navigation information-bar__navigation swiper-navigation no-js-hidden">
          <div class="swiper-button-disabled swiper-button-prev ">
            {% render 'icon-swiper-prev' %}
          </div>
          <div class=" swiper-button-next ">
            {%- render 'icon-swiper-next' -%}
          </div>
        </div>
      {% endif %}
		<div
			class="{% if section.settings.layout == 'carousel' %}swiper js-slider-information-bar{% endif %} information-bar__content information-bar__content--{{ section.settings.column_per_row }}  {%- if section.settings.border_type == "sepearator" -%} information-bar__content--seperator{% endif %}"
			{% if section.settings.layout == 'carousel' %}
				data-duration="{{ section.settings.speed_slider_1 }}"
			{% endif %}
		>
			 {% if section.settings.layout == 'carousel' %}<div class="swiper-wrapper">{% endif %}
			{% for block in section.blocks %}
				{% liquid
					assign condition = forloop.index | modulo: section.settings.column_per_row
					if condition == 0
						assign block_class = ' hide_border'
					else
						assign block_class = ''
					endif
				%}
				<div class="information-bar__content--item {% if section.settings.layout == 'carousel' %}swiper-slide{% endif %} {%- if section.settings.border_type == "sepearator" and section.settings.layout == "static" -%} {{ block_class }} border-item{% elsif section.settings.border_type == "sepearator" and section.settings.layout == "carousel" %} border-item-carousel{% endif %} ">
					{%- if block.settings.image != blank -%}
						{{
							block.settings.image
							| image_url: width: 40
							| image_tag:
								loading: 'lazy',
								sizes: '100vw',
								widths: '360, 550, 720',
								height: 40,
								width: 40,
								class: 'information-bar__content--item__image header__heading-logo'
						}}
					{% endif %}
					{% if block.settings.logo_image_dark != blank %}
						{{
							block.settings.logo_image_dark
							| image_url: width: 40
							| image_tag:
								loading: 'lazy',
								sizes: '100vw',
								widths: '360, 535, 720',
								class: 'header__heading-logo header__heading-logo--overlay',
								height: 40,
								width: 40
						}}
					{% endif %}
					<div class="information-bar__content--item__details">
						<div class="information-bar__content--item__details--main">
							{% if block.settings.heading != blank %}
								<p class="information-bar__content--item__details--main--title {{ block.settings.heading_size }}">
									{{ block.settings.heading }}
								</p>
							{% endif %}
							{% if block.settings.text != blank %}
								<p class="information-bar__content--item__details--main--desc small-font">
									{{ block.settings.text }}
								</p>
							{% endif %}
						</div>
						{%- if block.settings.button_label != blank -%}
							{% render 'button', layout: block, custom_btn_style: 'tertiary' %}
						{% endif %}
					</div>
				</div>
			{% endfor %}
        {% if section.settings.layout == 'carousel' %}</div>{% endif %}

		</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.information_bar.name",
	"tag": "section",
	"class": "spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-1",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "range",
			"id": "column_per_row",
			"min": 1,
			"max": 4,
			"step": 1,
			"default": 4,
			"label": "t:sections.all.column_per_row.label",
			"info": "t:sections.all.column_per_row.info",
			"visible_if": "{{ section.settings.layout == 'static' }}"
		},
		{
			"type": "select",
			"id": "layout",
			"options": [
				{
					"value": "carousel",
					"label": "t:sections.logo-list.settings.layout.options__1.label"
				},
				{
					"value": "static",
					"label": "t:sections.logo-list.settings.layout.options__2.label"
				}
			],
			"default": "static",
			"label": "t:sections.logo-list.settings.layout.label"
		},
		{
			"type": "select",
			"id": "border_type",
			"options": [
				{
					"value": "sepearator",
					"label": "t:sections.all.border_type.options__2.label"
				},
				{
					"value": "full",
					"label": "t:sections.all.border_type.options__1.label"
				}
			],
			"default": "full",
			"label": "t:sections.all.border_type.label"
		},
		{
      "type": "header",
      "content": "t:sections.logo-list.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "speed_slider_1",
      "min": 500,
      "max": 9500,
      "step": 500,
      "default": 500,
      "unit": "ms",
      "label": "t:sections.logo-list.settings.speed_slider_1.label"
    },
		{
			"type": "header",
			"content": "t:sections.all.section-padding.header.content"
		},
		{
			"type": "select",
			"id": "padding_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-padding.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-padding.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-padding.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-padding.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-padding.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-padding.options__6.label"
				}
			],
			"default": "m",
			"label": "t:sections.all.section-padding.padding_top.label"
		},
		{
			"type": "select",
			"id": "padding_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-padding.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-padding.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-padding.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-padding.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-padding.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-padding.options__6.label"
				}
			],
			"default": "m",
			"label": "t:sections.all.section-padding.padding_bottom.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "s",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-margin.options__6.label"
				}
			],
			"default": "s",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	],
	"blocks": [
		{
			"type": "card",
			"name": "t:sections.information_bar.blocks.name",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "t:sections.information_bar.blocks.settings.icon.label"
				},
				{
					"type": "image_picker",
					"id": "logo_image_dark",
					"label": "t:sections.information_bar.blocks.settings.icon_dm.label",
					"info": "t:sections.newsletter.settings.logo_dm.info"
				},
				{
					"type": "inline_richtext",
					"id": "heading",
					"default": "Heading",
					"label": "t:sections.all.heading.label"
				},
				{
					"type": "select",
					"id": "heading_size",
					"options": [
						{
							"value": "small-font",
							"label": "t:sections.all.heading_size.options__2.label"
						},
						{
							"value": "body-large",
							"label": "t:sections.all.heading_size.options__3.label"
						}
					],
					"default": "body-large",
					"label": "t:sections.all.heading_size.label"
				},
				{
					"type": "textarea",
					"id": "text",
					"label": "t:sections.all.text.label"
				},
				{
					"type": "header",
					"content": "t:sections.all.button.header.content"
				},
				{
					"type": "text",
					"id": "button_label",
					"default": "Button label",
					"label": "t:sections.all.button.label.label",
					"info": "t:sections.all.button.label.info"
				},
				{
					"type": "url",
					"id": "button_link",
					"label": "t:sections.all.button.link.label"
				}
			]
		}
	],
	"presets": [
		{
			"name": "t:sections.information_bar.name",
			"blocks": [
				{
					"type": "card"
				},
				{
					"type": "card"
				},
				{
					"type": "card"
				},
				{
					"type": "card"
				}
			]
		}
	]
}
{% endschema %}
