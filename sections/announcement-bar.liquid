<script src="{{ 'countdown.js' | asset_url }}" defer="defer"></script>

<style>
	:root {
		--announcement-height: {{ section.settings.height_mobile }}px;
	}

	@media screen and (min-width: 765px) {
		:root {
		--announcement-height: {{ section.settings.height }}px;
	}
	}
</style>

{% liquid
	assign timezone = 'now' | date: '%Z' | plus: 0 | append: ''

	if timezone.size > 1
		assign timezone = 'now' | date: '%Z' | divided_by: 100 | times: 3600.0 | plus: 1800
	else
		assign timezone = 'now' | date: '%Z' | minus: 1 | times: 3600.0
	endif

	assign date_merge = section.blocks[0].settings.date_picker | append: '-' | append: section.blocks[0].settings.time_picker | append: ':00'
	assign date_now = 'now' | date: '%s' | minus: 0
	assign date_settings = date_merge | date: '%s' | minus: 0

	if date_now < date_settings
		assign distance = date_settings | minus: date_now
		assign days = distance | divided_by: 3600 | divided_by: 24 | floor | append: ''
		assign hours = distance | modulo: 86400 | divided_by: 3600 | floor | append: ''
		assign minutes = distance | modulo: 3600 | divided_by: 60 | floor | append: ''
		assign seconds = distance | modulo: 60 | floor | append: ''
	else
		assign days = '00'
		assign hours = '00'
		assign minutes = '00'
		assign seconds = '00'
	endif
%}

<div
	class="announcement-bar color-{{ section.settings.color_scheme }} background"
	role="region"
	aria-label="{{ 'sections.header.announcement' | t }}"
>
	{%- if section.settings.text != blank -%}
		<div class="announcement-bar__message">
			<div class="announcement-bar__text small-font">
				{{ section.settings.text }}
			</div>
		</div>
	{%- endif -%}
	{% if section.settings.enable_countdown != false %}
		{%- if section.settings.date_picker != blank
			or section.settings.countdown_heading
		-%}
			<countdown-timer
				class="js-countdown slideshow-countdown js-countdown-{{ section.id }}"
				data-date="{{ section.settings.date_picker }}"
				data-time="{{ section.settings.time_picker }}"
				data-enable-mock-timer="{{ section.settings.enable_mock_timer | default: false }}"
				data-enable-mock-picker-day="{{ section.settings.mock_date_picker_day | default: 2 }}"
				data-enable-mock-picker-hours="{{ section.settings.mock_date_picker_hours | default: 3 }}"
				data-completed="{{ section.settings.completed_countdown }}"
			>
				{%- if section.settings.date_picker != blank
					or section.settings.countdown_heading
				-%}
					<div class="slideshow-countdown__content countdown-section">
						{%- if section.settings.date_picker != blank -%}
							<div class="slideshow-countdown__content--main countdown__main">
								{% render 'icon-timer' %}
								<div class="slideshow-countdown__content--main__block">
									<span class="countdown_block_days h5">
										{% if days.size > 1 %}
											{{ days }}
										{% else %}
											{{ 0 | append: days }}
										{% endif %}
									</span>
									<span class="countdown_block_suffix">
										{{- 'general.slideshow_countdown.days' | t }}
									</span>
								</div>
								{% render 'icon-colon' %}
								<div class="slideshow-countdown__content--main__block">
									<span class="countdown_block_hours h5">
										{% if hours.size > 1 %}
											{{ hours }}
										{% else %}
											{{ 0 | append: hours }}
										{% endif %}
									</span>
									<span class="countdown_block_suffix">
										{{- 'general.slideshow_countdown.hours' | t -}}
									</span>
								</div>
								{% render 'icon-colon' %}
								<div class="slideshow-countdown__content--main__block">
									<span class="countdown_block_minutes h5">
										{% if minutes.size > 1 %}
											{{ minutes }}
										{% else %}
											{{ 0 | append: minutes }}
										{% endif %}
									</span>
									<span class="countdown_block_suffix">
										{{- 'general.slideshow_countdown.minutes' | t -}}
									</span>
								</div>
								{% render 'icon-colon' %}
								<div class="slideshow-countdown__content--main__block">
									<span class="countdown_block_seconds h5">
										{% if seconds.size > 1 %}
											{{ seconds }}
										{% else %}
											{{ 0 | append: seconds }}
										{% endif %}
									</span>
									<span class="countdown_block_suffix">
										{{- 'general.slideshow_countdown.seconds' | t -}}
									</span>
								</div>
							</div>
						{%- endif -%}
						{% if section.settings.countdown_heading %}
							<div class="countdown__end-info">
								<p class="small-font countdown__end-info-text">
									{{ section.settings.countdown_heading }}
								</p>
							</div>
						{% endif %}
					</div>
				{%- endif -%}
			</countdown-timer>
		{%- endif -%}
	{% endif %}
	{% comment %}
		{% liquid
		  if section != blank
		    assign btn_label = section.settings.button_label
		    assign btn_link = section.settings.button_link
		    if section.settings.button_style != blank
		      assign btn_style = section.settings.button_style

		  endif
		%}
	{% endcomment %}

	{% if section.settings.button_label != blank %}
		<a
			{% if section.settings.button_link != blank %}
				href="{{ section.settings.button_link }}"
			{% endif %}
			class="button button_announcment button--primary focus-inset"
			{% if section.settings.button_link == blank %}
				aria-disabled="true"
			{% endif %}
		>
			<span class="button-label-small button-label small-font">
				{{- section.settings.button_label | strip }}
			</span>
			{% comment %} {% render 'icon-swiper-next' %} {% endcomment %}
		</a>
	{% endif %}
</div>

{% schema %}
{
	"name": "t:sections.announcement-bar.name",
	"class": "section-announcement",
	"limit": 1,
	"enabled_on": {
		"groups": ["header"]
	},
	"settings": [
		{
			"type": "range",
			"id": "height",
			"min": 35,
			"max": 100,
			"step": 1,
			"default": 38,
			"label": "t:sections.announcement-bar.settings.height.label"
		},
		{
			"type": "range",
			"id": "height_mobile",
			"min": 34,
			"max": 70,
			"step": 1,
			"default": 34,
			"label": "t:sections.announcement-bar.settings.height_mobile.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-3",
			"label": "t:sections.announcement-bar.settings.color_scheme.label"
		},
		{
			"type": "inline_richtext",
			"id": "text",
			"default": "For example, a test of the announcement of some news",
			"label": "t:sections.announcement-bar.settings.text.label"
		},
		{
			"type": "header",
			"content": "t:sections.slideshow.blocks.slide.settings.cuntdown_header.label"
		},
		{
			"type": "checkbox",
			"id": "enable_countdown",
			"label": "t:sections.slideshow.blocks.slide.settings.enable_countdown.label",
			"default": false
		},
		{
			"type": "checkbox",
			"id": "enable_mock_timer",
			"default": false,
			"label": "t:sections.countdown.settings.enable_mock_timer.label",
			"info": "t:sections.countdown.settings.enable_mock_timer.info"
		},
		{
			"type": "text",
			"id": "date_picker",
			"default": "2025-08-01",
			"info": "YYYY-MM-DD",
			"label": "t:sections.countdown.settings.date_picker.label",
			"visible_if": "{{ section.settings.enable_mock_timer == false }}"
		},
		{
			"type": "text",
			"id": "time_picker",
			"default": "00:00",
			"info": "hh:mm",
			"label": "t:sections.countdown.settings.time_picker.label",
			"visible_if": "{{ section.settings.enable_mock_timer == false }}"
		},
		{
			"type": "range",
			"id": "mock_date_picker_day",
			"min": 1,
			"max": 31,
			"step": 1,
			"default": 2,
			"label": "t:sections.countdown.settings.mock_date_picker_day.label",
			"visible_if": "{{ section.settings.enable_mock_timer }}"
		},
		{
			"type": "range",
			"id": "mock_date_picker_hours",
			"min": 1,
			"max": 23,
			"step": 1,
			"default": 3,
			"label": "t:sections.countdown.settings.mock_date_picker_hours.label",
			"visible_if": "{{ section.settings.enable_mock_timer }}"
		},
		{
			"type": "select",
			"id": "completed_countdown",
			"options": [
				{
					"value": "hide_section",
					"label": "t:sections.countdown.settings.completed_countdown.options_1.label"
				},
				{
					"value": "show_text",
					"label": "t:sections.countdown.settings.completed_countdown.options_2.label"
				}
			],
			"default": "show_text",
			"label": "t:sections.countdown.settings.completed_countdown.label",
			"visible_if": "{{ section.settings.enable_mock_timer == false }}"
		},
		{
			"type": "inline_richtext",
			"id": "countdown_heading",
			"default": "Header after countdown",
			"label": "t:sections.countdown.settings.countdown_heading.label",
			"visible_if": "{{ section.settings.enable_mock_timer == false }}"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header.content"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Button label",
			"label": "t:sections.all.button.label.label",
			"info": "t:sections.all.button.label.info"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:sections.all.button.link.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.announcement-bar.name",
			"settings": {
				"text": "For example, a test of the announcement of some news"
			}
		}
	]
}
{% endschema %}
