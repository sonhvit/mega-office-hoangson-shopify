{{ 'mos-header-banner.css' | asset_url | stylesheet_tag }}

{% liquid
  assign media_count = 0
  if section.settings.image_1 != blank
    assign media_width_desktop = 100 | divided_by: 2 | append: 'vw'
  else
    assign media_width_desktop = '100vw'
  endif
  assign media_width_mobile = '100vw'
  assign sizes = '(min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '832, 1200, 1600, 1920, 2560, 3840'

  assign has_image_1 = false
  assign has_media = false
  if section.settings.image_1 != blank
    assign has_image_1 = true
    assign has_media = true
  endif

  assign fetch_priority = 'auto'

  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

{% capture media %}
  {%- if has_image_1 -%}
    {% assign media_count = media_count | plus: 1 %}
    {{
      section.settings.image_1
      | image_url: width: 3840
      | image_tag:
        width: section.settings.image_1.width,
        widths: widths,
        height: section.settings.image_1.height,
        alt: section.settings.image_1.alt,
        class: 'header-banner__image',
        sizes: sizes,
        fetchpriority: fetch_priority
    }}
  {%- endif -%}

  {% if has_media == false %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'header-banner__image' }}
  {%- endif -%}
{% endcapture %}

{%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_mb}}px;
      padding-bottom: {{ section.settings.padding_bottom_mb}}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
{%- endstyle -%}

<div
  id="mos-header-banner-{{ section.id }}"
  class="header-banner mos-header-banner color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding {% if section.settings.including_breadcrumbs != blank %} including-breadcrumbs {% endif %}"
  style="--mos-color-subtext-header-banner: 102, 102, 102;"
>
  <div class="container">
    <div
        class="header-banner__container spacing-style section section--full-width"
        style="background-color: {{ section.settings.background_color_banner }};"
    >
        {%- if section.settings.link != blank -%}
        <a
            href="{{ section.settings.link }}"
            class="header-banner__link"
            {% if section.settings.open_in_new_tab %}
            target="_blank" rel="noopener"
            {% endif %}
        ></a>
        {%- endif -%}
        <div
        class="
            header-banner__content-wrapper
            section-content-wrapper
            {% if section.settings.change_letter_space_heading %} change_letter_space_heading {% endif %}
        "
        >
          {%- if section.settings.including_breadcrumbs != blank -%}
            {% comment %}{% if settings.show_breadcrumbs %}{% endcomment %}
              <nav class="breadcrumb small-font" role="navigation" aria-label="breadcrumbs">
                <a
                  href="{{ routes.root_url }}"
                  title="{{ 'general.breadcrumbs.home' | t }}"
                  class="breadcrumb__link"
                >
                  {{ 'general.breadcrumbs.home' | t }}
                </a>
                
                <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
                <span>{{ page.title }}</span>
              </nav>
            {% comment %}{% endif %}{% endcomment %}
          {%- endif -%}
          
          {%- for block in section.blocks -%}
              {%- case block.type -%}
                  {%- when 'subheading' -%}
                      <div
                          class="header-banner-text__subheading subtitle small-font"
                          {{ block.shopify_attributes }}
                      >
                          {{ block.settings.subheading | escape }}
                      </div>
                  {%- when 'heading' -%}
                      <{{ block.settings.heading_size }}
                          class="header-banner-text__heading title--section"
                          {{ block.shopify_attributes }}
                      >
                          {{ block.settings.heading }}
                      </{{ block.settings.heading_size }}>
                  {%- when 'text' -%}
                      <div class="header-banner-text__text rte" {{ block.shopify_attributes }}>
                          {{ block.settings.text }}
                      </div>
                  {%- when 'button' -%}
                      {% render 'button', layout: block %}
                  {%- when 'download' -%}
                      {% if section.settings.download_file != blank %}
                        <a
                          href="{{ section.settings.download_file }}"
                          class="button button--primary button-download"
                          download
                          target="_blank"
                          rel="noopener"
                          {{ block.shopify_attributes }}
                        >
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <mask id="mask0_2521_15982" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
                            <rect width="24" height="24" fill="#D9D9D9"/>
                            </mask>
                            <g mask="url(#mask0_2521_15982)">
                            <path d="M12 15.4115C11.8795 15.4115 11.7673 15.3923 11.6635 15.3538C11.5597 15.3154 11.4609 15.2494 11.3672 15.1558L8.25775 12.0463C8.10908 11.8974 8.03567 11.7233 8.0375 11.524C8.0395 11.3247 8.11292 11.1474 8.25775 10.9922C8.41292 10.8372 8.59108 10.7572 8.79225 10.752C8.99358 10.7468 9.17183 10.8218 9.327 10.977L11.25 12.9V5.25C11.25 5.03717 11.3218 4.859 11.4655 4.7155C11.609 4.57183 11.7872 4.5 12 4.5C12.2128 4.5 12.391 4.57183 12.5345 4.7155C12.6782 4.859 12.75 5.03717 12.75 5.25V12.9L14.673 10.977C14.8218 10.8283 14.9984 10.7549 15.2028 10.7568C15.4073 10.7588 15.5871 10.8372 15.7423 10.9922C15.8871 11.1474 15.9621 11.3231 15.9672 11.5192C15.9724 11.7154 15.8974 11.8911 15.7423 12.0463L12.6328 15.1558C12.5391 15.2494 12.4403 15.3154 12.3365 15.3538C12.2327 15.3923 12.1205 15.4115 12 15.4115ZM6.30775 19.5C5.80258 19.5 5.375 19.325 5.025 18.975C4.675 18.625 4.5 18.1974 4.5 17.6923V15.7308C4.5 15.5179 4.57183 15.3398 4.7155 15.1962C4.859 15.0526 5.03717 14.9808 5.25 14.9808C5.46283 14.9808 5.641 15.0526 5.7845 15.1962C5.92817 15.3398 6 15.5179 6 15.7308V17.6923C6 17.7692 6.03208 17.8398 6.09625 17.9038C6.16025 17.9679 6.23075 18 6.30775 18H17.6923C17.7692 18 17.8398 17.9679 17.9038 17.9038C17.9679 17.8398 18 17.7692 18 17.6923V15.7308C18 15.5179 18.0718 15.3398 18.2155 15.1962C18.359 15.0526 18.5372 14.9808 18.75 14.9808C18.9628 14.9808 19.141 15.0526 19.2845 15.1962C19.4282 15.3398 19.5 15.5179 19.5 15.7308V17.6923C19.5 18.1974 19.325 18.625 18.975 18.975C18.625 19.325 18.1974 19.5 17.6923 19.5H6.30775Z" fill="white"/>
                            </g>
                          </svg>
                          {{ block.settings.label }}
                        </a>
                      {% endif %}
              {%- endcase -%}
          {%- endfor -%}
        </div>

        <div
        class="header-banner__media-wrapper"
        style="--header-banner-media-count: {{ media_count }};{%- if section.settings.image_1 != blank -%} --header-banner-media-aspect-ratio: {{ section.settings.image_1.aspect_ratio }};{% endif %}"
        >
            {{ media }}
        </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Mos Header Banner",
  "tag": "section",
  "class": "header-banner-wrapper section-wrapper",
  "blocks": [
		{
			"type": "subheading",
			"name": "t:sections.rich-text.blocks.subheading.name",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "subheading",
					"default": "t:sections.rich-text.blocks.subheading.settings.heading.default",
					"label": "t:sections.rich-text.blocks.subheading.settings.heading.label"
				}
			]
		},
		{
			"type": "heading",
			"name": "t:sections.rich-text.blocks.heading.name",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "heading",
					"default": "t:sections.rich-text.blocks.heading.settings.heading.default",
					"label": "t:sections.rich-text.blocks.heading.settings.heading.label"
				},
				{
					"type": "select",
					"id": "heading_size",
					"options": [
						{
							"value": "h2",
							"label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__1.label"
						},
						{
							"value": "h1",
							"label": "t:sections.rich-text.blocks.heading.settings.heading_size.options__2.label"
						}
					],
					"default": "h1",
					"label": "t:sections.rich-text.blocks.heading.settings.heading_size.label"
				}
			]
		},
		{
			"type": "text",
			"name": "t:sections.rich-text.blocks.text.name",
			"limit": 1,
			"settings": [
				{
					"type": "richtext",
					"id": "text",
					"default": "t:sections.rich-text.blocks.text.settings.text.default",
					"label": "t:sections.rich-text.blocks.text.settings.text.label"
				}
			]
		},
		{
			"type": "button",
			"name": "t:sections.rich-text.blocks.button.name",
			"limit": 1,
			"settings": [
				{
					"type": "header",
					"content": "t:sections.all.button.header.content"
				},
				{
					"type": "text",
					"id": "button_label",
					"default": "t:sections.all.button.label.default_3",
					"label": "t:sections.all.button.label.label",
					"info": "t:sections.all.button.label.info"
				},
				{
					"type": "url",
					"id": "button_link",
					"label": "t:sections.all.button.link.label"
				},
				{
					"type": "select",
					"id": "button_style",
					"options": [
						{
							"value": "primary",
							"label": "t:sections.all.button.style.options__1.label"
						},
						{
							"value": "secondary",
							"label": "t:sections.all.button.style.options__2.label"
						},
						{
							"value": "tertiary",
							"label": "t:sections.all.button.style.options__3.label"
						}
					],
					"default": "primary",
					"label": "t:sections.all.button.style.label"
				}
			]
		},
    {
      "type": "download",
      "name": "Download PDF",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Download PDF"
        }
      ]
    }
	],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Section link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
        "type": "color",
        "id": "background_color_banner",
        "label": "Background Color Banner",
        "default": "#F6F6F6"
    },
    {
      "type": "checkbox",
      "id": "including_breadcrumbs",
      "label": "Including breadcrumbs",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "change_letter_space_heading",
      "label": "Change letter spacing of heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Download file"
    },
    {
      "type": "text",
      "id": "download_file",
      "label": "PDF file (paste link from Content → Files)"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "number",
      "id": "padding_top",
      "default": 80,
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "number",
      "id": "padding_top_mb",
      "default": 50,
      "label": "Padding Top Mobile"
    },
    {
      "type": "number",
      "id": "padding_bottom",
      "default": 80,
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "number",
      "id": "padding_bottom_mb",
      "default": 50,
      "label": "Padding Bottom Mobile"
    }
  ],
  "presets": [
    {
      "name": "Mos Header Banner",
      "blocks": [
            {
                "type": "subheading"
            },
            {
                "type": "text"
            }
        ]
    }
  ]
}
{% endschema %}
