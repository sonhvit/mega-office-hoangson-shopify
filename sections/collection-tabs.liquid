{{ 'collection-tabs.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-tabs.js' | asset_url }}" defer="defer"></script>

{% style %}
	{% render 'section-padding' %}
	{% render 'section-margin' %}
	#shopify-section-{{ section.id }} {
		--per-row: {{ section.settings.per_row }};
	}
{% endstyle %}

{% liquid
	case section.settings.image_size
		when 'adapt'
			assign section_size = 0
		when 'small'
			assign section_size = '30vh'
		when 'medium'
			assign section_size = '60vh'
		when 'large'
			assign section_size = '100vh'
		else
			assign section_size = '100vh'
	endcase
%}
{% liquid
	assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
	assign adapt_height = 1 | divided_by: section.settings.image.aspect_ratio | times: 100 | append: '%'
	if section.settings.image_size == 'adapt'
		assign section_size = adapt_height
	endif
%}
{% liquid
	assign slideshow_speed = section.settings.slideshow_speed
	assign slideshow_delay = section.settings.slideshow_delay
	assign autoplay = section.settings.autoplay
	assign stop_autoplay = section.settings.stop_autoplay
	assign show_arrows = section.settings.show_arrows
	assign layout = section.settings.layout
	assign per_row = section.settings.per_row
	assign show_two_cards = section.settings.show_two_cards
	assign mobile = 1
	if show_two_cards
		assign mobile = 2
	endif
%}
{% assign count = 0 %}
{% for block in section.settings.collection_list %}
	{% assign count = count | plus: 1 %}
{% endfor %}
{%- style -%}
	#shopify-section-{{ section.id }} {
		--image-height : {{ section_size }};
		--per-row: {{ section.settings.per_row }};
			--slide_duration : {{ slideshow_delay }}s;
	}
{%- endstyle -%}
{% assign section_id = 'shopify-section-' | append: section.id %}

<div
	class="collection-tabs"
	data-id="shopify-section-{{ section.id }}"
	data-id="{{ section_id }}"
	data-speed="{{ slideshow_speed }}"
	data-delay="{{ slideshow_delay }}"
	data-autoplay="{{ autoplay }}"
	data-stop-autoplay="{{ stop_autoplay }}"
	data-show-arrows="{{ show_arrows }}"
	data-per-row="{{ per_row }}"
	data-mobile="{{ mobile }}"
	style="--slider-per-row : {{ per_row }}"
>
	<div class="container">
		<div class=" section-{{ section.id }}-padding">

							{%- if section.settings.heading != blank -%}
								<h2 class="section-header__title title--section h3">
									{{ section.settings.heading }}
								</h2>
							{% endif %}
							{% comment %}{%- if section.settings.description != blank -%}
								<div class="section-header__desc richtext__content extra-large-font {% if text_size == "large" %} large-font{% endif %}">
									{{ section.settings.description }}
								</div>
							{% endif %}{% endcomment %}

			<div class="collection-tabs-box">
				<div class="collection-tabs-wrapper ">
					<div class="collection-tabs-wrapper-list ">
						{%- if section.settings.collection_list != blank and count >= 2 -%}
							<ul class="collection-tabs-list">
								{%- for collection in section.settings.collection_list -%}
									{% if collection.products != blank %}
										<li
											data-tab-target="#collection-tab-slider-{{ forloop.index }}"
											class="large-font collections-tabs__card {% if forloop.index == 1 %} active{% endif %}"
											tabindex="0"
										>
											<span> {{ collection.title }}</span>
											{%  if collection.metafields.custom.collection_badge.value != blank %}
												{%  assign lCollections  =  collection.metafields.custom.collection_badge.value %}
												<div class="collections-tabs__card_metafields extra-small-font" style="background-color: {{ lCollections.background_color }}; color: {{ lCollections.text_color }};">
													{{ lCollections.text }}
												</div>
											{%  endif %}
										</li>
									{% endif %}
								{%- endfor -%}
							</ul>
						{% endif %}
						{% render 'button',
							btn_link: section.settings.button_link,
							btn_label: section.settings.button_label,
							btn_style: section.settings.button_style
						%}
					</div>
		
					{%- if section.settings.collection_list != blank -%}
						<div class="collection-tabs_product-item  " >
							{% assign realIndex = 0 %}
							{%- for collection in section.settings.collection_list -%}
								{% assign realIndex = realIndex | plus: 1 %}
								<div class="collection-tabs-mySwiper {% if realIndex == 1 %} active{% endif %}  {% if section.settings.collection_list != blank and count >= 2 %} collection-tabs_collection-none{% endif %}" 
									id="collection-tab-slider-{{ forloop.index }}" data-tab-content>
								{% if collection.products != blank %}
								
									<div class="collection-slider__swiper {% if section.settings.layout == 'slider' %} swiper mySwiper {% endif %}">
									<div
										class=" {% if section.settings.layout == 'slider' %} swiper-wrapper {% else %}products-no-slider collection-tabs_card-item {% endif %} {% if section.settings.show_two_cards == true %} collection-product-list--2-mobile{% endif %}">
										{% for product in collection.products
											limit: section.settings.product_count
										%}
											<div class="collection-tabs_card {% if section.settings.layout == 'slider' %} swiper-slide {% endif %} ">
												{% render 'product-card-big',
													product_card_product: product,
													media_size: section.settings.image_ratio,
													media_fit: section.settings.media_fit,
													show_secondary_image: section.settings.show_secondary_image,
													show_vendor: section.settings.show_vendor,
													show_collection_name: section.settings.show_collection_name
													show_desc: section.settings.show_desc,
													show_inventory: section.settings.show_inventory
													show_color_swatch: section.settings.show_color_swatch,
													show_badge: section.settings.show_badge,
													section_id: section_id,
													show_sku: section.settings.show_sku,
													unique_id_part: collection.handle
												%}
											</div>
										{% endfor %}
									</div>
							
								</div>
								{% if show_arrows and layout == 'slider' %}
								<button class="swiper-button swiper-button-prev swiper-button-disabled ">
									{%- render 'icon-swiper-next' -%}
								</button>
								<button class="swiper-button swiper-button-next">
									{%- render 'icon-swiper-next' -%}
								</button>
				
								<div class="swiper-pagination swiper-pagination-1 swiper-pagination-default {% if section.settings.enable_autoplay == false %} not-autoplay{% else %} bullet-autoplay{% endif %}"></div>
							{% endif %}
								{% endif %}
							</div>
							{%- endfor -%}
						</div>
					{%- else -%}
						<div class="collection-tabs-placeholder-item">
						
							{%- for i in (1..3) -%}
									{% assign placeholder_count = forloop.index | modulo: 4 | plus: 1 %}
								<div class="collection-tabs-placeholder">
									{% render 'product-card-placeholder',
										media_size: section.settings.image_ratio,
										placeholder_index: placeholder_count
									%}
								</div>
							{% endfor %}
						</div>
					{% endif %}
				</div>
	
	
			</div>
		
		</div>
	</div>
</div>
<script>
	(function () {
		function adjustButtonPosition(height) {
			document
				.querySelectorAll(
					`#shopify-section-{{ section.id }} .swiper-button`
				)
				.forEach((button) => {
					button.style.top = height / 2 + 'px';
				});
		}
		function changePosition() {
			if (window.innerWidth < 1150) return;
			const image = document.querySelector(
				`#shopify-section-{{ section.id }} .media  img`
			);
			if (image) {
				if (image.tagName === 'IMG') {
					if (image.complete) {
						adjustButtonPosition(image.offsetHeight);
					} else {
						image.addEventListener('load', function () {
							adjustButtonPosition(this.offsetHeight);
						});
					}
				} else if (image.tagName === 'svg') {
					const height = image.getBoundingClientRect().height;
					adjustButtonPosition(height);
				}
			}
		}
		changePosition();
		document.addEventListener(
			'shopify:section:load',
			changePosition
		);
		let resizeTimeout;
		window.addEventListener('resize', function () {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(changePosition, 100);
		});
	})();
</script>
{% schema %}
{
	"name": "t:sections.collection_tabs.name",
	"tag": "section",
	"class": "collection-tabs-section spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "range",
			"id": "per_row",
			"min": 2,
			"max": 4,
			"step": 1,
			"default": 3,
			"label": "t:sections.all.column_per_row.label",
			"info": "t:sections.all.column_per_row.info"
		},
		{
			"type": "select",
			"id": "layout",
			"options": [
				{
					"value": "slider",
					"label": "t:sections.banner-slider.settings.layout.options__1.label"
				},
				{
					"value": "static",
					"label": "t:sections.banner-slider.settings.layout.options__2.label"
				}
			],
			"default": "slider",
			"label": "t:sections.banner-slider.settings.layout.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "Name the Section",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.button.header.content"
		},
		{
			"type": "text",
			"id": "button_label",
			"default": "Shop Now",
			"label": "t:sections.all.button.label.label",
			"info": "t:sections.all.button.label.info"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "t:sections.all.button.link.label"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.style.options__2.label"
				},
				{
					"value": "tertiary",
					"label": "t:sections.all.button.style.options__3.label"
				}
			],
			"default": "tertiary",
			"label": "t:sections.all.button.style.options__1.label"
		},
		{
			"type": "header",
			"content": "t:sections.collection_tabs.collection_list.label"
		},
		{
			"type": "collection_list",
			"id": "collection_list",
			"label": "Collections",
			"limit": 6
		},
		{
			"type": "range",
			"id": "product_count",
			"min": 1,
			"max": 12,
			"step": 1,
			"default": 4,
			"label": "t:sections.collection_tabs.product_count.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.slider_options.header.content"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "t:sections.all.slider_options.slider_is_autoplay.label"
		},
		{
			"type": "checkbox",
			"id": "stop_autoplay",
			"default": true,
			"label": "t:sections.all.slider_options.slider_hover_autoplay_stop.label"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "t:sections.all.slider_options.navigation.label"
		},
		{
			"type": "range",
			"id": "slideshow_speed",
			"min": 0.1,
			"max": 6,
			"step": 0.1,
			"default": 1.1,
			"unit": "s",
			"label": "t:sections.all.slider_options.speed.label"
		},
		{
			"type": "range",
			"id": "slideshow_delay",
			"min": 0.1,
			"max": 8,
			"step": 0.1,
			"default": 3,
			"unit": "s",
			"label": "t:sections.all.slider_options.delay.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.product_card.header.content"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "landscape",
					"label": "t:sections.all.image.ratio.options__1.label"
				},
				{
					"value": "portrait",
					"label": "t:sections.all.image.ratio.options__2.label"
				},
				{
					"value": "square",
					"label": "t:sections.all.image.ratio.options__3.label"
				}
			],
			"default": "square",
			"label": "t:sections.all.image.ratio.label"
		},
		{
			"type": "checkbox",
			"id": "show_secondary_image",
			"default": true,
			"label": "t:sections.all.product_card.show_secondary_image.label"
		},
		{
			"type": "checkbox",
			"id": "show_badge",
			"default": true,
			"label": "t:sections.all.simple_price.show_badge.label"
		},	
		{
			"type": "checkbox",
			"id": "show_sku",
			"default": false,
			"label": "t:sections.all.sku.show_sku"
		},
		{
			"type": "checkbox",
			"id": "show_vendor",
			"default": false,
			"label": "t:sections.all.product_card.show_vendor.label"
		},
		{
			"type": "checkbox",
			"id": "show_collection_name",
			"default": true,
			"label": "t:sections.all.product_card.show_colection_name.label"
		},
		{
			"type": "checkbox",
			"id": "show_color_swatch",
			"default": false,
			"label": "t:sections.all.product_card.show_color.label"
		},
		{
			"type": "checkbox",
			"id": "show_inventory",
			"default": true,
			"label": "t:sections.all.product_card.show_inventory.label"
		},
		{
			"type": "checkbox",
			"id": "show_desc",
			"default": false,
			"label": "t:sections.all.product_card.show_description.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
