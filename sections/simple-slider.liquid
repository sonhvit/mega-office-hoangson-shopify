{{ 'simple-slider.css' | asset_url | stylesheet_tag }}

<script src="{{ 'simple-slider.js' | asset_url }}" defer="defer"></script>

{{ 'section-popular-products.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<link
  rel="preload"
  href="{{ 'component-badge.css' | asset_url }}"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
>

<script src="{{ 'product-slider.js' | asset_url }}" defer="defer"></script>

{% style %}
	{% render 'section-margin' %}
	#shopify-section-{{ section.id }} {
		--per-row: {{ section.settings.per_row }};
	}
{% endstyle %}

{% assign product_list = section.settings.product_list %}
{% assign section_id = 'shopify-section-' | append: section.id %}

{% liquid
	if section.settings.show_arrows
		assign show_arrows = true
	else
		assign show_arrows = false
	endif
%}
{% liquid
	assign slideshow_speed = section.settings.slideshow_speed
	assign slideshow_delay = section.settings.slideshow_delay
	assign autoplay = section.settings.is_autoplay
	assign stop_autoplay = section.settings.stop_autoplay
	assign show_arrows = section.settings.show_arrows
	assign per_row = section.settings.per_row
	assign media_size = section.settings.image_ratio
	assign media_fit = section.settings.image_fit
	assign show_secondary_image = section.settings.show_secondary_image
	assign show_vendor = section.settings.show_vendor
	assign show_tags = section.settings.show_tags
	assign show_type = section.settings.show_type
	assign show_desc = section.settings.show_desc
	assign show_color_swatch = section.settings.show_color_swatch
	assign show_collection_name = section.settings.show_collection_name
	assign show_sku = section.settings.show_sku
	assign show_two_cards = section.settings.show_two_cards
	assign show_inventory = section.settings.show_inventory
	assign product_variant_type = slider_settings.product_variant_type
	assign layout = slider_settings.layout
	assign mobile = 1
	if show_two_cards
		assign mobile = 2
	endif
%}
{% style %}

	#shopify-section-{{ section.id }} {
		--slide_duration : {{ slideshow_delay }}s;
	}
{% endstyle %}
<div class="simple-slider container"
	data-id="{{ section_id }}"
	data-speed="{{ slideshow_speed }}"
	data-delay="{{ slideshow_delay }}"
	data-autoplay="{{ autoplay }}"
	data-stop-autoplay="{{ stop_autoplay }}"
	data-show-arrows="{{ show_arrows }}"
	data-per-row="{{ per_row }}"
	data-mobile="{{ mobile }}"
	style="--slider-per-row : {{ per_row }}"
>
	<div class=" color-{{ section.settings.color_scheme }} background ">
	
	<div class="container-small">
		<div class="simple-slider-content">
			<div class="simple-slider-content-box">
				{% if section.settings.badege_text != blank or section.settings.badge_image != blank %}
				<div class="simple-slider--details {% if section.settings.badege_text == blank  %} flex-end {% endif %}">
					
						<div
							class="simple-slider--details__badge"
							style="background: {{ section.settings.badge_bg_color }}"
						>
							{%- if section.settings.badge_image != blank -%}
								{{
									section.settings.badge_image
									| image_url: width: section.settings.badge_image.width
									| image_tag:
										loading: 'lazy',
										sizes: '100vw',
										widths: '550, 720',
										height: 16,
										width: 16,
										class: 'banner-slider__badge_image'
								}}
							{% endif %}
							{% if section.settings.badege_text != blank %}
								<span
									class="banner-slider__badge_text extra-small-font"
									style="color: {{ section.settings.badge_text_color }}"
								>
									{{ section.settings.badege_text  | strip_html | truncate: 25 }}
								</span>
							{% endif %}
						</div>
					
				</div>
				{% endif %}
				{%- if section.settings.heading != blank -%}
					<h2 class="simple-slider__heading ">
						{{ section.settings.heading }}
					</h2>
				{%- endif -%}
			</div>
		{%- if section.settings.badge_subheading != blank or section.settings.badge_heading != blank or section.settings.enable_prefix != blank or section.settings.enable_new != blank-%}
			{%- render 'simple-price', layout: section -%}
				{%- endif -%}
		</div>
		<div class="products-slider__container">
	
					<div class="products-slider__wrapper">

						<div class="products-slider__swiper  swiper mySwiper ">
							<div class="products-slider__swiper-wrapper  swiper-wrapper">
								{% for product in product_list %}
									<div
										data-type="{{ product.type }}"
										class="products-slider__slide {% if settings.quickview_hover %}quickview--hover{% endif %}  swiper-slide"
									>
										{% render 'product-card',
											product_card_product: product,
											media_size: media_size,
											media_fit: media_fit,
											show_secondary_image: show_secondary_image,
											show_vendor: show_vendor,
											show_desc: show_desc,
											show_inventory: show_inventory,
											show_color_swatch: show_color_swatch,
											show_collection_name: show_collection_name,
											show_tags: show_tags,
											show_type: show_type,
											product_variant_type: product_variant_type,
											section_id: section_id,
											show_sku: show_sku
										%}
									</div>
								{%- else -%}
									{%- for i in (1..6) -%}
																			{% assign placeholder_count = forloop.index | modulo: 4 | plus: 1 %}
										<div class="products-slider__slide swiper-slide product-card-placeholder">
											{% render 'product-card-placeholder', media_size: media_size , placeholder_index: placeholder_count %}
										</div>
									{% endfor %}
								{% endfor %}
							</div>
						</div>
					</div>
					{% if show_arrows  %}
					<button class="swiper-button swiper-button-prev swiper-button-disabled">
						{%- render 'icon-swiper-next' -%}
					</button>
					<button class="swiper-button swiper-button-next">
						{%- render 'icon-swiper-next' -%}
					</button>
					<script>
						(function () {
							function changePosition() {
								if(window.innerWidth < 1150) return;
								const image = document.querySelectorAll(
									`#{{ section_id }} .swiper .product-card .media img`
								)[0];
								if (image) {
									image.addEventListener('load', function () {
										const height = this.offsetHeight;
										document
											.querySelectorAll(`#{{ section_id }} .swiper-button`)
											.forEach((button) => {
												button.style.top = height / 2 + 'px';
											});
									});
								}
							}
							changePosition();
							document.addEventListener('shopify:section:load', function () {
								changePosition();
							});
							window.addEventListener('resize', function () {
								changePosition();
							});
						})();
					</script>
					<div class="swiper-pagination swiper-pagination-1 swiper-pagination-default {% if section.settings.enable_autoplay == false %} not-autoplay{% else %} bullet-autoplay{% endif %}"></div>
				{% endif %}
		</div>
	</div>
</div>
</div>

{% schema %}
{
	"name": "t:sections.simple-slider.name",
	"tag": "section",
	"class": "simple-slider-section spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-2",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "product_list",
			"id": "product_list",
			"limit": 12,
			"label": "t:sections.all.product_card.product_list.label"
		},
		{
			"type": "range",
			"id": "per_row",
			"min": 2,
			"max": 6,
			"step": 1,
			"default": 5,
			"label": "t:sections.all.column_per_row.label",
			"info": "t:sections.all.column_per_row.info"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "A short introduction to the most popular products",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "header",
			"content": "t:sections.banner-slider.blocks.column.settings.header__1.label"
		},
		{
			"type": "color",
			"id": "badge_bg_color",
			"label": "t:sections.all.background_color.label",
			"default": "#FC3535"
		},
		{
			"type": "color",
			"id": "badge_text_color",
			"label": "t:sections.banner-slider.blocks.column.settings.badge_text_color.label",
			"default": "#FFFFFF"
		},
		{
			"type": "text",
			"id": "badege_text",
			"default": "Sale",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "image_picker",
			"id": "badge_image",
			"label": "t:sections.all.icon_pack.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.simple_price.badge_header.label"
		},
		{
			"type": "text",
			"id": "badge_subheading",
			"default": "-5%",
			"label": "t:sections.all.simple_price.sale.label"
		},
		{
			"type": "text",
			"id": "badge_heading",
			"default": "$68,00",
			"label": "t:sections.all.simple_price.old.label"
		},
		{
      "type": "inline_richtext",
      "id": "enable_prefix",
      "default": "$",
      "label": "t:sections.all.simple_price.prefix.label"
    },
		{
			"type": "inline_richtext",
			"id": "enable_new",
			"default": "48,50",
			"label": "t:sections.all.simple_price.new.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.slider_options.header.content"
		},
		{
			"type": "checkbox",
			"id": "is_autoplay",
			"default": false,
			"label": "t:sections.all.slider_options.slider_is_autoplay.label"
		},
		{
			"type": "checkbox",
			"id": "stop_autoplay",
			"default": true,
			"label": "t:sections.all.slider_options.slider_hover_autoplay_stop.label"
		},
		{
			"type": "checkbox",
			"id": "show_arrows",
			"default": true,
			"label": "t:sections.all.slider_options.navigation.label"
		},
		{
			"type": "range",
			"id": "slideshow_speed",
			"min": 0.1,
			"max": 6,
			"step": 0.1,
			"default": 1.1,
			"unit": "s",
			"label": "t:sections.all.slider_options.speed.label"
		},
		{
			"type": "range",
			"id": "slideshow_delay",
			"min": 0.1,
			"max": 8,
			"step": 0.1,
			"default": 3,
			"unit": "s",
			"label": "t:sections.all.slider_options.delay.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.product_card.header.content"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "landscape",
					"label": "t:sections.all.image.ratio.options__1.label"
				},
				{
					"value": "portrait",
					"label": "t:sections.all.image.ratio.options__2.label"
				},
				{
					"value": "square",
					"label": "t:sections.all.image.ratio.options__3.label"
				}
			],
			"default": "portrait",
			"label": "t:sections.all.image.ratio.label"
		},
		{
			"type": "select",
			"id": "image_fit",
			"label": "t:sections.all.image.fit.label",
			"default": "cover",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.image.fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.image.fit.options__2.label"
				}
			]
		},
		{
			"type": "checkbox",
			"id": "show_two_cards",
			"default": true,
			"label": "t:sections.all.product_card.mobile_card_count.label"
		},
		{
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "t:sections.products-grid.settings.show_secondary_image.label"
    },
		{
			"type": "checkbox",
			"id": "show_sku",
			"default": false,
			"label": "t:sections.all.sku.show_sku"
		},
		{
			"type": "checkbox",
			"id": "show_vendor",
			"default": false,
			"label": "t:sections.all.product_card.show_vendor.label"
		},
		{
			"type": "checkbox",
			"id": "show_collection_name",
			"default": true,
			"label": "t:sections.all.product_card.show_colection_name.label"
		},
		{
			"type": "checkbox",
			"id": "show_color_swatch",
			"default": false,
			"label": "t:sections.all.product_card.show_color.label"
		},
		{
			"type": "checkbox",
			"id": "show_inventory",
			"default": true,
			"label": "t:sections.all.product_card.show_inventory.label"
		},
		{
			"type": "checkbox",
			"id": "show_desc",
			"default": false,
			"label": "t:sections.all.product_card.show_description.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-margin.header.content"
		},
		{
			"type": "select",
			"id": "margin_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
			],
			"default": "no-indent",
			"label": "t:sections.all.section-margin.margin_top.label"
		},
		{
			"type": "select",
			"id": "margin_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-margin.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-margin.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-margin.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-margin.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-margin.options__5.label"
				},
				{
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
			],
			"default": "xs",
			"label": "t:sections.all.section-margin.margin_bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.simple-slider.presets.name"
		}
	]
}
{% endschema %}
