{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'countdown.js' | asset_url }}" defer="defer"></script>

{% style %}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{% endstyle %}

{% liquid
  assign slideshow_speed = section.settings.slideshow_speed
  assign slideshow_delay = section.settings.slideshow_delay
  assign image_size = section.settings.height
  assign image_size_mobile = section.settings.height_mobile

  case image_size
    when 'adapt'
      if section.blocks[0].settings.image != blank and section.blocks[0].settings.show_video == false
        assign section_size = 1 | divided_by: section.blocks[0].settings.image.aspect_ratio | times: 100 | append: '%'
      elsif section.blocks[0].settings.show_video == true and section.blocks[0].settings.video
        assign section_size = 1 | divided_by: section.blocks[0].settings.video.aspect_ratio | times: 100 | append: '%'
      endif
      assign slide_class = image_size
    when '1/1'
      assign section_size = '100%'
      assign slide_class = image_size
    when '3/2'
      assign section_size = '56.25%'
      assign slide_class = image_size
    when '4/3'
      assign section_size = '75%'
      assign slide_class = image_size
    when '5/3'
      assign section_size = '28.4%'
      assign slide_class = image_size
    when '16/9'
      assign section_size = '56.25%'
      assign slide_class = image_size
    when '21/9'
      assign section_size = '42.8%'
      assign slide_class = image_size
    when 'large'
      assign section_size = 'calc(100vh - var(--header-height))'
      assign slide_class = image_size
    else
      assign section_size = 'calc(100vh - var(--header-height))'
      assign slide_class = image_size
  endcase

  case image_size_mobile
    when 'adapt'
      if section.blocks[0].settings.mobile_image != blank and section.blocks[0].settings.show_video == false
        assign section_size_mobile = 1 | divided_by: section.blocks[0].settings.mobile_image.aspect_ratio | times: 100 | append: '%'
      elsif section.blocks[0].settings.show_video == true and section.blocks[0].settings.video
        assign section_size_mobile = 1 | divided_by: section.blocks[0].settings.video.aspect_ratio | times: 100 | append: '%'
      endif
    when '1/1'
      assign section_size_mobile = '100%'
    when '3/2'
      assign section_size_mobile = '56.25%'
    when '4/3'
      assign section_size_mobile = '75%'
    when '5/3'
      assign section_size_mobile = '28.4%'
    when '16/9'
      assign section_size_mobile = '56.25%'
    when '21/9'
      assign section_size_mobile = '42.8%'
    when 'large'
      assign section_size_mobile = 'calc(100vh - var(--header-height))'
    else
      assign section_size_mobile = 'calc(100vh - var(--header-height))'
  endcase
%}

{% liquid
  assign timezone = 'now' | date: '%Z' | plus: 0 | append: ''

  if timezone.size > 1
    assign timezone = 'now' | date: '%Z' | divided_by: 100 | times: 3600.0 | plus: 1800
  else
    assign timezone = 'now' | date: '%Z' | minus: 1 | times: 3600.0
  endif

  assign date_merge = section.blocks[0].settings.date_picker | append: '-' | append: section.blocks[0].settings.time_picker | append: ':00'
  assign date_now = 'now' | date: '%s' | minus: 0
  assign date_settings = date_merge | date: '%s' | minus: 0

  if date_now < date_settings
    assign distance = date_settings | minus: date_now
    assign days = distance | divided_by: 3600 | divided_by: 24 | floor | append: ''
    assign hours = distance | modulo: 86400 | divided_by: 3600 | floor | append: ''
    assign minutes = distance | modulo: 3600 | divided_by: 60 | floor | append: ''
    assign seconds = distance | modulo: 60 | floor | append: ''
  else
    assign days = '00'
    assign hours = '00'
    assign minutes = '00'
    assign seconds = '00'
  endif
%}

<div
  class="
    slideshow {{ slide_class }} section-{{ section.id }}-padding
    color-{{ section.settings.color_scheme }} background
    {% if section.settings.enable_navigation  %} slideshow--with-nav {% endif %}
  "
>
  {% render 'section-header', section: section %}

  {% style %}
    #shopify-section-{{ section.id }} {
      --slide-height: {{ section_size_mobile }};
      --delay : {{ slideshow_delay }}s;
      --speed : {{ slideshow_speed }}s;
    }
		@media screen and (min-width: 576px) {
      #shopify-section-{{ section.id }} {
				--slide-height: {{ section_size }};
			}
    }
  {% endstyle %}
  <div class="content">
    <div
      {% if section.settings.full_width == false %}
        class="container"
      {% endif %}
    >
      <div class="slideshow__container">
        <div
          class="
            slideshow__swiper slideshow__swiper--simple
            {% if section.settings.full_width == true %}slideshow__swiper--full-width{% endif %} swiper
          "
          data-autoplay="{{ section.settings.enable_autoplay }}"
          data-loop="false"
          data-navigation="{{ section.settings.enable_navigation }}"
          data-pagination="{{ section.settings.enable_pagination }}"
        >
          {% style %}
            #shopify-section-{{ section.id }} {
              --slide-height: {{ section_size_mobile }};
              --delay : {{ slideshow_delay }}s;
              --speed : {{ slideshow_speed }}s;
              --slide_duration : {{ section.settings.slide_duration }}s;
            }
						@media screen and (min-width: 576px) {
							#shopify-section-{{ section.id }} {
								--slide-height: {{ section_size }};
							}
						}
          {% endstyle %}

          <div class="slideshow__wrapper swiper-wrapper">
            {% for block in section.blocks %}
              {% liquid
                assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio
              %}
								{% if block.settings.color_scheme != block.settings.color_scheme_mobile %}
									<style>
										@media screen and (max-width: 989.9px) {
											{% assign scheme = block.settings.color_scheme_mobile %}

											[data-scheme=light] .slideshow__slide-{{ block.id }}.color-{{ block.settings.color_scheme }} {
												--color-background: {{ scheme.settings.colors_background_1.red }},{{ scheme.settings.colors_background_1.green }},{{ scheme.settings.colors_background_1.blue }};
												--color-background-secondary: {{ scheme.settings.colors_background_2.red }},{{ scheme.settings.colors_background_2.green }},{{ scheme.settings.colors_background_2.blue }};
												{% if scheme.settings.background_gradient != empty %}
													--gradient-background: {{ scheme.settings.background_gradient }};
												{% else %}
													--gradient-background: {{ scheme.settings.colors_background_1 }};
												{% endif %}
												--color-foreground: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{ scheme.settings.colors_text.blue }};
												--color-foreground-secondary: {{ scheme.settings.colors_secondary_text.red }}, {{ scheme.settings.colors_secondary_text.green }}, {{ scheme.settings.colors_secondary_text.blue }};
												--color-foreground-title: {{ scheme.settings.colors_text_title.red }}, {{ scheme.settings.colors_text_title.green }}, {{ scheme.settings.colors_text_title.blue }};
												--color-overlay: {{ scheme.settings.colors_background_overlay.red }},{{ scheme.settings.colors_background_overlay.green }},{{ scheme.settings.colors_background_overlay.blue }};
												--color-accent: {{ scheme.settings.color_accent.red }}, {{ scheme.settings.color_accent.green }}, {{ scheme.settings.color_accent.blue }};
												--color-border: {{ scheme.settings.color_border.red }}, {{ scheme.settings.color_border.green }}, {{ scheme.settings.color_border.blue }};
											}

											@media (prefers-color-scheme: light) {
												[data-scheme=auto] .slideshow__slide-{{ block.id }}.color-{{ block.settings.color_scheme }} {
													--color-background: {{ scheme.settings.colors_background_1.red }},{{ scheme.settings.colors_background_1.green }},{{ scheme.settings.colors_background_1.blue }};
													--color-background-secondary: {{ scheme.settings.colors_background_2.red }},{{ scheme.settings.colors_background_2.green }},{{ scheme.settings.colors_background_2.blue }};
													{% if scheme.settings.background_gradient != empty %}
														--gradient-background: {{ scheme.settings.background_gradient }};
													{% else %}
														--gradient-background: {{ scheme.settings.colors_background_1 }};
													{% endif %}
													--color-foreground: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{ scheme.settings.colors_text.blue }};
													--color-foreground-secondary: {{ scheme.settings.colors_secondary_text.red }}, {{ scheme.settings.colors_secondary_text.green }}, {{ scheme.settings.colors_secondary_text.blue }};
													--color-foreground-title: {{ scheme.settings.colors_text_title.red }}, {{ scheme.settings.colors_text_title.green }}, {{ scheme.settings.colors_text_title.blue }};
													--color-overlay: {{ scheme.settings.colors_background_overlay.red }},{{ scheme.settings.colors_background_overlay.green }},{{ scheme.settings.colors_background_overlay.blue }};
													--color-accent: {{ scheme.settings.color_accent.red }}, {{ scheme.settings.color_accent.green }}, {{ scheme.settings.color_accent.blue }};
													--color-border: {{ scheme.settings.color_border.red }}, {{ scheme.settings.color_border.green }}, {{ scheme.settings.color_border.blue }};
												}
											}
										}
									</style>
								{% endif %}
              <div
                class="
                  slideshow__slide slideshow__slide--overlay swiper-slide
                  slideshow__slide--{{ section.settings.height }}
                  slideshow__slide-{{ block.id }} color-{{ block.settings.color_scheme }}
                "
                data-swiper-autoplay="{{ section.settings.slide_duration | times: 1000 }}"
                {{ block.shopify_attributes }}
              >
                {%- case block.type -%}
                  {%- when 'slide' -%}
										
                    {% if block.settings.heading != blank
                      or block.settings.description != blank
                      or block.settings.button_label != blank
                      or block.settings.enable_badge
                      or block.settings.enable_countdown
                    %}
                      {% if section.settings.full_width %}
                        <div class="container ">
                      {% endif %}
                      <div
                        class="slideshow__content-wrapper   {% if block.settings.enable_badge == false %}  slideshow__content-wrapper--{{ block.settings.text_alignment }}{% endif %}"
                        data-swiper-parallax="-700"
                      >
                        {% comment %} hide_section {% endcomment %}
                        <div class="slideshow__content-group slideshow__content-group--{{ block.settings.image_variant }}">
                          <div class="slideshow__content-group__info {% if block.settings.enable_countdown == false or block.settings.completed_countdown == "hide_section" or block.settings.countdown_heading == false %} to-top-heading {% endif %}">
                            {% if block.settings.badege_text != blank %}
                              <div
                                class="slideshow__content-group__info__badge"
                                style="background: {{ block.settings.badge_bg_color }}"
                              >
                                {%- if block.settings.badge_image != blank -%}
                                  {{
                                    block.settings.badge_image
                                    | image_url: width: block.settings.badge_image.width
                                    | image_tag:
                                      loading: 'lazy',
                                      sizes: '100vw',
                                      widths: '550, 720',
                                      height: 16,
                                      width: 16,
                                      class: 'slideshow__content-group__info__badge_image'
                                  }}
                                {% endif %}
                                {% if block.settings.badege_text != blank %}
                                  <span
                                    class="slideshow__content-group__info__badge_text extra-small-font"
                                    style="color: {{ block.settings.badge_text_color }}"
                                  >
                                    {{ block.settings.badege_text }}
                                  </span>
                                {% endif %}
                              </div>
                            {% endif %}
                            {% if block.settings.enable_countdown != false %}
                              {%- if block.settings.date_picker != blank or block.settings.countdown_heading -%}
                                <countdown-timer
                                  class="js-countdown slideshow-countdown js-countdown-{{ block.id }}"
                                  data-date="{{ block.settings.date_picker }}"
                                  data-time="{{ block.settings.time_picker }}"
																	data-enable-mock-timer="{{ block.settings.enable_mock_timer | default: false }}"
																	data-enable-mock-picker-day="{{ block.settings.mock_date_picker_day | default: 2 }}"
																	data-enable-mock-picker-hours="{{ block.settings.mock_date_picker_hours | default: 3 }}"
                                  data-completed="{{ block.settings.completed_countdown }}"
                                >
                                  {%- if block.settings.date_picker != blank or block.settings.countdown_heading -%}
                                    <div class="slideshow-countdown__content countdown-section">
                                      {%- if block.settings.date_picker != blank -%}
                                        <div class="slideshow-countdown__content--main countdown__main">
                                          {% render 'icon-timer' %}
                                          <div class="slideshow-countdown__content--main__block">
                                            <span class="countdown_block_days large-font">
                                              {% if days.size > 1 %}
                                                {{ days }}
                                              {% else %}
                                                {{ 0 | append: days }}
                                              {% endif %}
                                            </span>
                                            <span class="countdown_block_suffix">
                                              {{- 'general.slideshow_countdown.days' | t }}
                                            </span>
                                          </div>
                                          {% render 'icon-colon' %}
                                          <div class="slideshow-countdown__content--main__block">
                                            <span class="countdown_block_hours large-font">
                                              {% if hours.size > 1 %}
                                                {{ hours }}
                                              {% else %}
                                                {{ 0 | append: hours }}
                                              {% endif %}
                                            </span>
                                            <span class="countdown_block_suffix">
                                              {{- 'general.slideshow_countdown.hours' | t -}}
                                            </span>
                                          </div>
                                          {% render 'icon-colon' %}
                                          <div class="slideshow-countdown__content--main__block">
                                            <span class="countdown_block_minutes large-font">
                                              {% if minutes.size > 1 %}
                                                {{ minutes }}
                                              {% else %}
                                                {{ 0 | append: minutes }}
                                              {% endif %}
                                            </span>
                                            <span class="countdown_block_suffix">
                                              {{- 'general.slideshow_countdown.minutes' | t -}}
                                            </span>
                                          </div>
                                          {% render 'icon-colon' %}
                                          <div class="slideshow-countdown__content--main__block">
                                            <span class="countdown_block_seconds large-font">
                                              {% if seconds.size > 1 %}
                                                {{ seconds }}
                                              {% else %}
                                                {{ 0 | append: seconds }}
                                              {% endif %}
                                            </span>
                                            <span class="countdown_block_suffix">
                                              {{- 'general.slideshow_countdown.seconds' | t -}}
                                            </span>
                                          </div>
                                        </div>
                                      {%- endif -%}
                                      {% if block.settings.countdown_heading %}
                                        <div class="countdown__end-info">
                                          <h3 class="h3 countdown__end-info-text">
                                            {{ block.settings.countdown_heading }}
                                          </h3>
                                        </div>
                                      {% endif %}
                                    </div>
                                  {%- endif -%}
                                </countdown-timer>
                              {%- endif -%}
                            {% endif %}
                            {% if block.settings.heading != blank %}
                              <h2 class="slideshow__title-content {{ block.settings.heading_size }}">
                                {{ block.settings.heading }}
                              </h2>
                            {% endif %}
                            {% if block.settings.description != blank %}
                              <div class="slideshow__description-content">
                                {{ block.settings.description }}
                              </div>
                            {% endif %}
                          </div>
                          {% render 'button', layout: block, class: 'slideshow' %}
                        </div>
                        {% if block.settings.enable_badge != false %}
                          <div class="slideshow__content-badge">
                            {% render 'circle-badge', layout: block %}
                          </div>
                        {% endif %}
                      </div>
                      {% if section.settings.full_width %}
                        </div>
                      {% endif %}
                    {% endif %}

                      {% style %}
                        #shopify-section-{{ section.id }} .slideshow__slide-{{ block.id }} {
                          --overlay-opacity: {{ block.settings.overlay_opacity }};
													--overlay-opacity-mobile: {{ block.settings.overlay_opacity_mobile }}
                        }
                      {% endstyle %}
										{% if block.settings.overlay_link != blank %}
											<a class="slideshow__overlay-link" href="{{ block.settings.overlay_link }}"></a>
										{% endif %}
                    <div class="media media--{{ block.settings.image_variant }}">
                      <div class="slideshow__overlay"></div>
                      {%- if block.settings.image != blank and block.settings.show_video == false -%}
                       {% assign image_class = 'slideshow__image' %}
                        {% if block.settings.mobile_image == blank %}
                          {% assign image_class = image_class | append: ' one_image' %}
                        {% endif %}
                        {{
                          block.settings.image
                          | image_url: width: block.settings.image.width
                          | image_tag:
                            class: image_class,
                            loading: 'lazy',
                            width: block.settings.image.width,
                            height: image_height,
                            sizes: '100vw',
                            widths: '550, 720, 990, 1150, 1500, 1800, 2200, 2600, 3000'
                        }}
                      {%- endif -%}
                      {%- if block.settings.mobile_image != blank and block.settings.show_video == false -%}
                          {% assign mobile_image = 'slideshow__image slideshow__mobile_image' %}
                        {% if block.settings.image == blank %}
                          {% assign mobile_image = mobile_image | append: ' one_image' %}
                        {% endif %}
                        {{
                          block.settings.mobile_image
                          | image_url: width: block.settings.mobile_image.width
                          | image_tag:
                            class: mobile_image,
                            loading: 'lazy',
                            width: block.settings.mobile_image.width,
                            height: image_height,
                            sizes: '100vw',
                            widths: '550, 720, 990, 1150, 1500, 1800, 2200, 2600, 3000'
                        }}
                      {%- endif -%}

                      {%- if block.settings.show_video == true and block.settings.video -%}
                        <div
                          class="slideshow__video autoplay"
                          data-video-id="{{ block.settings.video.id }}"
                        >
                          {{
                            block.settings.video
                            | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false
                          }}
                        </div>
                      {%- endif -%}
                    </div>

                  {%- when 'slide_2' -%}
                    {% liquid
                      assign first_ticker_speed = block.settings.first_ticker_speed
                      assign second_ticker_speed = block.settings.second_ticker_speed
                    %}
                    {% style %}
                      #shopify-section-{{ section.id }} {
                        --first-ticker-speed : {{ first_ticker_speed }}s;
                        --second-ticker-speed : {{ second_ticker_speed }}s;
                      }
                    {% endstyle %}
                    {% if block.settings.first_ticker_heading != blank
                      or block.settings.second_ticker_heading != blank
                    %}
                      <div class="tickers_area">
                        <div class="ticker ticker_first ">
                          <div class="marquee ticker_container">
                            {%- if block.settings.first_ticker_heading != blank -%}
                              {% assign first_ticker_duration = block.settings.first_ticker_speed | times: 10 %}

                              <div
                                class="marquee-content {% if block.settings.first_ticker_enable %} marquee-content-paused {% endif %}"
                                style="background:{{ block.settings.first_ticker_background_color }}; animation-duration: {{ first_ticker_duration }}s "
                              >
                                {%- if block.settings.first_ticker_heading != blank -%}
                                  {% for i in (1..50) %}
                                    <div class="marquee-tag">
                                      <div class="ticker__title">
                                        <p
                                          class="ticker_heading large-font"
                                          style="color:{{ block.settings.first_ticker_heading_color }}"
                                        >
                                          {{ block.settings.first_ticker_heading }}
                                        </p>
                                      </div>
                                    </div>
                                  {% endfor %}
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                          </div>
                        </div>
                        {%- if block.settings.second_ticker_heading != blank -%}
                          <div class="ticker ticker_second">
                            <div class="marquee ticker_container">
                              {% assign second_ticker_duration = block.settings.second_ticker_speed | times: 10 %}
                              <div
                                class="marquee-content {% if block.settings.second_ticker_enable %} marquee-content-paused {% endif %}"
                                style="background:{{ block.settings.second_ticker_background_color }}; animation-duration: {{ second_ticker_duration }}s"
                              >
                                {%- if block.settings.second_ticker_heading != blank -%}
                                  {% for i in (1..50) %}
                                    <div class="marquee-tag">
                                      <div class="ticker__title">
                                        <p
                                          class="ticker_heading large-font"
                                          style="color:{{ block.settings.second_ticker_heading_color }}"
                                        >
                                          {{ block.settings.second_ticker_heading }}
                                        </p>
                                      </div>
                                    </div>
                                  {% endfor %}
                                {%- endif -%}
                              </div>
                            </div>
                          </div>
                        {%- endif -%}
                      </div>
                    {% endif %}
                         {% style %}
                        #shopify-section-{{ section.id }} .slideshow__slide-{{ block.id }} {
                          --overlay-opacity: {{ block.settings.overlay_opacity }};
													--overlay-opacity-mobile: {{ block.settings.overlay_opacity_mobile }}
                        }
                      {% endstyle %}
                    <div class="media">
                      {% if block.settings.overlay_link != blank %}
												<div class="slideshow__overlay"></div>
                        <a class="slideshow__overlay-link" href="{{ block.settings.overlay_link }}"></a>
                      {% else %}
                        <div class="slideshow__overlay"></div>
                      {% endif %}
                      {%- if block.settings.image != blank and block.settings.show_video == false -%}
                          {% assign image_class = 'slideshow__image' %}
                        {% if block.settings.mobile_image == blank %}
                          {% assign image_class = image_class | append: ' one_image' %}
                        {% endif %}
                        {{
                          block.settings.image
                          | image_url: width: block.settings.image.width
                          | image_tag:
                            class: image_class,
                            loading: 'lazy',
                            width: block.settings.image.width,
                            height: image_height,
                            sizes: '100vw',
                            widths: '550, 720, 990, 1150, 1500, 1800, 2200, 2600, 3000'
                        }}
                      {%- endif -%}
                      {%- if block.settings.mobile_image != blank and block.settings.show_video == false -%}
                          {% assign mobile_image = 'slideshow__image slideshow__mobile_image' %}
                        {% if block.settings.image == blank %}
                          {% assign mobile_image = mobile_image | append: ' one_image' %}
                        {% endif %}
                        {{
                          block.settings.mobile_image
                          | image_url: width: block.settings.mobile_image.width
                          | image_tag:
                            class: mobile_image,
                            loading: 'lazy',
                            width: block.settings.mobile_image.width,
                            height: image_height,
                            sizes: '100vw',
                            widths: '550, 720, 990, 1150, 1500, 1800, 2200, 2600, 3000'
                        }}
                      {%- endif -%}

                      {%- if block.settings.show_video == true and block.settings.video -%}
                        <div
                          class="slideshow__video autoplay"
                          data-video-id="{{ block.settings.video.id }}"
                        >
                          {{
                            block.settings.video
                            | video_tag: image_size: '1920x', autoplay: true, loop: true, muted: true, controls: false
                          }}
                        </div>
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {% endfor %}
          </div>
        </div>

        {% if section.blocks.size > 1 and section.settings.enable_navigation %}
          <div class="blog__navigation swiper-navigation no-js-hidden {% if section.settings.full_width == true %}swiper-navigation--full-width{% endif %}">
            <div class="swiper-button-disabled swiper-button-prev ">
              {% render 'icon-swiper-prev' %}
            </div>
            <div class="blog__button-next swiper-button-next ">
              {%- render 'icon-swiper-next' -%}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
    {% if section.blocks.size > 1 and section.settings.enable_pagination %}
      <div class="slideshow-bottom slider-pagiantion-bullet container {% if section.settings.enable_autoplay == false %} slideshow-bottom--centered {% endif %}">
        <div></div>
        <div class="custom-padding">
          <div class="slideshow-bottom__wrapper bullets-center">
            <div class="swiper-pagination__wrapper">
              <div
                class="swiper-pagination swiper-pagination__button {% if section.settings.enable_autoplay == false %} not-autoplay{% else %} bullet-autoplay{% endif %}"
              ></div>
            </div>
          </div>
        </div>
        {% if section.settings.enable_autoplay %}
          <button class="slideshow-autoplay__button" aria-label="Pause slideshow" aria-pressed="true">
            <span class="icon-play hidden">{% render 'icon-play' %}</span>
            <span class="icon-pause ">{% render 'icon-pause' %}</span>
          </button>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

