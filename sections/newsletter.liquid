{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
	{% render 'section-padding' %}
{%- endstyle -%}

{% liquid
	assign image_size = section.settings.height

	case image_size
		when 'square'
			assign section_size = '100%'
			assign slide_class = image_size
		when 'landscape'
			assign section_size = '56.25%'
			assign slide_class = image_size
		else
			assign section_size = '133%'
			assign slide_class = image_size
	endcase
%}
{% if section.settings.color_scheme != section.settings.color_scheme_mobile %}
	<style>
		@media screen and (max-width: 989.9px) {
			{% assign scheme = section.settings.color_scheme_mobile %}

			[data-scheme=light] .newsletter__inner.color-{{ section.settings.color_scheme }} {
				--color-background: {{ scheme.settings.colors_background_1.red }},{{ scheme.settings.colors_background_1.green }},{{ scheme.settings.colors_background_1.blue }};
				--color-background-secondary: {{ scheme.settings.colors_background_2.red }},{{ scheme.settings.colors_background_2.green }},{{ scheme.settings.colors_background_2.blue }};
				{% if scheme.settings.background_gradient != empty %}
					--gradient-background: {{ scheme.settings.background_gradient }};
				{% else %}
					--gradient-background: {{ scheme.settings.colors_background_1 }};
				{% endif %}
				--color-foreground: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{ scheme.settings.colors_text.blue }};
				--color-foreground-secondary: {{ scheme.settings.colors_secondary_text.red }}, {{ scheme.settings.colors_secondary_text.green }}, {{ scheme.settings.colors_secondary_text.blue }};
				--color-foreground-title: {{ scheme.settings.colors_text_title.red }}, {{ scheme.settings.colors_text_title.green }}, {{ scheme.settings.colors_text_title.blue }};
				--color-overlay: {{ scheme.settings.colors_background_overlay.red }},{{ scheme.settings.colors_background_overlay.green }},{{ scheme.settings.colors_background_overlay.blue }};
				--color-accent: {{ scheme.settings.color_accent.red }}, {{ scheme.settings.color_accent.green }}, {{ scheme.settings.color_accent.blue }};
				--color-border: {{ scheme.settings.color_border.red }}, {{ scheme.settings.color_border.green }}, {{ scheme.settings.color_border.blue }};
				--color-border-input: {{ scheme.settings.colors_input_border.red }}, {{ scheme.settings.colors_input_border.green }}, {{ scheme.settings.colors_input_border.blue }};
				--color-border-input-hover: {{ scheme.settings.colors_input_hover_border.red }}, {{ scheme.settings.colors_input_hover_border.green }}, {{ scheme.settings.colors_input_hover_border.blue }};
				--color-background-input: {{ scheme.settings.colors_input_background.red }}, {{ scheme.settings.colors_input_background.green }}, {{ scheme.settings.colors_input_background.blue }};
				--color-text-input: {{ scheme.settings.colors_input_text.red }}, {{ scheme.settings.colors_input_text.green }}, {{ scheme.settings.colors_input_text.blue }};
				--color-border: {{ scheme.settings.color_border.red }}, {{ scheme.settings.color_border.green }}, {{ scheme.settings.color_border.blue }};
			}

			@media (prefers-color-scheme: light) {
				[data-scheme=auto] .newsletter__inner.color-{{ section.settings.color_scheme }} {
					--color-background: {{ scheme.settings.colors_background_1.red }},{{ scheme.settings.colors_background_1.green }},{{ scheme.settings.colors_background_1.blue }};
					--color-background-secondary: {{ scheme.settings.colors_background_2.red }},{{ scheme.settings.colors_background_2.green }},{{ scheme.settings.colors_background_2.blue }};
					{% if scheme.settings.background_gradient != empty %}
						--gradient-background: {{ scheme.settings.background_gradient }};
					{% else %}
						--gradient-background: {{ scheme.settings.colors_background_1 }};
					{% endif %}
					--color-foreground: {{ scheme.settings.colors_text.red }}, {{ scheme.settings.colors_text.green }}, {{ scheme.settings.colors_text.blue }};
					--color-foreground-secondary: {{ scheme.settings.colors_secondary_text.red }}, {{ scheme.settings.colors_secondary_text.green }}, {{ scheme.settings.colors_secondary_text.blue }};
					--color-foreground-title: {{ scheme.settings.colors_text_title.red }}, {{ scheme.settings.colors_text_title.green }}, {{ scheme.settings.colors_text_title.blue }};
					--color-overlay: {{ scheme.settings.colors_background_overlay.red }},{{ scheme.settings.colors_background_overlay.green }},{{ scheme.settings.colors_background_overlay.blue }};
					--color-accent: {{ scheme.settings.color_accent.red }}, {{ scheme.settings.color_accent.green }}, {{ scheme.settings.color_accent.blue }};
					--color-border: {{ scheme.settings.color_border.red }}, {{ scheme.settings.color_border.green }}, {{ scheme.settings.color_border.blue }};
					--color-border-input: {{ scheme.settings.colors_input_border.red }}, {{ scheme.settings.colors_input_border.green }}, {{ scheme.settings.colors_input_border.blue }};
					--color-border-input-hover: {{ scheme.settings.colors_input_hover_border.red }}, {{ scheme.settings.colors_input_hover_border.green }}, {{ scheme.settings.colors_input_hover_border.blue }};
					--color-background-input: {{ scheme.settings.colors_input_background.red }}, {{ scheme.settings.colors_input_background.green }}, {{ scheme.settings.colors_input_background.blue }};
					--color-text-input: {{ scheme.settings.colors_input_text.red }}, {{ scheme.settings.colors_input_text.green }}, {{ scheme.settings.colors_input_text.blue }};
					--color-border: {{ scheme.settings.color_border.red }}, {{ scheme.settings.color_border.green }}, {{ scheme.settings.color_border.blue }};
				}
			}
		}
	</style>
{% endif %}

<div class="newsletter section-{{ section.id }}-padding {% if section.settings.mobile_dark_logo_enable %} newsletter--mobile-force-dark-logo {% endif %}">
	{% style %}
		#shopify-section-{{ section.id }} {
		  --image-height: {{ section_size }};
		}
	{% endstyle %}

	<div class="container">
		<div class="newsletter__inner color-{{ section.settings.color_scheme }} newsletter__inner--{{ section.settings.image_variant }} {%- if section.settings.image != blank -%} newsletter__inner--{{ section.settings.image_position }}  {%- else -%} newsletter__inner--no-image newsletter__inner--right {%- endif -%} ">
			{%- if section.settings.image != blank -%}
				{% liquid
					assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
				%}
				<div class="newsletter__inner--image {{ slide_class }}  ">
					<div
						class="newsletter__inner--image__overlay overlay-desktop"
						style="opacity: {{ section.settings.overlay_opacity }}"
					></div>
					<div
						class="newsletter__inner--image__overlay overlay-mobile"
						style="opacity: {{ section.settings.overlay_opacity_mobile }}"
					></div>
					{% if section.settings.image_variant == 'overlay' %}
						<div
							class="newsletter__inner--image__overlay overlay-dark-mode"
						></div>
					{% endif %}

					{% capture sizes %}
            calc((100vw - 40px))
          {% endcapture %}
					{{
						section.settings.image
						| image_url: width: section.settings.image.width
						| image_tag:
							loading: 'lazy',
							sizes: sizes,
							height: image_height,
							width: section.settings.image.width,
							widths: '246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946, 2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 3900',
							class: 'newsletter__image'
					}}
				</div>
			{%- endif -%}
			<div class="newsletter__form">
				<div class="newsletter__form--details">
					{% if section.settings.logo_image != blank %}
						{% comment %}
							{%- assign logo_height = section.settings.logo_width
								| divided_by: section.settings.logo_image.aspect_ratio
							-%}
							{% style %}
								#shopify-section-{{ section.id }} {
								  --logo-height: {{ logo_height }}px;
								}
							{% endstyle %}
						{% endcomment %}
						{{
							section.settings.logo_image
							| image_url: width: section.settings.logo_width
							| image_tag:
								loading: 'lazy',
								sizes: sizes,
								width: section.settings.logo_width,
								widths: '360, 535, 720, 956',
								class: 'newsletter__form--details--image header__heading-logo'
						}}
					{% endif %}
					{% if section.settings.logo_image_dark != blank %}
						{% comment %}
							{%- assign logo_height = section.settings.logo_width
								| divided_by: section.settings.logo_image_dark.aspect_ratio
							-%}
							{% style %}
								#shopify-section-{{ section.id }} {
								  --logo-height: {{ logo_height }}px;
								}
							{% endstyle %}
						{% endcomment %}
						{{
							section.settings.logo_image_dark
							| image_url: width: section.settings.logo_width
							| image_tag:
								loading: 'lazy',
								sizes: sizes,
								width: section.settings.logo_width,
								widths: '360, 535, 720, 956',
								class: 'newsletter__form--details--image header__heading-logo header__heading-logo--overlay'
						}}
					{% endif %}
					{% if section.settings.heading != blank %}
						<h3 class="newsletter-heading {{section.settings.heading_size }}">
							{{ section.settings.heading }}
						</h3>
					{% endif %}
				</div>
				<div class="newsletter__form--action">
					{% form 'customer', class: 'newsletter-form' %}
						<div class="newsletter-form__inner">
							<input type="hidden" name="contact[tags]" value="newsletter">
							<div class="newsletter-form__field-wrapper">
								<div class="field">
									<input
										id="NewsletterForm--{{ section.id }}"
										type="email"
										name="contact[email]"
										class="field__input field"
										value="{{ form.email }}"
										aria-required="true"
										autocorrect="off"
										autocapitalize="off"
										autocomplete="email"
										pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
										{% if form.errors %}
											autofocus
											aria-invalid="true"
											aria-describedby="Newsletter-error--{{ section.id }}"
										{% elsif form.posted_successfully? %}
											aria-describedby="Newsletter-success--{{ section.id }}"
										{% endif %}
										placeholder="{{ 'newsletter.label' | t }}"
										required
									>
									<label
										class="visually-hidden"
										for="NewsletterForm--{{ section.id }}"
									>
										{{ 'newsletter.label' | t }}
									</label>
								</div>
								{%- if form.errors -%}
									<small
										class="newsletter-form__message form__message"
										id="Newsletter-error--{{ section.id }}"
									>
										{%- render 'icon-error' -%}
										{{- form.errors.translated_fields.email | capitalize }}
										{{ form.errors.messages.email -}}
									</small>
								{%- endif -%}
							</div>
							<button
								type="submit"
								class="newsletter__button button button--{{ section.settings.button_style }} focus-inset"
								name="commit"
							>
								<span>{{ 'newsletter.button_label' | t }}</span>
							</button>
						</div>
						{%- if form.posted_successfully? -%}
							<h3
								class="newsletter-form__message newsletter-form__message--success form__message"
								id="Newsletter-success--{{ section.id }}"
								tabindex="-1"
								autofocus
							>
								{% render 'icon-success' -%}
								{{- 'newsletter.success' | t }}
							</h3>
						{%- endif -%}
					{% endform %}
					{% if section.settings.newsletter_text %}
						<div class="newsletter__text extra-small-font">
							{{ section.settings.newsletter_text }}
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.newsletter.name",
	"tag": "section",
	"class": "spaced-section",
	"enabled_on": {
		"templates": ["*"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-1",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "color_scheme",
			"id": "color_scheme_mobile",
			"default": "background-3",
			"label": "t:sections.all.color_scheme_mobile.label"
		},
		{
			"type": "header",
			"content": "t:sections.newsletter.settings.header_1.content"
		},
		{
			"type": "select",
			"id": "image_variant",
			"options": [
				{
					"value": "static",
					"label": "t:sections.newsletter.settings.image_variant.options__1.label"
				},
				{
					"value": "overlay",
					"label": "t:sections.newsletter.settings.image_variant.options__2.label"
				}
			],
			"default": "static",
			"label": "t:sections.newsletter.settings.image_variant.label"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:sections.newsletter.settings.image.label"
		},
		{
			"type": "range",
			"id": "overlay_opacity",
			"min": 0,
			"max": 1,
			"step": 0.1,
			"label": "t:sections.all.overlay_opacity.label",
			"default": 0.1
		},
		{
			"type": "range",
			"id": "overlay_opacity_mobile",
			"min": 0,
			"max": 1,
			"step": 0.1,
			"label": "t:sections.all.overlay_opacity_mobile.label",
			"default": 0.1
		},
		{
			"type": "select",
			"id": "height",
			"options": [
				{
					"value": "square",
					"label": "t:sections.all.card.image_ratio_2.options__3.label"
				},
				{
					"value": "landscape",
					"label": "t:sections.all.card.image_ratio_2.options__1.label"
				},
				{
					"value": "portrait",
					"label": "t:sections.all.card.image_ratio_2.options__2.label"
				}
			],
			"default": "landscape",
			"label": "t:sections.all.aspect_ratio.label"
		},
		{
			"type": "select",
			"id": "image_position",
			"options": [
				{
					"value": "left",
					"label": "t:sections.all.image_position.options__1.label"
				},
				{
					"value": "right",
					"label": "t:sections.all.image_position.options__2.label"
				}
			],
			"default": "right",
			"label": "t:sections.all.image_position.label",
			"info": "t:sections.all.image_position.info"
		},
		{
			"type": "header",
			"content": "t:sections.newsletter.settings.header_2.content"
		},
		{
			"type": "image_picker",
			"id": "logo_image",
			"label": "t:sections.newsletter.settings.logo.label"
		},
		{
			"type": "image_picker",
			"id": "logo_image_dark",
			"label": "t:sections.newsletter.settings.logo_dm.label",
			"info": "t:sections.newsletter.settings.logo_dm.info"
		},
		{
			"type": "checkbox",
			"id": "mobile_dark_logo_enable",
			"default": true,
			"label": "t:sections.newsletter.settings.mobile_dark_logo_enable.label"
		},
		{
			"type": "range",
			"id": "logo_width",
			"min": 50,
			"max": 250,
			"step": 5,
			"default": 100,
			"unit": "t:sections.newsletter.settings.logo_width.unit",
			"label": "t:sections.newsletter.settings.logo_width.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"default": "t:sections.newsletter.settings.default_contents.heading",
			"label": "t:sections.all.heading.label"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h2",
					"label": "t:sections.all.heading_size.options__1.label"
				},
				{
					"value": "h1",
					"label": "t:sections.all.heading_size.options__2.label"
				}
			],
			"default": "h1",
			"label": "t:sections.all.heading_size.label"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:sections.all.button.style.options__1.label"
				},
				{
					"value": "secondary",
					"label": "t:sections.all.button.style.options__2.label"
				}
			],
			"default": "primary",
			"label": "t:sections.all.button.style.full_label"
		},
		{
			"type": "inline_richtext",
			"id": "newsletter_text",
			"default": "t:sections.newsletter.settings.default_contents.addintional_text",
			"label": "t:sections.newsletter.settings.newsletter_text.label"
		},

		{
			"type": "paragraph",
			"content": "t:sections.newsletter.settings.paragraph.content"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-padding.header.content"
		},
		{
			"type": "select",
			"id": "padding_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-padding.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-padding.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-padding.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-padding.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-padding.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-padding.options__6.label"
				}
			],
			"default": "no-indent",
			"label": "t:sections.all.section-padding.padding_top.label"
		},
		{
			"type": "select",
			"id": "padding_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-padding.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-padding.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-padding.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-padding.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-padding.options__5.label"
				},
				{
					"value": "xl",
					"label": "t:sections.all.section-padding.options__6.label"
				}
			],
			"default": "xl",
			"label": "t:sections.all.section-padding.padding_bottom.label"
		}
	],
	"presets": [
		{
			"name": "Newsletter"
		}
	]
}
{% endschema %}
