{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{%- if settings.pagination_type == 'load_more'
	or settings.pagination_type == 'infinite_scroll'
-%}
	<script src="{{ 'load-more.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<link
	rel="preload"
	href="{{ 'component-card.css' | asset_url }}"
	as="style"
	onload="this.onload=null;this.rel='stylesheet'"
>
<link
	rel="preload"
	href="{{ 'component-price.css' | asset_url }}"
	as="style"
	onload="this.onload=null;this.rel='stylesheet'"
>
<link
	rel="preload"
	href="{{ 'component-rte.css' | asset_url }}"
	as="style"
	onload="this.onload=null;this.rel='stylesheet'"
>

<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
	{{ 'component-facets.css' | asset_url | stylesheet_tag }}
	{% if section.settings.filter_type == 'vertical' %}
		<script src="{{ 'product-grid.js' | asset_url }}" defer="defer"></script>
	{% endif %}
	<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if settings.quickview_show -%}
	<link
		rel="preload"
		href="{{ 'section-main-product.css' | asset_url }}"
		as="style"
		onload="this.onload=null;this.rel='stylesheet'"
	>
	<link
		rel="stylesheet"
		href="{{ 'component-deferred-media.css' | asset_url }}"
		media="all"
	>
	<link
		rel="preload"
		href="{{ 'quick-add.css' | asset_url }}"
		as="style"
		onload="this.onload=null;this.rel='stylesheet'"
	>

	<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
	<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if settings.quickview_show == false
	and settings.color_swatch
-%}
	{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- liquid
	if section.settings.banner_show == true
		assign products_per_page = section.settings.products_per_page
	else
		assign products_per_page = section.settings.products_per_page | plus: 1
	endif
-%}

{%- style -%}
	{% render 'section-padding' %}
{%- endstyle -%}

{%- assign sort_by = collection.sort_by
	| default: collection.default_sort_by
-%}
<div class="container section-{{ section.id }}-padding">
	<div class="
			 collection-wrapper collection-wrapper--vertical
			{%- if collection.all_products_count == 0 -%} collection-wrapper--empty {% endif %}
			{%- if section.settings.enable_filtering == false and section.settings.enable_sorting == false -%} collection-wrapper_no-facets {% endif %}
		">
		{%- if collection.all_products_count > 0 -%}
			{%- if section.settings.enable_filtering
				or section.settings.enable_sorting
			-%}
				{% render 'facets',
					results: collection,
					enable_filtering: section.settings.enable_filtering,
					enable_sorting: section.settings.enable_sorting,
					filter_type: 'vertical',
					image_filter_ratio: section.settings.image_filter_ratio,
					image_filter_fit: section.settings.image_filter_fit,
					image_filter_columns: section.settings.image_filter_columns
				%}
			{%- endif -%}
		{%- endif -%}

		<div
			id="ProductGridContainer"
			class="
				products-grid
				{% if section.settings.enable_filtering == false %} products-grid_no-filter {%- endif -%}
			"
		>
			{%- paginate collection.products by section.settings.products_per_page -%}
				{%- if collection.products.size == 0 -%}
					<div
						class="collection collection-product collection--empty container"
						id="product-grid"
						data-id="{{ section.id }}"
					>
						<div class="loading-overlay">
							<div class="loading-overlay__spinner">
								<svg
									aria-hidden="true"
									focusable="false"
									role="presentation"
									class="spinner"
									viewBox="0 0 66 66"
									xmlns="http://www.w3.org/2000/svg"
								>
									<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
								</svg>
							</div>
						</div>

						<div class="title-wrapper center title-wrapper-empty">
							<h2 class="title title--primary">
								{% if collection.all_products_count == 0 %}
									{{ 'sections.collection_template.empty' | t -}}
									<br>
								{% else %}
									{{ 'sections.collection_template.empty_results' | t -}}
									<br>
									{{
										'sections.collection_template.results_use_fewer_filters_html'
										| t: link: collection.url, class: 'underlined-link link'
									}}
								{% endif %}
							</h2>
						</div>
					</div>
				{%- else -%}
					<div class="collection collection-product">
						<div class="loading-overlay">
							<div class="loading-overlay__spinner">
								<svg
									aria-hidden="true"
									focusable="false"
									role="presentation"
									class="spinner"
									viewBox="0 0 66 66"
									xmlns="http://www.w3.org/2000/svg"
								>
									<circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
								</svg>
							</div>
						</div>

						<ul
							id="product-grid"
							data-id="{{ section.id }}"
							class="collection-product-list load-more-grid"
						>
							{% assign product_count = 0 %}
							{%- for product in collection.products -%}
								{% assign product_count = product_count | plus: 1 %}
								<li class="collection-product-card">
									{% render 'product-card',
										product_card_product: product,
										media_size: section.settings.image_ratio,
										media_fit: section.settings.image_fit,
										show_secondary_image: section.settings.show_secondary_image,
										show_vendor: section.settings.show_vendor,
										show_collection_name: section.settings.show_collection_name,
										show_color_swatch: section.settings.show_color_swatch,
										show_inventory: section.settings.show_inventory,
										show_desc: section.settings.show_desc,
										section_id: section.id,
										add_id: forloop.index,
										show_sku: section.settings.show_sku
									%}
								</li>
							{%- endfor -%}

							{% if section.settings.banner_show %}
								<li class="
										banner-fixed-position   {% if product_count >= 11  %}
										  banner-fixed-position-fixed
										{% endif %}
									">
									<div class="banner-fixed-position__banner">
										<div
											class="banner-slider__item color-{{ section.settings.banner_color_scheme }}"
											{{ section.shopify_attributes }}
										>
											{% if section.settings.banner_image != blank %}
												<div
													class="banner-slider__overlay"
													style="opacity: {{ section.settings.overlay_opacity }}"
												></div>
											{% endif %}
											{% if section.settings.overlay_link != blank %}
												<a
													class="banner-slider__overlay_link overlay_link"
													href="{{ section.settings.overlay_link }}"
												></a>
											{% endif %}
											<div class="banner-slider__item--details">
												{% if section.settings.badge_image != blank %}
													<div class="banner-slider__item--details__badge">
														{%- if section.settings.badge_image != blank -%}
															{{
																section.settings.badge_image
																| image_url:
																	width: section.settings.badge_image.width
																| image_tag:
																	loading: 'lazy',
																	sizes: '100vw',
																	widths: '550, 720',
																	class: 'banner-slider__badge_image'
															}}
														{% endif %}
														{% comment %}
															{% if section.settings.badege_text != blank %}
																<span
																	class="banner-slider__badge_text"
																	style="color: {{ section.settings.badge_text_color }}"
																>
																	{{ section.settings.badege_text }}
																</span>
															{% endif %}
														{% endcomment %}
													</div>
												{% endif %}
												{% if section.settings.banner_title != blank %}
													<div class="banner-slider__item--details__action">
														{% if section.settings.banner_title != blank %}
															<h4 class="banner-slider__item--details__heading h4">
																{{ section.settings.banner_title }}
															</h4>
														{% endif %}
													</div>
												{% endif %}
											</div>

											{%- if section.settings.banner_image != blank -%}
												{% liquid
													assign image_height = section.settings.banner_image.width | divided_by: section.settings.banner_image.aspect_ratio
												%}
												<div class="banner-slider__item__image {{ slide_class }}">
													{%- if section.settings.banner_image != blank -%}
														{{
															section.settings.banner_image
															| image_url:
																width: section.settings.banner_image.width
															| image_tag:
																loading: 'lazy',
																sizes: '100vw',
																widths: '550, 720, 990, 1150, 1500, 1800, 2200, 2600, 3000',
																height: image_height,
																width: section.settings.banner_image.width,
																class: 'banner-slider__image banner-slider__image--light'
														}}
													{%- endif -%}
												</div>
											{%- endif -%}
										</div>
									</div>
								</li>
							{% endif %}
						</ul>

						{%- if paginate.pages > 1 -%}
							{%- if settings.pagination_type == 'load_more' -%}
								{% render 'load-more',
									next_url: paginate.next.url,
									count_pages: paginate.pages,
									current_page: paginate.current_page
								%}
								<div class="js-hidden">
									{% render 'pagination', paginate: paginate %}
								</div>
							{%- elsif settings.pagination_type == 'infinite_scroll' -%}
								{% render 'infinite-scroll',
									next_url: paginate.next.url,
									count_pages: paginate.pages,
									current_page: paginate.current_page
								%}
								<div class="js-hidden">
									{% render 'pagination', paginate: paginate %}
								</div>
							{% else %}
								{% render 'pagination', paginate: paginate %}
							{%- endif -%}
						{%- endif -%}
					</div>
				{%- endif -%}
			{%- endpaginate -%}
		</div>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.main-collection-product-grid.name",
	"tag": "section",
	"class": "collection-grid-section",
	"settings": [
		{
			"type": "range",
			"id": "products_per_page",
			"min": 12,
			"max": 23,
			"step": 1,
			"default": 12,
			"label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.product_card.header.content"
		},
		{
			"type": "checkbox",
			"id": "show_secondary_image",
			"default": true,
			"label": "t:sections.all.product_card.show_secondary_image.label"
		},
		{
			"type": "checkbox",
			"id": "show_sku",
			"default": false,
			"label": "t:sections.all.sku.show_sku"
		},
		{
			"type": "checkbox",
			"id": "show_vendor",
			"default": true,
			"label": "t:sections.all.product_card.show_vendor.label"
		},
		{
			"type": "checkbox",
			"id": "show_collection_name",
			"default": true,
			"label": "t:sections.all.product_card.show_colection_name.label"
		},
		{
			"type": "checkbox",
			"id": "show_inventory",
			"default": true,
			"label": "t:sections.all.product_card.show_inventory.label"
		},
		{
			"type": "checkbox",
			"id": "show_desc",
			"default": false,
			"label": "t:sections.all.product_card.show_description.label"
		},
		{
			"type": "checkbox",
			"id": "show_color_swatch",
			"default": false,
			"label": "t:sections.all.product_card.show_color.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.image.header.content"
		},
		{
			"type": "select",
			"id": "image_ratio",
			"options": [
				{
					"value": "landscape",
					"label": "t:sections.all.image.ratio.options__1.label"
				},
				{
					"value": "portrait",
					"label": "t:sections.all.image.ratio.options__2.label"
				},
				{
					"value": "square",
					"label": "t:sections.all.image.ratio.options__3.label"
				}
			],
			"default": "portrait",
			"label": "t:sections.all.image.ratio.label"
		},
		{
			"type": "select",
			"id": "image_fit",
			"label": "t:sections.all.image.fit.label",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.image.fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.image.fit.options__2.label"
				}
			],
			"default": "cover"
		},
		{
			"type": "header",
			"content": "t:sections.main-collection-product-grid.settings.header__1.content"
		},
		{
			"type": "checkbox",
			"id": "enable_filtering",
			"default": true,
			"label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
			"info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
		},
		{
			"type": "checkbox",
			"id": "enable_sorting",
			"default": true,
			"label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
		},
		{
			"type": "header",
			"content": "t:sections.main-collection-product-grid.settings.image_filter.content"
		},
		{
			"type": "select",
			"id": "image_filter_ratio",
			"options": [
				{
					"value": "3/2",
					"label": "t:sections.all.image.ratio.options__1.label"
				},
				{
					"value": "4/5",
					"label": "t:sections.all.image.ratio.options__2.label"
				},
				{
					"value": "1/1",
					"label": "t:sections.all.image.ratio.options__3.label"
				}
			],
			"default": "4/5",
			"label": "t:sections.all.image.ratio.label"
		},
		{
			"type": "select",
			"id": "image_filter_fit",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.all.image.fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.all.image.fit.options__2.label"
				}
			],
			"default": "cover",
			"label": "t:sections.all.image.fit.label"
		},
		{
			"type": "range",
			"id": "image_filter_columns",
			"min": 1,
			"max": 4,
			"step": 1,
			"default": 2,
			"label": "t:sections.main-collection-product-grid.settings.image_filter_columns.label"
		},
		{
			"type": "header",
			"content": "t:sections.main-blog.blocks.aside.settings.banner_header.content"
		},
		{
			"type": "checkbox",
			"id": "banner_show",
			"default": true,
			"label": "t:sections.main-blog.blocks.aside.settings.enable_banner.label"
		},
		{
			"type": "color_scheme",
			"id": "banner_color_scheme",
			"default": "background-3",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "image_picker",
			"id": "banner_image",
			"label": "t:sections.main-blog.blocks.aside.settings.banner_image.label"
		},
		{
			"type": "inline_richtext",
			"id": "banner_title",
			"label": "t:sections.main-blog.blocks.aside.settings.banner_title.label",
			"default": "Some heading"
		},
		{
			"type": "range",
			"id": "overlay_opacity",
			"min": 0,
			"max": 1,
			"step": 0.1,
			"label": "t:sections.all.overlay_opacity.label",
			"default": 0.3
		},
		{
			"type": "url",
			"id": "overlay_link",
			"label": "t:sections.all.button.overlay_link.label"
		},
		{
			"type": "header",
			"content": "t:sections.banner-slider.blocks.column.settings.header__1.label"
		},
		{
			"type": "image_picker",
			"id": "badge_image",
			"label": "t:sections.all.icon_pack.label"
		},
		{
			"type": "header",
			"content": "t:sections.all.section-padding.header.content"
		},
		{
			"type": "select",
			"id": "padding_top",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-padding.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-padding.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-padding.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-padding.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-padding.options__5.label"
				}
			],
			"default": "m",
			"label": "t:sections.all.section-padding.padding_top.label"
		},
		{
			"type": "select",
			"id": "padding_bottom",
			"options": [
				{
					"value": "no-indent",
					"label": "t:sections.all.section-padding.options__1.label"
				},
				{
					"value": "xs",
					"label": "t:sections.all.section-padding.options__2.label"
				},
				{
					"value": "s",
					"label": "t:sections.all.section-padding.options__3.label"
				},
				{
					"value": "m",
					"label": "t:sections.all.section-padding.options__4.label"
				},
				{
					"value": "l",
					"label": "t:sections.all.section-padding.options__5.label"
				}
			],
			"default": "m",
			"label": "t:sections.all.section-padding.padding_bottom.label"
		}
	]
}
{% endschema %}
