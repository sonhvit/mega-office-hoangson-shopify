{% assign template_base = template | split: '.' | first %}

{% unless template_base == 'index' or template_base == 'collection' %}
  <div class="container">
    <nav id="breadcrumbs" class="breadcrumb body-small" role="navigation" aria-label="breadcrumbs">
      {% if template contains 'product' %}
        {%- comment -%} Desktop: hiển thị đầy đủ {%- endcomment -%}
        <div class="breadcrumb__desktop">
          <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}" class="focus-inset">
            {{- 'general.breadcrumbs.home' | t -}}
          </a>
          <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
          <a href="{{ routes.collections_url }}" class="focus-inset">{{ 'products.product.shop' | t }}</a>
          <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
          {% if product.collections[0] %}
            <a href="{{ product.collections[0].url }}" class="focus-inset">{{ product.collections[0].title }} </a>
          {% endif %}
        </div>
        
        {%- comment -%} Mobile: chỉ hiển thị 2 level cuối nếu có collection (4 level) {%- endcomment -%}
        <div class="breadcrumb__mobile">
          {% if product.collections[0] %}
            <span class="breadcrumb__ellipsis">...</span>
            <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
            <a href="{{ product.collections[0].url }}" class="focus-inset">{{ product.collections[0].title }} </a>
          {% else %}
            <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}" class="focus-inset">
              {{- 'general.breadcrumbs.home' | t -}}
            </a>
            <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
            <a href="{{ routes.collections_url }}" class="focus-inset">{{ 'products.product.shop' | t }}</a>
          {% endif %}
        </div>
      {% else %}
        <a href="{{ routes.root_url }}" title="{{ 'general.breadcrumbs.home' | t }}" class="focus-inset">
          {{- 'general.breadcrumbs.home' | t -}}
        </a>
      {% endif %}
      
      {% if template contains 'page' %}
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        <span>{{ page.title }} </span>
      {% elsif template == 'cart' %}
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        <span>{{ 'sections.cart.title' | t }}</span>
			{% elsif template == 'article' %}
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <a href="{{ blog.url }}" class="focus-inset">{{ blog.title }}</a>
      <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
      <span>{{ page_title }}</span>
      {% elsif template == 'blog' %}
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        {% if current_tags %}
          {{ blog.title | link_to: blog.url }}
          <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
          <span>{{ current_tags | join: ' + ' }} </span>
        {% else %}
          <span>{{ blog.title }}</span>
        {% endif %}
      {% elsif template == 'customers/order' %}
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        <a href="{{ routes.account_url }}" class="focus-inset">{{ 'customer.account.title' | t }} </a>
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        <span>{{ order.name }} </span>
      {% elsif template == 'customers/addresses' %}
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        <a href="{{ routes.account_url }}" class="focus-inset">{{ 'customer.account.title' | t }} </a>
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        <span>{{ 'customer.addresses.title' | t }} </span>
      {% else %}
        <div class="breadcrumb__delimiter">{% render 'icon-breadcrumbs' %}</div>
        <span>{{ page_title }} </span>
      {% endif %}
    </nav>

    <script>
      const calcBreadcrumbs = () => {
        const breadcrumbs = document.querySelector('.breadcrumb');
        if (breadcrumbs) {
          const breadcrumbsObserver = new ResizeObserver((entries) => {
            const breadcrumbsHeight = breadcrumbs.getBoundingClientRect().height;
            document.documentElement.style.setProperty('--breadcrumbs-height', `${breadcrumbsHeight + 24}px`);
          });
          breadcrumbsObserver.observe(breadcrumbs);
        }
      };
      calcBreadcrumbs();

      document.addEventListener('shopify:section:load', function () {
        calcBreadcrumbs();
      });
    </script>
  </div>
{% endunless %}
